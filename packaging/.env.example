# Private install values. Copy to .env (0600) and fill in. Never commit .env.
# No secrets are stored in compose.yaml; admin credentials are created by
# automatic setup and kept in app/0600 files (see BOOTSTRAP-REQUIREMENTS.md).

# Absolute host path to the pinned model weights (read-only mount).
# Accepted fixture value: /mnt/storage-data/davidau-gpt-oss-20b/model.gguf
MODEL_GGUF_PATH=/mnt/storage-data/davidau-gpt-oss-20b/model.gguf

# Optional loopback port overrides for an isolated fixture; no public binding.
GATEWAY_PORT=18085
ORDER_PORT=18086
