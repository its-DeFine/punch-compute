+func TestIntentBoundProxyStripsSpoofedAndInjectsStored(t *testing.T) {
+	var gotPaidIntent, gotPaidPayer, gotPaidRecipient, gotPaidAmount string
+	var gotBody string
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPaidIntent = r.Header.Get("Livepeer-Paid-Intent")
+		gotPaidPayer = r.Header.Get("Livepeer-Paid-Payer")
+		gotPaidRecipient = r.Header.Get("Livepeer-Paid-Recipient")
+		gotPaidAmount = r.Header.Get("Livepeer-Paid-Amount-Wei")
+		body, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		gotBody = string(body)
+		_, _ = w.Write([]byte("granted"))
+	}))
+	defer upstream.Close()
+
+	lp := newLiveRunnerHTTPOnchain(t)
+	orch := lp.orchestrator.(*stubOrchestrator)
+	registerFixedSingleShotRunner(t, lp, "runner-1", upstream.URL)
+	intent := purchaseIntentFor(t, "ord-paid-1")
+
+	w := requestFixedPurchaseChallenge(t, lp, orch, "runner-1", intent, true)
+	require.Equal(t, http.StatusPaymentRequired, w.Code, w.Body.String())
+	challenge, oInfo := decodeLiveRunnerPaymentChallenge(t, w.Body.Bytes())
+	priceWei := oInfo.GetPriceInfo().GetPricePerUnit()
+
+	// Synthetic receipt provenance, explicitly labelled: values differ from
+	// spoofed caller claims and match the pinned quote, so the proxied
+	// headers can only have come from the accepted receipt.
+	syntheticRecipient := ethcommon.BytesToAddress(oInfo.GetTicketParams().GetRecipient())
+	wrapper := &acceptFixedPurchaseStubOrchestrator{stubOrchestrator: orch}
+	wrapper.accept = func(ctx context.Context, payment lpnet.Payment, terms core.FixedPurchaseTerms) (*common.FixedPurchaseReceipt, bool, error) {
+		return &common.FixedPurchaseReceipt{
+			Intent:     terms.Intent,
+			RunnerID:   terms.RunnerID,
+			ManifestID: string(terms.ManifestID),
+			PriceWei:   strconv.FormatInt(terms.PriceWei, 10),
+			Ticket: &pm.SignedTicket{
+				Ticket: &pm.Ticket{
+					Sender:    orch.Address(),
+					Recipient: syntheticRecipient,
+				},
+				Sig:           []byte("synthetic-test-sig"),
+				RecipientRand: big.NewInt(7),
+			},
+		}, true, nil
+	}
+	lp.orchestrator = wrapper
+
+	// Arm the stub ledger: any legacy ProcessPayment would leave a trace.
+	orch.balances = make(map[ethcommon.Address]map[core.ManifestID]*big.Rat)
+	orch.paymentCredit = big.NewRat(priceWei, 1)
+
+	spoofed := map[string]string{
+		"Livepeer-Paid-Intent":     strings.Repeat("0", 64),
+		"Livepeer-Paid-Payer":      "0x0000000000000000000000000000000000000001",
+		"Livepeer-Paid-Recipient":  "0x0000000000000000000000000000000000000002",
+		"Livepeer-Paid-Amount-Wei": "1",
+	}
+	req := paidSingleShotRequest(t, orch, oInfo, challenge.ManifestID, "runner-1", intent, spoofed)
+	resp := httptest.NewRecorder()
+	lp.ServeHTTP(resp, req)
+	require.Equal(t, http.StatusOK, resp.Code, resp.Body.String())
+	require.Equal(t, "granted", resp.Body.String())
+
+	// The durable method was called once with the pinned terms.
+	require.Equal(t, 1, wrapper.acceptCalls)
+	require.Equal(t, intent, wrapper.gotTerms.Intent)
+	require.Equal(t, "runner-1", wrapper.gotTerms.RunnerID)
+	require.Equal(t, core.ManifestID(challenge.ManifestID), wrapper.gotTerms.ManifestID)
+	require.Equal(t, orch.Address(), wrapper.gotTerms.Payer)
+	require.Equal(t, syntheticRecipient, wrapper.gotTerms.Recipient)
+	require.Equal(t, priceWei, wrapper.gotTerms.PriceWei)
+
+	// Spoofed caller claims are stripped; accepted receipt values arrive.
+	require.Equal(t, intent, gotPaidIntent)
+	require.Equal(t, orch.Address().Hex(), gotPaidPayer)
+	require.Equal(t, syntheticRecipient.Hex(), gotPaidRecipient)
+	require.NotEqual(t, orch.Address().Hex(), gotPaidRecipient)
+	require.Equal(t, strconv.FormatInt(priceWei, 10), gotPaidAmount)
+	require.NotEqual(t, spoofed["Livepeer-Paid-Intent"], gotPaidIntent)
+	require.Equal(t, `{"order":"ord-1"}`, gotBody)
+
+	// The legacy ticket-credit path never ran on this request.
+	require.Empty(t, orch.balances)
+}
+
+func TestLegacyFixedPurchaseFlowUnchanged(t *testing.T) {
