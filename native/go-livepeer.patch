diff --git a/common/fixed_purchase_receipt.go b/common/fixed_purchase_receipt.go
new file mode 100644
index 00000000..9a44ae7d
--- /dev/null
+++ b/common/fixed_purchase_receipt.go
@@ -0,0 +1,307 @@
+package common
+
+import (
+	"bytes"
+	"database/sql"
+	"encoding/hex"
+	"math/big"
+	"strings"
+	"time"
+
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/livepeer/go-livepeer/pm"
+	"github.com/mattn/go-sqlite3"
+	"github.com/pkg/errors"
+)
+
+// FixedPurchaseReceipt is durable acceptance evidence for one validated
+// fixed-purchase (face=EV) ticket bound to a purchase (sender, intent).
+//
+// It is NOT a balance ledger and carries no financial proof: the caller (core)
+// must validate the ticket (signatures, chain state) BEFORE invoking the
+// store. This layer only checks storage consistency of the recorded binding so
+// a lost response or process restart can recover the grant decision without a
+// second signature. Ticket identity is the ticket hash; (sender, intent) is
+// unique so one order accepts exactly one ticket. Rows are never overwritten.
+type FixedPurchaseReceipt struct {
+	Intent     string
+	RunnerID   string
+	ManifestID string
+	// PriceWei is canonical base-10 wei, normalized at store time.
+	PriceWei string
+	Ticket   *pm.SignedTicket
+	// AcceptedAt is generated once at store time.
+	AcceptedAt time.Time
+}
+
+var (
+	ErrFixedPurchaseReceiptInvalid  = errors.New("invalid fixed purchase receipt")
+	ErrFixedPurchaseReceiptConflict = errors.New("fixed purchase receipt binding conflict")
+)
+
+// maxTicketWinProb mirrors the protocol maximum win probability (2^256 - 1).
+// A fixed-purchase ticket must carry exactly this probability (face=EV).
+// Kept local so this package does not depend on pm internals; signature and
+// chain validation stay with the caller.
+var maxTicketWinProb = new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 256), big.NewInt(1))
+
+// normalizeFixedPurchaseReceipt checks storage consistency and returns the
+// canonical price. It never validates signatures or chain state.
+func normalizeFixedPurchaseReceipt(receipt *FixedPurchaseReceipt) (string, error) {
+	if receipt == nil || receipt.Ticket == nil || receipt.Ticket.Ticket == nil {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "missing receipt or ticket")
+	}
+	if strings.TrimSpace(receipt.Intent) == "" || strings.TrimSpace(receipt.RunnerID) == "" || strings.TrimSpace(receipt.ManifestID) == "" {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "intent, runnerID and manifestID are required")
+	}
+	intentBytes, intentErr := hex.DecodeString(receipt.Intent)
+	if intentErr != nil || len(intentBytes) != 32 || strings.ToLower(receipt.Intent) != receipt.Intent {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "intent must be 64 lowercase hex characters")
+	}
+	price, ok := new(big.Int).SetString(strings.TrimSpace(receipt.PriceWei), 10)
+	if !ok || price.Sign() <= 0 || price.BitLen() > 256 {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "priceWei must be a positive base-10 integer")
+	}
+	ticket := receipt.Ticket
+	if ticket.Sender == (ethcommon.Address{}) || ticket.Recipient == (ethcommon.Address{}) {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "ticket sender and recipient are required")
+	}
+	if ticket.FaceValue == nil || ticket.FaceValue.Cmp(price) != 0 {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "ticket face value must equal the purchase price")
+	}
+	if ticket.WinProb == nil || ticket.WinProb.Cmp(maxTicketWinProb) != 0 {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "fixed purchase win probability must equal the protocol maximum")
+	}
+	if ticket.ParamsExpirationBlock == nil || ticket.ParamsExpirationBlock.Sign() <= 0 ||
+		!ticket.ParamsExpirationBlock.IsInt64() || ticket.CreationRound < 0 ||
+		ticket.PricePerPixel == nil || ticket.PricePerPixel.Cmp(new(big.Rat).SetInt(price)) != 0 {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "invalid expiry, round or fixed price binding")
+	}
+	if len(ticket.Sig) == 0 || ticket.RecipientRand == nil || ticket.RecipientRand.Sign() < 0 || ticket.RecipientRand.BitLen() > 256 {
+		return "", errors.Wrap(ErrFixedPurchaseReceiptInvalid, "ticket sig and recipientRand are required for recovery")
+	}
+	return price.String(), nil
+}
+
+// StoreFixedPurchaseReceipt durably commits acceptance before returning. An
+// exact replay of the same ticket and binding returns the existing receipt
+// with created=false. A changed binding for the same ticket hash, or a second
+// ticket for the same (sender, intent), is rejected as a conflict and the
+// stored row is never overwritten.
+func (db *DB) StoreFixedPurchaseReceipt(receipt *FixedPurchaseReceipt) (*FixedPurchaseReceipt, bool, error) {
+	priceWei, err := normalizeFixedPurchaseReceipt(receipt)
+	if err != nil {
+		return nil, false, err
+	}
+	hash := receipt.Ticket.Hash()
+
+	// The insert is the serialization point. Two separate preflight reads can
+	// observe an identical concurrent insert between them and falsely report a
+	// conflict. Resolve duplicates only after SQLite enforces uniqueness.
+
+	ticket := receipt.Ticket
+	_, err = db.insertFixedPurchaseReceipt.Exec(
+		receipt.Intent,
+		receipt.RunnerID,
+		receipt.ManifestID,
+		ticket.Sender.Hex(),
+		ticket.Recipient.Hex(),
+		priceWei,
+		ticket.FaceValue.Bytes(),
+		ticket.WinProb.Bytes(),
+		ticket.SenderNonce,
+		ticket.RecipientRand.Bytes(),
+		ticket.RecipientRandHash.Hex(),
+		hash.Hex(),
+		ticket.Sig,
+		ticket.CreationRound,
+		ticket.CreationRoundBlockHash.Hex(),
+		ticket.ParamsExpirationBlock.Int64(),
+	)
+	if err != nil {
+		if isReceiptConstraintError(err) {
+			// Lost a concurrent race: re-read deterministically instead of
+			// reporting a spurious failure.
+			return db.resolveReceiptRace(receipt, priceWei)
+		}
+		return nil, false, errors.Wrap(err, "failed inserting fixed purchase receipt")
+	}
+
+	stored, err := db.FixedPurchaseReceiptByTicketHash(hash)
+	if err != nil {
+		return nil, false, err
+	}
+	if stored == nil {
+		return nil, false, errors.New("fixed purchase receipt missing after insert")
+	}
+	return stored, true, nil
+}
+
+// resolveReceiptRace re-reads after a uniqueness violation so concurrent
+// identical writes resolve to exactly one created receipt and concurrent
+// conflicting writes resolve to a conflict, never an overwrite.
+func (db *DB) resolveReceiptRace(receipt *FixedPurchaseReceipt, priceWei string) (*FixedPurchaseReceipt, bool, error) {
+	if existing, err := db.FixedPurchaseReceiptByTicketHash(receipt.Ticket.Hash()); err != nil {
+		return nil, false, err
+	} else if existing != nil {
+		if err := checkReceiptBinding(existing, receipt, priceWei); err != nil {
+			return nil, false, err
+		}
+		return existing, false, nil
+	}
+	if existing, err := db.FixedPurchaseReceiptByIntent(receipt.Ticket.Sender, receipt.Intent); err != nil {
+		return nil, false, err
+	} else if existing != nil {
+		return nil, false, errors.Wrapf(ErrFixedPurchaseReceiptConflict, "sender %v already accepted a ticket for intent", receipt.Ticket.Sender.Hex())
+	}
+	return nil, false, errors.New("fixed purchase receipt insert conflicted but no receipt found")
+}
+
+func isReceiptConstraintError(err error) bool {
+	sqlErr, ok := err.(sqlite3.Error)
+	if !ok {
+		return false
+	}
+	return sqlErr.ExtendedCode == sqlite3.ErrConstraintUnique ||
+		sqlErr.ExtendedCode == sqlite3.ErrConstraintPrimaryKey
+}
+
+// checkReceiptBinding rejects any changed runner/manifest/amount/ticket
+// binding for an already-recorded ticket hash.
+func checkReceiptBinding(existing, incoming *FixedPurchaseReceipt, priceWei string) error {
+	mismatch := func(field string) error {
+		return errors.Wrapf(ErrFixedPurchaseReceiptConflict, "ticket already recorded with a different %s", field)
+	}
+	if existing.Intent != incoming.Intent {
+		return mismatch("intent")
+	}
+	if existing.RunnerID != incoming.RunnerID {
+		return mismatch("runnerID")
+	}
+	if existing.ManifestID != incoming.ManifestID {
+		return mismatch("manifestID")
+	}
+	if existing.PriceWei != priceWei {
+		return mismatch("priceWei")
+	}
+	a, b := existing.Ticket, incoming.Ticket
+	if a.Sender != b.Sender {
+		return mismatch("sender")
+	}
+	if a.Recipient != b.Recipient {
+		return mismatch("recipient")
+	}
+	if a.FaceValue.Cmp(b.FaceValue) != 0 {
+		return mismatch("faceValue")
+	}
+	if a.WinProb.Cmp(b.WinProb) != 0 {
+		return mismatch("winProb")
+	}
+	if a.SenderNonce != b.SenderNonce {
+		return mismatch("senderNonce")
+	}
+	if a.RecipientRandHash != b.RecipientRandHash || a.RecipientRand.Cmp(b.RecipientRand) != 0 {
+		return mismatch("recipientRand")
+	}
+	if !bytes.Equal(a.Sig, b.Sig) {
+		return mismatch("sig")
+	}
+	if a.CreationRound != b.CreationRound || a.CreationRoundBlockHash != b.CreationRoundBlockHash {
+		return mismatch("creationRound")
+	}
+	if a.ParamsExpirationBlock.Cmp(b.ParamsExpirationBlock) != 0 {
+		return mismatch("paramsExpirationBlock")
+	}
+	return nil
+}
+
+// FixedPurchaseReceiptByIntent returns the receipt for a purchase binding, or
+// nil when absent.
+func (db *DB) FixedPurchaseReceiptByIntent(sender ethcommon.Address, intent string) (*FixedPurchaseReceipt, error) {
+	return db.scanFixedPurchaseReceipt(db.selectFixedPurchaseReceiptByIntent, sender.Hex(), intent)
+}
+
+// FixedPurchaseReceiptByTicketHash returns the receipt for a ticket identity,
+// or nil when absent.
+func (db *DB) FixedPurchaseReceiptByTicketHash(hash ethcommon.Hash) (*FixedPurchaseReceipt, error) {
+	return db.scanFixedPurchaseReceipt(db.selectFixedPurchaseReceiptByHash, hash.Hex())
+}
+
+func (db *DB) scanFixedPurchaseReceipt(stmt *sql.Stmt, args ...interface{}) (*FixedPurchaseReceipt, error) {
+	var (
+		intent, runnerID, manifestID  string
+		senderString, recipient       string
+		priceWei                      string
+		faceValue, winProb            []byte
+		senderNonce                   int
+		recipientRand, sig            []byte
+		recipientRandHash, ticketHash string
+		creationRoundBlockHash        string
+		creationRound                 int64
+		paramsExpirationBlock         int64
+		acceptedAt                    string
+	)
+	err := stmt.QueryRow(args...).Scan(
+		&intent, &runnerID, &manifestID, &senderString, &recipient, &priceWei,
+		&faceValue, &winProb, &senderNonce, &recipientRand, &recipientRandHash,
+		&ticketHash, &sig, &creationRound, &creationRoundBlockHash,
+		&paramsExpirationBlock, &acceptedAt,
+	)
+	if err != nil {
+		if err == sql.ErrNoRows {
+			return nil, nil
+		}
+		return nil, errors.Wrap(err, "failed reading fixed purchase receipt")
+	}
+	if senderNonce < 0 || uint64(senderNonce) > uint64(^uint32(0)) {
+		return nil, errors.Wrap(ErrFixedPurchaseReceiptInvalid, "stored nonce is out of range")
+	}
+	accepted, err := parseReceiptTimestamp(acceptedAt)
+	if err != nil {
+		return nil, err
+	}
+	receipt := &FixedPurchaseReceipt{
+		Intent:     intent,
+		RunnerID:   runnerID,
+		ManifestID: manifestID,
+		PriceWei:   priceWei,
+		Ticket: &pm.SignedTicket{
+			Ticket: &pm.Ticket{
+				Sender:                 ethcommon.HexToAddress(senderString),
+				Recipient:              ethcommon.HexToAddress(recipient),
+				FaceValue:              new(big.Int).SetBytes(faceValue),
+				WinProb:                new(big.Int).SetBytes(winProb),
+				SenderNonce:            uint32(senderNonce),
+				RecipientRandHash:      ethcommon.HexToHash(recipientRandHash),
+				CreationRound:          creationRound,
+				CreationRoundBlockHash: ethcommon.HexToHash(creationRoundBlockHash),
+				ParamsExpirationBlock:  big.NewInt(paramsExpirationBlock),
+				PricePerPixel:          new(big.Rat).SetInt(new(big.Int).SetBytes(faceValue)),
+			},
+			Sig:           sig,
+			RecipientRand: new(big.Int).SetBytes(recipientRand),
+		},
+		AcceptedAt: accepted,
+	}
+	canonicalPrice, err := normalizeFixedPurchaseReceipt(receipt)
+	if err != nil || canonicalPrice != receipt.PriceWei {
+		return nil, errors.Wrap(ErrFixedPurchaseReceiptInvalid, "stored receipt has invalid binding")
+	}
+	// The stored ticket hash must reproduce from the stored fields; a row
+	// that fails this check is corrupt and must not be trusted for recovery.
+	if receipt.Ticket.Hash().Hex() != ticketHash {
+		return nil, errors.Wrapf(ErrFixedPurchaseReceiptInvalid, "stored ticket hash mismatch for sender %v intent", senderString)
+	}
+	return receipt, nil
+}
+
+// parseReceiptTimestamp reads the acceptedAt value written once by SQLite
+// CURRENT_TIMESTAMP. A corrupt timestamp fails closed.
+func parseReceiptTimestamp(raw string) (time.Time, error) {
+	for _, layout := range []string{"2006-01-02 15:04:05", time.RFC3339, "2006-01-02T15:04:05.999999999Z07:00"} {
+		if parsed, err := time.Parse(layout, strings.TrimSpace(raw)); err == nil {
+			return parsed.UTC(), nil
+		}
+	}
+	return time.Time{}, errors.Wrapf(ErrFixedPurchaseReceiptInvalid, "unparseable receipt timestamp %q", raw)
+}
diff --git a/common/fixed_purchase_receipt_test.go b/common/fixed_purchase_receipt_test.go
new file mode 100644
index 00000000..aedf849d
--- /dev/null
+++ b/common/fixed_purchase_receipt_test.go
@@ -0,0 +1,274 @@
+package common
+
+// Durable collateral for fixed-purchase receipt storage: real SQLite through
+// the existing TempDB/InitDB lifecycle. No chain, signatures, funds, or
+// network; synthetic tickets only, since signature validation belongs to the
+// caller (core), not this storage layer.
+
+import (
+	"math/big"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/livepeer/go-livepeer/pm"
+	"github.com/stretchr/testify/require"
+)
+
+func testReceiptMaxWinProb() *big.Int {
+	return new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 256), big.NewInt(1))
+}
+
+func testReceiptTicket(priceWei string, nonce uint32) *pm.SignedTicket {
+	price, ok := new(big.Int).SetString(priceWei, 10)
+	if !ok {
+		panic("bad test price")
+	}
+	return &pm.SignedTicket{
+		Ticket: &pm.Ticket{
+			Recipient:              ethcommon.HexToAddress("0x1111111111111111111111111111111111111111"),
+			Sender:                 ethcommon.HexToAddress("0x2222222222222222222222222222222222222222"),
+			FaceValue:              new(big.Int).Set(price),
+			WinProb:                testReceiptMaxWinProb(),
+			SenderNonce:            nonce,
+			RecipientRandHash:      ethcommon.HexToHash("0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"),
+			CreationRound:          7,
+			CreationRoundBlockHash: ethcommon.HexToHash("0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"),
+			ParamsExpirationBlock:  big.NewInt(500),
+			PricePerPixel:          new(big.Rat).SetInt(price),
+		},
+		Sig:           []byte("test-sig-for-receipt"),
+		RecipientRand: big.NewInt(424242),
+	}
+}
+
+func testReceipt(intent, runner, manifest, price string, ticket *pm.SignedTicket) *FixedPurchaseReceipt {
+	return &FixedPurchaseReceipt{
+		Intent:     intent,
+		RunnerID:   runner,
+		ManifestID: manifest,
+		PriceWei:   price,
+		Ticket:     ticket,
+	}
+}
+
+func requireReceiptsEqual(t *testing.T, want, got *FixedPurchaseReceipt) {
+	t.Helper()
+	require.Equal(t, want.Intent, got.Intent)
+	require.Equal(t, want.RunnerID, got.RunnerID)
+	require.Equal(t, want.ManifestID, got.ManifestID)
+	require.Equal(t, want.PriceWei, got.PriceWei)
+	require.Equal(t, want.Ticket.Sender, got.Ticket.Sender)
+	require.Equal(t, want.Ticket.Recipient, got.Ticket.Recipient)
+	require.Equal(t, 0, want.Ticket.FaceValue.Cmp(got.Ticket.FaceValue))
+	require.Equal(t, 0, want.Ticket.WinProb.Cmp(got.Ticket.WinProb))
+	require.Equal(t, want.Ticket.SenderNonce, got.Ticket.SenderNonce)
+	require.Equal(t, want.Ticket.RecipientRandHash, got.Ticket.RecipientRandHash)
+	require.Equal(t, 0, want.Ticket.RecipientRand.Cmp(got.Ticket.RecipientRand))
+	require.Equal(t, want.Ticket.Sig, got.Ticket.Sig)
+	require.Equal(t, want.Ticket.CreationRound, got.Ticket.CreationRound)
+	require.Equal(t, want.Ticket.CreationRoundBlockHash, got.Ticket.CreationRoundBlockHash)
+	require.Equal(t, 0, want.Ticket.ParamsExpirationBlock.Cmp(got.Ticket.ParamsExpirationBlock))
+	require.Equal(t, want.Ticket.Hash(), got.Ticket.Hash())
+	require.Zero(t, want.Ticket.PricePerPixel.Cmp(got.Ticket.PricePerPixel))
+}
+
+func TestStoreFixedPurchaseReceiptRoundTrip(t *testing.T) {
+	dbh, dbraw, err := TempDB(t)
+	require.NoError(t, err)
+	defer dbh.Close()
+	defer dbraw.Close()
+
+	intent := strings.Repeat("a1", 32)
+	receipt := testReceipt(intent, "runner-1", "purchase-m1", "1000", testReceiptTicket("1000", 9))
+
+	stored, created, err := dbh.StoreFixedPurchaseReceipt(receipt)
+	require.NoError(t, err)
+	require.True(t, created)
+	require.False(t, stored.AcceptedAt.IsZero())
+
+	byIntent, err := dbh.FixedPurchaseReceiptByIntent(receipt.Ticket.Sender, intent)
+	require.NoError(t, err)
+	require.NotNil(t, byIntent)
+	requireReceiptsEqual(t, stored, byIntent)
+	require.Equal(t, stored.AcceptedAt.Unix(), byIntent.AcceptedAt.Unix())
+
+	byHash, err := dbh.FixedPurchaseReceiptByTicketHash(receipt.Ticket.Hash())
+	require.NoError(t, err)
+	require.NotNil(t, byHash)
+	requireReceiptsEqual(t, stored, byHash)
+
+	absent, err := dbh.FixedPurchaseReceiptByIntent(receipt.Ticket.Sender, strings.Repeat("b2", 32))
+	require.NoError(t, err)
+	require.Nil(t, absent)
+}
+
+func TestStoreFixedPurchaseReceiptReopen(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "receipts.db")
+	dbh, err := InitDB(path)
+	require.NoError(t, err)
+
+	intent := strings.Repeat("c3", 32)
+	receipt := testReceipt(intent, "runner-1", "purchase-m1", "1000", testReceiptTicket("1000", 9))
+	stored, created, err := dbh.StoreFixedPurchaseReceipt(receipt)
+	require.NoError(t, err)
+	require.True(t, created)
+	dbh.Close()
+
+	reopened, err := InitDB(path)
+	require.NoError(t, err)
+	defer reopened.Close()
+
+	byIntent, err := reopened.FixedPurchaseReceiptByIntent(receipt.Ticket.Sender, intent)
+	require.NoError(t, err)
+	require.NotNil(t, byIntent)
+	requireReceiptsEqual(t, stored, byIntent)
+	require.Equal(t, stored.AcceptedAt.Unix(), byIntent.AcceptedAt.Unix())
+}
+
+func TestStoreFixedPurchaseReceiptReplay(t *testing.T) {
+	dbh, dbraw, err := TempDB(t)
+	require.NoError(t, err)
+	defer dbh.Close()
+	defer dbraw.Close()
+
+	intent := strings.Repeat("d4", 32)
+	receipt := testReceipt(intent, "runner-1", "purchase-m1", "1000", testReceiptTicket("1000", 9))
+
+	first, created, err := dbh.StoreFixedPurchaseReceipt(receipt)
+	require.NoError(t, err)
+	require.True(t, created)
+
+	second, created, err := dbh.StoreFixedPurchaseReceipt(testReceipt(intent, "runner-1", "purchase-m1", "1000", testReceiptTicket("1000", 9)))
+	require.NoError(t, err)
+	require.False(t, created)
+	requireReceiptsEqual(t, first, second)
+}
+
+func TestStoreFixedPurchaseReceiptConflict(t *testing.T) {
+	dbh, dbraw, err := TempDB(t)
+	require.NoError(t, err)
+	defer dbh.Close()
+	defer dbraw.Close()
+
+	intent := strings.Repeat("e5", 32)
+	price := "1000"
+	original := testReceipt(intent, "runner-1", "purchase-m1", price, testReceiptTicket(price, 9))
+	stored, created, err := dbh.StoreFixedPurchaseReceipt(original)
+	require.NoError(t, err)
+	require.True(t, created)
+
+	// Same ticket under a changed binding must be rejected, never overwritten.
+	changed := []struct {
+		name   string
+		mutate func(*FixedPurchaseReceipt)
+	}{
+		{"manifest", func(r *FixedPurchaseReceipt) { r.ManifestID = "purchase-m2" }},
+		{"runner", func(r *FixedPurchaseReceipt) { r.RunnerID = "runner-2" }},
+		{"intent", func(r *FixedPurchaseReceipt) { r.Intent = strings.Repeat("f6", 32) }},
+		{"price", func(r *FixedPurchaseReceipt) {
+			r.PriceWei = "2000"
+			r.Ticket = testReceiptTicket("2000", 9)
+		}},
+	}
+	for _, tc := range changed {
+		t.Run(tc.name, func(t *testing.T) {
+			candidate := testReceipt(intent, "runner-1", "purchase-m1", price, testReceiptTicket(price, 9))
+			tc.mutate(candidate)
+			_, _, err := dbh.StoreFixedPurchaseReceipt(candidate)
+			require.ErrorIs(t, err, ErrFixedPurchaseReceiptConflict)
+		})
+	}
+
+	// A second ticket for the same (sender, intent) order must be rejected.
+	other := testReceipt(intent, "runner-1", "purchase-m1", price, testReceiptTicket(price, 10))
+	_, _, err = dbh.StoreFixedPurchaseReceipt(other)
+	require.ErrorIs(t, err, ErrFixedPurchaseReceiptConflict)
+
+	// The original row is untouched by every conflict above.
+	kept, err := dbh.FixedPurchaseReceiptByTicketHash(original.Ticket.Hash())
+	require.NoError(t, err)
+	require.NotNil(t, kept)
+	requireReceiptsEqual(t, stored, kept)
+}
+
+func TestStoreFixedPurchaseReceiptValidation(t *testing.T) {
+	dbh, dbraw, err := TempDB(t)
+	require.NoError(t, err)
+	defer dbh.Close()
+	defer dbraw.Close()
+
+	intent := strings.Repeat("a7", 32)
+	overMax := new(big.Int).Add(testReceiptMaxWinProb(), big.NewInt(1))
+	cases := map[string]func(*FixedPurchaseReceipt){
+		"empty intent":      func(r *FixedPurchaseReceipt) { r.Intent = "" },
+		"empty runner":      func(r *FixedPurchaseReceipt) { r.RunnerID = "" },
+		"empty manifest":    func(r *FixedPurchaseReceipt) { r.ManifestID = "" },
+		"bad price":         func(r *FixedPurchaseReceipt) { r.PriceWei = "not-a-number" },
+		"zero price":        func(r *FixedPurchaseReceipt) { r.PriceWei = "0" },
+		"face mismatch":     func(r *FixedPurchaseReceipt) { r.Ticket.FaceValue = big.NewInt(999) },
+		"non-guaranteed":    func(r *FixedPurchaseReceipt) { r.Ticket.WinProb = big.NewInt(1) },
+		"nil expiry":        func(r *FixedPurchaseReceipt) { r.Ticket.ParamsExpirationBlock = nil },
+		"expiry overflow":   func(r *FixedPurchaseReceipt) { r.Ticket.ParamsExpirationBlock = new(big.Int).Lsh(big.NewInt(1), 64) },
+		"wrong rate":        func(r *FixedPurchaseReceipt) { r.Ticket.PricePerPixel = big.NewRat(2, 1) },
+		"nil rate":          func(r *FixedPurchaseReceipt) { r.Ticket.PricePerPixel = nil },
+		"negative random":   func(r *FixedPurchaseReceipt) { r.Ticket.RecipientRand = big.NewInt(-1) },
+		"negative round":    func(r *FixedPurchaseReceipt) { r.Ticket.CreationRound = -1 },
+		"zero winprob":      func(r *FixedPurchaseReceipt) { r.Ticket.WinProb = big.NewInt(0) },
+		"winprob over max":  func(r *FixedPurchaseReceipt) { r.Ticket.WinProb = overMax },
+		"zero sender":       func(r *FixedPurchaseReceipt) { r.Ticket.Sender = ethcommon.Address{} },
+		"zero recipient":    func(r *FixedPurchaseReceipt) { r.Ticket.Recipient = ethcommon.Address{} },
+		"empty sig":         func(r *FixedPurchaseReceipt) { r.Ticket.Sig = nil },
+		"nil recipientRand": func(r *FixedPurchaseReceipt) { r.Ticket.RecipientRand = nil },
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			candidate := testReceipt(intent, "runner-1", "purchase-m1", "1000", testReceiptTicket("1000", 9))
+			mutate(candidate)
+			_, _, err := dbh.StoreFixedPurchaseReceipt(candidate)
+			require.ErrorIs(t, err, ErrFixedPurchaseReceiptInvalid)
+		})
+	}
+}
+
+func TestStoreFixedPurchaseReceiptConcurrent(t *testing.T) {
+	dbh, dbraw, err := TempDB(t)
+	require.NoError(t, err)
+	defer dbh.Close()
+	defer dbraw.Close()
+
+	intent := strings.Repeat("b8", 32)
+	const writers = 16
+	var createdCount atomic.Int64
+	var wg sync.WaitGroup
+	errs := make([]error, writers)
+	results := make([]*FixedPurchaseReceipt, writers)
+	for i := 0; i < writers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			stored, created, err := dbh.StoreFixedPurchaseReceipt(
+				testReceipt(intent, "runner-1", "purchase-m1", "1000", testReceiptTicket("1000", 9)))
+			if err != nil {
+				errs[i] = err
+				return
+			}
+			if created {
+				createdCount.Add(1)
+			}
+			results[i] = stored
+		}(i)
+	}
+	wg.Wait()
+	for _, err := range errs {
+		require.NoError(t, err)
+	}
+	require.Equal(t, int64(1), createdCount.Load())
+	for _, got := range results {
+		require.NotNil(t, got)
+		requireReceiptsEqual(t, results[0], got)
+	}
+}
diff --git a/common/ticket_queue_replay_test.go b/common/ticket_queue_replay_test.go
