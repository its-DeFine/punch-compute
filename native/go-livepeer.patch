+
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/livepeer/go-livepeer/common"
+	"github.com/livepeer/go-livepeer/pm"
+	"github.com/stretchr/testify/require"
+)
+
+type receiptReadbackOrchestrator struct {
+	*stubOrchestrator
+	receipt *common.FixedPurchaseReceipt
+	reads   int
+}
+
+func (s *receiptReadbackOrchestrator) FixedPurchaseForSession(payer ethcommon.Address, intent, runnerID, manifestID string) (*common.FixedPurchaseReceipt, error) {
+	s.reads++
+	if s.receipt != nil && s.receipt.Ticket.Sender == payer && s.receipt.Intent == intent && s.receipt.RunnerID == runnerID && s.receipt.ManifestID == manifestID {
+		return s.receipt, nil
+	}
+	return nil, nil
+}
+func TestReadLiveRunnerPurchaseRequiresSessionAndReceipt(t *testing.T) {
+	lp := newLiveRunnerHTTPOnchain(t)
+	registerFixedSingleShotRunner(t, lp, "runner-readback", "http://127.0.0.1:1")
+	manager, ok := lp.liveRunnerManager()
+	require.True(t, ok)
+	sessionID, _, err := manager.ReserveSession("runner-readback", "purchase-readback")
+	require.NoError(t, err)
+	defer manager.ReleaseSession("runner-readback", sessionID)
+	token, err := manager.SessionTokenForSession("runner-readback", sessionID)
+	require.NoError(t, err)
+	reader := &receiptReadbackOrchestrator{stubOrchestrator: lp.orchestrator.(*stubOrchestrator)}
+	lp.orchestrator = reader
+	payer, recipient := pm.RandAddress(), pm.RandAddress()
+	intent := purchaseIntentFor(t, "readback-order")
+	request := func(token string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest(http.MethodGet, "/receipt?intent="+intent+"&payer="+payer.Hex(), nil)
+		req.SetPathValue("runner_id", "runner-readback")
+		req.SetPathValue("session_id", sessionID)
+		req.Header.Set("Livepeer-Session-Token", token)
+		w := httptest.NewRecorder()
+		lp.ReadLiveRunnerPurchase(w, req)
+		return w
+	}
+	require.NotEqual(t, 200, request("forged").Code)
+	require.Zero(t, reader.reads)
+	require.Equal(t, 404, request(token).Code) // Valid unpaid session cannot attest payment.
+	reader.receipt = &common.FixedPurchaseReceipt{Intent: intent, RunnerID: "runner-readback", ManifestID: sessionID, PriceWei: "1000",
+		Ticket: &pm.SignedTicket{Ticket: &pm.Ticket{Sender: payer, Recipient: recipient, FaceValue: big.NewInt(1000), WinProb: big.NewInt(1), RecipientRandHash: pm.RandHash()}, Sig: []byte("private-signature"), RecipientRand: big.NewInt(7)}}
+	w := request(token)
+	require.Equal(t, 200, w.Code, w.Body.String())
+	var data map[string]string
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &data))
+	require.Equal(t, intent, data["intent"])
+	require.Equal(t, "ACCEPTED", data["state"])
+	require.NotContains(t, w.Body.String(), "private-signature")
+	require.NotContains(t, data, "recipient_rand")
+	require.Equal(t, "no-store", w.Header().Get("Cache-Control"))
+}
diff --git a/server/fixed_purchase_remote_signer_integration_test.go b/server/fixed_purchase_remote_signer_integration_test.go
new file mode 100644
index 00000000..adaa6ade
--- /dev/null
+++ b/server/fixed_purchase_remote_signer_integration_test.go
@@ -0,0 +1,148 @@
+package server
+
+// Remote-signer provenance for the native fixed checkout: the supported
+// buyer-side LivepeerServer.GenerateLivePayment (type "fixed") generates a
+// real valid guaranteed ticket for the native challenge, replacing the
+// handcrafted buyerPayment bytes. The ephemeral harness key signs; only the
+// external chain (funds/round/time reads) is synthetic — never the signature,
+// the PM sender, the remote endpoint, or ticket validation.
+//
+// Proof limits: no AWS authorization webhook is configured here, no funds
+// move on chain, and lost-signer-response recovery is not exercised. Runs on
+// the prepared Linux runner, not in this environment.
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/golang/protobuf/proto"
+	"github.com/livepeer/go-livepeer/ai/runner"
+	"github.com/livepeer/go-livepeer/core"
+	"github.com/livepeer/go-livepeer/eth"
+	lpnet "github.com/livepeer/go-livepeer/net"
+	"github.com/livepeer/go-livepeer/pm"
+	"github.com/stretchr/testify/require"
+)
+
+func fixedPurchaseMaxWinProb(t *testing.T) *big.Int {
+	t.Helper()
+	maxWinProb, ok := new(big.Int).SetString(strings.Repeat("f", 64), 16)
+	require.True(t, ok)
+	return maxWinProb
+}
+
+func (h *checkoutNativeHarness) remoteSignerServer(t *testing.T) *LivepeerServer {
+	t.Helper()
+	// Buyer side: supported remote signer with the ephemeral harness key.
+	// Chain reads are synthetic; signing, sender, endpoint, and validation
+	// are the real implementations.
+	buyerEth := &testEthClient{
+		StubClient: &eth.StubClient{TranscoderAddress: h.buyer},
+		key:        h.buyerKey,
+		addr:       h.buyer,
+	}
+	buyerNode, err := core.NewLivepeerNode(buyerEth, t.TempDir(), nil)
+	require.NoError(t, err)
+	buyerNode.Balances = core.NewAddressBalances(time.Minute)
+	t.Cleanup(buyerNode.Balances.StopCleanup)
+	funds, ok := new(big.Int).SetString("1000000000000000000000000", 10)
+	require.True(t, ok)
+	buyerNode.Sender = pm.NewSender(
+		buyerEth,
+		&checkoutTestTimeManager{
+			round: big.NewInt(10), block: big.NewInt(1000),
+			poolSize: big.NewInt(1), blockHash: h.blockHash,
+		},
+		&checkoutTestSenderManager{deposit: funds},
+		new(big.Rat).SetInt(funds),
+		new(big.Rat).SetInt(funds),
+		1,
+	)
+	return &LivepeerServer{LivepeerNode: buyerNode}
+
+}
+
+func (h *checkoutNativeHarness) remoteSignerPayment(t *testing.T, oInfo *lpnet.OrchestratorInfo, manifest string) (string, string) {
+	t.Helper()
+	priceWei := oInfo.GetPriceInfo().GetPricePerUnit()
+
+	buyerServer := h.remoteSignerServer(t)
+
+	oInfoBytes, err := proto.Marshal(oInfo)
+	require.NoError(t, err)
+	emptyCaps, err := proto.Marshal(core.NewCapabilities(nil, nil).ToNetCapabilities())
+	require.NoError(t, err)
+	signerBody, err := json.Marshal(RemotePaymentRequest{
+		Orchestrator: oInfoBytes,
+		ManifestID:   manifest,
+		App:          "punch/compute-v1",
+		Type:         RemoteType_Fixed,
+		MaxPrice: &runner.LiveRunnerPriceInfo{
+			Price:    json.Number(strconv.FormatInt(priceWei, 10)),
+			Currency: "wei",
+			Unit:     "fixed",
+		},
+		Capabilities: emptyCaps,
+	})
+	require.NoError(t, err)
+	signerReq := httptest.NewRequest(http.MethodPost, "/generate-live-payment", bytes.NewReader(signerBody))
+	signerResp := httptest.NewRecorder()
+	buyerServer.GenerateLivePayment(signerResp, signerReq)
+	require.Equal(t, http.StatusOK, signerResp.Code, signerResp.Body.String())
+	var generated RemotePaymentResponse
+	require.NoError(t, json.NewDecoder(signerResp.Body).Decode(&generated))
+	require.NotEmpty(t, generated.Payment)
+	require.NotEmpty(t, generated.SegCreds)
+
+	// The generated material is a real guaranteed fixed ticket, not
+	// handcrafted bytes: quoted face, max win probability, quoted price,
+	// buyer sender, and a signature the orchestrator accepts.
+	paymentRaw, err := base64.StdEncoding.DecodeString(generated.Payment)
+	require.NoError(t, err)
+	var generatedPayment lpnet.Payment
+	require.NoError(t, proto.Unmarshal(paymentRaw, &generatedPayment))
+	require.Equal(t, h.buyer.Bytes(), generatedPayment.Sender)
+	require.Equal(t, 0, new(big.Int).SetBytes(generatedPayment.TicketParams.FaceValue).Cmp(big.NewInt(priceWei)))
+	require.Equal(t, 0, new(big.Int).SetBytes(generatedPayment.TicketParams.WinProb).Cmp(fixedPurchaseMaxWinProb(t)))
+	require.Equal(t, priceWei, generatedPayment.ExpectedPrice.PricePerUnit)
+	require.Equal(t, int64(1), generatedPayment.ExpectedPrice.PixelsPerUnit)
+	require.Len(t, generatedPayment.TicketSenderParams, 1)
+	require.Len(t, generatedPayment.TicketSenderParams[0].Sig, 65)
+
+	return generated.Payment, generated.SegCreds
+}
+
+func TestFixedPurchaseRemoteSignerGeneratesValidTicket(t *testing.T) {
+	h := newCheckoutNativeHarness(t)
+	upstream := checkoutTestApp(t, h)
+	defer upstream.Close()
+	h.registerRunner(t, upstream.URL)
+	intent := strings.Repeat("f0", 32)
+	manifest, oInfo := h.challenge(t, intent)
+	priceWei := oInfo.GetPriceInfo().GetPricePerUnit()
+	payment, segment := h.remoteSignerPayment(t, oInfo, manifest)
+
+	// The local response submits to the actual paid app and wins.
+	resp := httptest.NewRecorder()
+	h.lp.ServeHTTP(resp, h.paidAppRequest(t, manifest, intent, payment, segment, nil))
+	require.Equal(t, http.StatusOK, resp.Code, resp.Body.String())
+	require.Equal(t, 1, h.rec.calls)
+	require.Equal(t, intent, h.rec.headers.Get("Livepeer-Paid-Intent"))
+	require.Equal(t, h.buyer.Hex(), h.rec.headers.Get("Livepeer-Paid-Payer"))
+	require.Equal(t, h.orchAddr.Hex(), h.rec.headers.Get("Livepeer-Paid-Recipient"))
+	require.Equal(t, strconv.FormatInt(priceWei, 10), h.rec.headers.Get("Livepeer-Paid-Amount-Wei"))
+
+	receipt, err := h.dbh.FixedPurchaseReceiptByIntent(h.buyer, intent)
+	require.NoError(t, err)
+	require.NotNil(t, receipt)
+	require.Equal(t, manifest, receipt.ManifestID)
+	require.Equal(t, 1, h.queuedCount())
+}
diff --git a/server/fixed_purchase_wrapper_integration_test.go b/server/fixed_purchase_wrapper_integration_test.go
new file mode 100644
index 00000000..3e3a4b03
--- /dev/null
+++ b/server/fixed_purchase_wrapper_integration_test.go
@@ -0,0 +1,272 @@
+package server
+
+// Opt-in full acceptance: actual native HTTP single-shot request with a real
+// ephemeral ticket -> real core/PM acceptance -> real SQLite receipt -> proxy
+// with paid provenance -> actual Python wrapper child -> actual strict New API
+// child (unfunded, loopback only). No Docker here; root runs this inside one
+// isolated existing Linux container mounting the binaries and source, with no
+// network beyond loopback.
+//
+// Run: PUNCH_NEWAPI_BINARY=/absolute/new-api-strict1
+//      PUNCH_WRAPPER_ROOT=/absolute/work/punch-token-release-20260920
+//      go test ./server/ -run TestFixedPurchaseWrapperIntegration -v
+// Skips honestly when either variable is absent. The Python fixture owns the
+// New API + wrapper children; this test kills the whole fixture process group
+// on cleanup (success, failure, or cancel). Fixture stdout/stderr carry no
+// keys or tokens by contract; order-key equality is asserted without logging
+// values.
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+type wrapperReady struct {
+	OtherBuyerAuthorization string `json:"other_buyer_authorization"`
+	WrapperURL              string `json:"wrapper_url"`
+	OrderID                 string `json:"order_id"`
+	Intent                  string `json:"intent"`
+	BuyerAuthorization      string `json:"buyer_authorization"`
+	PriceWei                int64  `json:"price_wei"`
+	ReadbackURL             string `json:"readback_url"`
+}
+
+type wrapperGrant struct {
+	Policy struct {
+		InputRate     float64 `json:"input_rate"`
+		OutputRate    float64 `json:"output_rate"`
+		ContextTokens int     `json:"context_tokens"`
+	} `json:"policy"`
+	TokenCount int   `json:"token_count"`
+	Quota      int64 `json:"quota"`
+	Allowance  int64 `json:"allowance"`
+	UserID     int64 `json:"user_id"`
+	TokenID    int64 `json:"token_id"`
+}
+
+func TestOperatorNativeClientWrapperIntegration(t *testing.T) {
+	t.Setenv("PUNCH_TEST_NATIVE_CLIENT", "1")
+	TestFixedPurchaseWrapperIntegration(t)
+}
+
+func TestFixedPurchaseWrapperIntegration(t *testing.T) {
+	newapiBinary := os.Getenv("PUNCH_NEWAPI_BINARY")
+	wrapperRoot := os.Getenv("PUNCH_WRAPPER_ROOT")
+	if newapiBinary == "" || wrapperRoot == "" {
+		t.Skip("NOT_TESTED: requires PUNCH_NEWAPI_BINARY and PUNCH_WRAPPER_ROOT")
+	}
+	python, err := exec.LookPath("python3")
+	if err != nil {
+		t.Skip("NOT_TESTED: python3 is required for the fixture")
+	}
+	h := newCheckoutNativeHarness(t)
+	nodeSrv := httptest.NewServer(h.lp)
+	t.Cleanup(nodeSrv.Close)
+
+	dir := t.TempDir()
+	readyPath := filepath.Join(dir, "ready.json")
+	logPath := filepath.Join(dir, "fixture.log")
+	logFile, err := os.OpenFile(logPath, os.O_CREATE|os.O_WRONLY|os.O_EXCL, 0600)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = logFile.Close() })
+	registrationPath := filepath.Join(dir, "registration.secret")
+	require.NoError(t, os.WriteFile(registrationPath, []byte(h.secret), 0600))
+	cmd := exec.Command(python, filepath.Join(wrapperRoot, "tests", "native_checkout_fixture.py"),
+		"--node-base", nodeSrv.URL,
+		"--payer", h.buyer.Hex(),
+		"--recipient", h.orchAddr.Hex(),
+		"--ready-file", readyPath, "--registration-file", registrationPath)
+	cmd.Env = append(os.Environ(),
+		"PUNCH_NEWAPI_BINARY="+newapiBinary,
+		"PUNCH_WRAPPER_ROOT="+wrapperRoot)
+	cmd.Stdout = logFile
+	cmd.Stderr = logFile
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	require.NoError(t, cmd.Start())
+	finished := make(chan struct{})
+	go func() { _ = cmd.Wait(); close(finished) }()
+	t.Cleanup(func() {
+		_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGTERM)
+		select {
+		case <-finished:
+		case <-time.After(15 * time.Second):
+			_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
+			<-finished
+		}
+		// Include children left behind if the Python fixture failed early.
+		_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL)
+	})
+
+	var ready wrapperReady
+	readyDeadline := time.Now().Add(60 * time.Second)
+	for {
+		raw, readErr := os.ReadFile(readyPath)
+		var parsed wrapperReady
+		if readErr == nil && json.Unmarshal(raw, &parsed) == nil &&
+			parsed.WrapperURL != "" && parsed.OrderID != "" &&
+			parsed.Intent != "" && parsed.BuyerAuthorization != "" &&
+			parsed.ReadbackURL != "" {
+			ready = parsed
+			break
+		}
+		select {
+		case <-finished:
+			log, _ := os.ReadFile(logPath)
+			t.Fatalf("fixture exited before ready: %s", string(log))
+		default:
+		}
+		if time.Now().After(readyDeadline) {
+			t.Fatal("fixture ready timeout")
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+
+	// Seller publication must register the real native runner automatically.
+	manifest, oInfo := h.challenge(t, ready.Intent)
+	require.Equal(t, ready.PriceWei, oInfo.GetPriceInfo().GetPricePerUnit())
+
+	var signerCalls atomic.Int32
+	signerPath := filepath.Join(dir, "signer.json")
+	operatorClient := os.Getenv("PUNCH_TEST_NATIVE_CLIENT") == "1"
+	if operatorClient {
+		buyer := h.remoteSignerServer(t)
+		signer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			signerCalls.Add(1)
+			buyer.GenerateLivePayment(w, r)
+		}))
+		t.Cleanup(signer.Close)
+		signerPath = signer.URL
+	} else {
+		payment, segment := h.remoteSignerPayment(t, oInfo, manifest)
+		signerJSON, err := json.Marshal(map[string]string{"payment": payment, "segCreds": segment})
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(signerPath, signerJSON, 0600))
+	}
+	activate := func() *httptest.ResponseRecorder {
+		output := filepath.Join(dir, "delivery.json")
+		code := `import json,sys,subprocess,os
+from pathlib import Path
+os.umask(0o077)
+ready=json.loads(Path(sys.argv[2]).read_text())
+state_dir=Path(sys.argv[5]); state_dir.mkdir(mode=0o700,exist_ok=True)
+prep=state_dir/"prepared.json"; creds=state_dir/"buyer.json"
+prep.write_text(json.dumps(ready["prepared"]))
+creds.write_text(json.dumps(ready["buyer_credentials"]))
+cli=[sys.executable,sys.argv[1]+"/bin/punch-token-orders","purchase-deliver","--api",ready["buyer_auth_url"],"--buyer-creds",str(creds),"--input",str(prep),"--native",sys.argv[3],"--signer-response",sys.argv[4],"--state-dir",str(state_dir)]
+r=subprocess.run(cli,capture_output=True,text=True)
+assert r.returncode==0, "actual buyer CLI failed: "+r.stdout+r.stderr
+result=json.loads(r.stdout)
+key=Path(result["credentials_file"]).read_text()
+assert key and key not in r.stdout, "CLI exposed key"
+Path(sys.argv[6]).write_text(json.dumps({"success":True,"data":{"state":result["state"],"order_id":result["order_id"],"order_key":key}}))
+`
+		client := exec.Command(python, "-c", code, wrapperRoot, readyPath, nodeSrv.URL, signerPath, filepath.Join(dir, "delivery-state"), output)
+		if operatorClient {
+			client = exec.Command(python, filepath.Join(wrapperRoot, "tests/native_operator_client_fixture.py"), wrapperRoot, readyPath, nodeSrv.URL, signerPath, filepath.Join(dir, "delivery-state"), output)
+		}
+		result, err := client.CombinedOutput()
+		require.NoError(t, err, "delivery client failed: %s", string(result))
+		raw, err := os.ReadFile(output)
+		require.NoError(t, err)
+		w := httptest.NewRecorder()
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write(raw)
+		return w
+	}
+
+	first := activate()
+	require.Equal(t, http.StatusOK, first.Code, "native activation failed")
+	var env1 struct {
+		Success bool `json:"success"`
+		Data    struct {
+			State   string `json:"state"`
+			OrderID string `json:"order_id"`
+			Key     string `json:"order_key"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(first.Body.Bytes(), &env1))
+	require.True(t, env1.Success)
+	require.Equal(t, "READY", env1.Data.State)
+	require.Equal(t, ready.OrderID, env1.Data.OrderID)
+	require.True(t, env1.Data.Key != "", "empty order key after activation")
+
+	// An activated order still belongs only to its authenticated purchaser.
+	for _, suffix := range []string{"/purchases/", "/orders/"} {
+		for _, owner := range []bool{true, false} {
+			req, err := http.NewRequest(http.MethodGet, ready.WrapperURL+suffix+ready.OrderID, nil)
+			require.NoError(t, err)
+			auth := ready.OtherBuyerAuthorization
+			expected := http.StatusNotFound
+			if owner {
+				auth = ready.BuyerAuthorization
+				expected = http.StatusOK
+			}
+			req.Header.Set("Authorization", auth)
+			response, err := (&http.Client{Timeout: 10 * time.Second}).Do(req)
+			require.NoError(t, err)
+			response.Body.Close()
+			require.Equal(t, expected, response.StatusCode, "activated order ownership mismatch")
+		}
+	}
+
+	grant := readbackWrapperGrant(t, ready.ReadbackURL, ready.OrderID)
+	require.Equal(t, 1, grant.TokenCount)
+	require.Equal(t, grant.Allowance, grant.Quota)
+	require.Equal(t, float64(2), grant.Policy.InputRate)
+	require.Equal(t, float64(3), grant.Policy.OutputRate)
+	require.Equal(t, 4096, grant.Policy.ContextTokens)
+
+	// Product wrapper restart and offer withdrawal retain the paid order.
+	// The fixture invokes only supported product APIs; no ledger mutation.
+	for _, operation := range []string{"restart", "withdraw"} {
+		req, err := http.NewRequest(http.MethodPost, ready.ReadbackURL+"/"+operation, nil)
+		require.NoError(t, err)
+		resp, err := (&http.Client{Timeout: 20 * time.Second}).Do(req)
+		require.NoError(t, err)
+		resp.Body.Close()
+		require.Equal(t, http.StatusNoContent, resp.StatusCode, "fixture lifecycle operation failed")
+	}
+	// Same signed ticket retried: no second grant, same key, values unlogged.
+	second := activate()
+	require.Equal(t, http.StatusOK, second.Code, "native replay failed")
+	var env2 struct {
+		Success bool `json:"success"`
+		Data    struct {
+			Key string `json:"order_key"`
+		} `json:"data"`
+	}
+	require.NoError(t, json.Unmarshal(second.Body.Bytes(), &env2))
+	require.True(t, env2.Success)
+	require.True(t, env2.Data.Key == env1.Data.Key, "order key changed on same-ticket retry")
+	grantAgain := readbackWrapperGrant(t, ready.ReadbackURL, ready.OrderID)
+	require.Equal(t, 1, grantAgain.TokenCount)
+	require.Equal(t, grant.TokenID, grantAgain.TokenID)
+	require.Equal(t, grant.UserID, grantAgain.UserID)
+	require.Equal(t, grant.Quota, grantAgain.Quota)
+	require.Equal(t, grant.Policy, grantAgain.Policy)
+	if operatorClient {
+		require.Equal(t, int32(1), signerCalls.Load(), "recovery signed again")
+	}
+}
+
+func readbackWrapperGrant(t *testing.T, readbackURL, orderID string) wrapperGrant {
+	t.Helper()
+	resp, err := (&http.Client{Timeout: 10 * time.Second}).Get(readbackURL + "/grant?order=" + url.QueryEscape(orderID))
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	var grant wrapperGrant
+	require.NoError(t, json.NewDecoder(resp.Body).Decode(&grant))
+	return grant
+}
