+package server
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/livepeer/go-livepeer/common"
+)
+
+type fixedPurchaseSessionReader interface {
+	FixedPurchaseForSession(ethcommon.Address, string, string, string) (*common.FixedPurchaseReceipt, error)
+}
+
+// ReadLiveRunnerPurchase verifies the existing runner session capability before
+// exposing a minimal durable receipt. No signature, random, or account secret is
+// returned. This lets a runner verify paid admission against its configured node
+// instead of treating forwarded headers as proof of payment.
+func (h *lphttp) ReadLiveRunnerPurchase(w http.ResponseWriter, r *http.Request) {
+	manager, ok := h.liveRunnerManager()
+	if !ok {
+		http.Error(w, "live runners unavailable", http.StatusNotFound)
+		return
+	}
+	runnerID, sessionID := r.PathValue("runner_id"), r.PathValue("session_id")
+	if err := manager.ValidSessionToken(runnerID, sessionID, r.Header.Get("Livepeer-Session-Token")); err != nil {
+		respondWithLiveRunnerError(w, err)
+		return
+	}
+	intent, err := parsePurchaseIntent(r.URL.Query().Get("intent"))
+	payer := r.URL.Query().Get("payer")
+	if err != nil || intent == "" || !ethcommon.IsHexAddress(payer) {
+		http.Error(w, "invalid purchase identity", http.StatusBadRequest)
+		return
+	}
+	reader, ok := h.orchestrator.(fixedPurchaseSessionReader)
+	if !ok {
+		http.Error(w, "purchase readback unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	receipt, err := reader.FixedPurchaseForSession(ethcommon.HexToAddress(payer), intent, runnerID, sessionID)
+	if err != nil {
+		http.Error(w, "purchase readback failed", http.StatusServiceUnavailable)
+		return
+	}
+	if receipt == nil {
+		http.Error(w, "accepted purchase not found", http.StatusNotFound)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	json.NewEncoder(w).Encode(map[string]string{
+		"intent": receipt.Intent, "runner_id": receipt.RunnerID, "manifest_id": receipt.ManifestID,
+		"payer": strings.ToLower(receipt.Ticket.Sender.Hex()), "recipient": strings.ToLower(receipt.Ticket.Recipient.Hex()),
+		"price_wei": receipt.PriceWei, "ticket_hash": receipt.Ticket.Hash().Hex(), "state": "ACCEPTED",
+	})
+}
