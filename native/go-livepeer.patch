+func (h *checkoutNativeHarness) buyerSign(msg []byte) []byte {
+	h.t.Helper()
+	sig, err := ethcrypto.Sign(accounts.TextHash(msg), h.buyerKey)
+	require.NoError(h.t, err)
+	sig[64] += 27
+	return sig
+}
+
+// buyerPayment builds the exact payment the challenge describes: quoted face,
+// max win probability, quoted price, buyer nonce, and a real signature over
+// the ticket hash. Creation round and block hash come from the synthetic
+// chain the test controls.
+func (h *checkoutNativeHarness) buyerPayment(t *testing.T, oInfo *lpnet.OrchestratorInfo, manifest string, nonce uint32) (payment, segment string) {
+	t.Helper()
+	tp := oInfo.GetTicketParams()
+	price := oInfo.GetPriceInfo()
+	params := &pm.TicketParams{
+		Recipient:         ethcommon.BytesToAddress(tp.GetRecipient()),
+		FaceValue:         new(big.Int).SetBytes(tp.GetFaceValue()),
+		WinProb:           new(big.Int).SetBytes(tp.GetWinProb()),
+		RecipientRandHash: ethcommon.BytesToHash(tp.GetRecipientRandHash()),
+		Seed:              new(big.Int).SetBytes(tp.GetSeed()),
+		ExpirationBlock:   new(big.Int).SetBytes(tp.GetExpirationBlock()),
+		PricePerPixel:     big.NewRat(price.GetPricePerUnit(), price.GetPixelsPerUnit()),
+		ExpirationParams: &pm.TicketExpirationParams{
+			CreationRound:          10,
+			CreationRoundBlockHash: h.blockHash,
+		},
+	}
+	ticket := pm.NewTicket(params, params.ExpirationParams, h.buyer, nonce)
+	sig := h.buyerSign(ticket.Hash().Bytes())
+
+	paymentMsg, err := proto.Marshal(&lpnet.Payment{
+		Sender:       h.buyer.Bytes(),
+		TicketParams: tp,
+		ExpirationParams: &lpnet.TicketExpirationParams{
+			CreationRound:          10,
+			CreationRoundBlockHash: h.blockHash[:],
+		},
+		TicketSenderParams: []*lpnet.TicketSenderParams{{SenderNonce: nonce, Sig: sig}},
+		ExpectedPrice:      price,
+	})
+	require.NoError(t, err)
+
+	md := &core.SegTranscodingMetadata{
+		ManifestID: core.ManifestID(manifest),
+		Caps:       core.NewCapabilities(nil, nil),
+		AuthToken:  oInfo.GetAuthToken(),
+	}
+	segSig := h.buyerSign(ethcrypto.Keccak256(md.Flatten()))
+	segData, err := core.NetSegData(md)
+	require.NoError(t, err)
+	segData.Sig = segSig
+	segMsg, err := proto.Marshal(segData)
+	require.NoError(t, err)
+	return base64.StdEncoding.EncodeToString(paymentMsg), base64.StdEncoding.EncodeToString(segMsg)
+}
+
+func (h *checkoutNativeHarness) challenge(t *testing.T, intent string) (string, *lpnet.OrchestratorInfo) {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodPost, "/apps/runner-1/app/charge", nil)
+	req.Header.Set(liveRunnerSenderHeader, h.buyer.Hex())
+	req.Header.Set(fixedRunnerQuoteHeader, "purchase")
+	req.Header.Set(purchaseIntentHeader, intent)
+	w := httptest.NewRecorder()
+	h.lp.ServeHTTP(w, req)
+	require.Equal(t, http.StatusPaymentRequired, w.Code, w.Body.String())
+	challenge, oInfo := decodeLiveRunnerPaymentChallenge(t, w.Body.Bytes())
+	return challenge.ManifestID, oInfo
+}
+
+func (h *checkoutNativeHarness) paidAppRequest(t *testing.T, manifest, intent, payment, segment string, mutate map[string]string) *http.Request {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodPost, "/apps/runner-1/app/charge", strings.NewReader(`{"order":"ord-1"}`))
+	req.Header.Set(paymentHeader, payment)
+	req.Header.Set(segmentHeader, segment)
+	req.Header.Set(fixedRunnerQuoteHeader, "purchase")
+	if intent != "" {
+		req.Header.Set(purchaseIntentHeader, intent)
+	}
+	for k, v := range mutate {
+		req.Header.Set(k, v)
+	}
+	return req
+}
+
+func checkoutTestApp(t *testing.T, h *checkoutNativeHarness) *httptest.Server {
+	t.Helper()
+	h.rec = &checkoutAppRecorder{}
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		h.rec.calls++
+		h.rec.headers = r.Header.Clone()
+		query := url.Values{"intent": {r.Header.Get("Livepeer-Paid-Intent")}, "payer": {r.Header.Get("Livepeer-Paid-Payer")}}
+		read := httptest.NewRequest(http.MethodGet, "/runner/runner-1/session/"+r.Header.Get("Livepeer-Session-Id")+"/purchase?"+query.Encode(), nil)
+		read.Header.Set("Livepeer-Session-Token", r.Header.Get("Livepeer-Session-Token"))
+		response := httptest.NewRecorder()
+		h.lp.ServeHTTP(response, read)
+		h.rec.receiptStatus = response.Code
+		_ = json.Unmarshal(response.Body.Bytes(), &h.rec.receipt)
+		_, _ = w.Write([]byte("granted"))
+	}))
+}
+
+func TestFixedPurchaseCoreIntegrationWrongSignature(t *testing.T) {
+	h := newCheckoutNativeHarness(t)
+	upstream := checkoutTestApp(t, h)
+	defer upstream.Close()
+	h.registerRunner(t, upstream.URL)
+	intent := strings.Repeat("c0", 32)
+	manifest, oInfo := h.challenge(t, intent)
+
+	paymentB64, segment := h.buyerPayment(t, oInfo, manifest, 7)
+	raw, err := base64.StdEncoding.DecodeString(paymentB64)
+	require.NoError(t, err)
+	var paymentMsg lpnet.Payment
+	require.NoError(t, proto.Unmarshal(raw, &paymentMsg))
+	paymentMsg.TicketSenderParams[0].Sig[0] ^= 1
+	rebased, err := proto.Marshal(&paymentMsg)
+	require.NoError(t, err)
+
+	resp := httptest.NewRecorder()
+	h.lp.ServeHTTP(resp, h.paidAppRequest(t, manifest, intent, base64.StdEncoding.EncodeToString(rebased), segment, nil))
+	require.Equal(t, http.StatusBadRequest, resp.Code, resp.Body.String())
+
+	// Wrong actual ticket signature: no receipt, no queue, no proxy.
+	absent, err := h.dbh.FixedPurchaseReceiptByIntent(h.buyer, intent)
+	require.NoError(t, err)
+	require.Nil(t, absent)
+	require.Equal(t, 0, h.queuedCount())
+	require.Zero(t, h.rec.calls)
+}
+
+func TestFixedPurchaseCoreIntegrationSuccess(t *testing.T) {
+	h := newCheckoutNativeHarness(t)
+	upstream := checkoutTestApp(t, h)
+	defer upstream.Close()
+	h.registerRunner(t, upstream.URL)
+	intent := strings.Repeat("d0", 32)
+	manifest, oInfo := h.challenge(t, intent)
+	priceWei := oInfo.GetPriceInfo().GetPricePerUnit()
+
+	payment, segment := h.buyerPayment(t, oInfo, manifest, 7)
+	resp := httptest.NewRecorder()
+	h.lp.ServeHTTP(resp, h.paidAppRequest(t, manifest, intent, payment, segment, nil))
+	require.Equal(t, http.StatusOK, resp.Code, resp.Body.String())
+	require.Equal(t, 1, h.rec.calls)
+
+	// Proxy carries receipt provenance, never caller claims.
+	require.Equal(t, intent, h.rec.headers.Get("Livepeer-Paid-Intent"))
+	require.Equal(t, h.buyer.Hex(), h.rec.headers.Get("Livepeer-Paid-Payer"))
+	require.Equal(t, h.orchAddr.Hex(), h.rec.headers.Get("Livepeer-Paid-Recipient"))
+	require.Equal(t, strconv.FormatInt(priceWei, 10), h.rec.headers.Get("Livepeer-Paid-Amount-Wei"))
+	require.Equal(t, http.StatusOK, h.rec.receiptStatus)
+	require.Equal(t, intent, h.rec.receipt["intent"])
+	require.Equal(t, strings.ToLower(h.buyer.Hex()), h.rec.receipt["payer"])
+	require.Equal(t, strconv.FormatInt(priceWei, 10), h.rec.receipt["price_wei"])
+
+	// One durable receipt in real SQLite.
+	receipt, err := h.dbh.FixedPurchaseReceiptByIntent(h.buyer, intent)
+	require.NoError(t, err)
+	require.NotNil(t, receipt)
+	require.Equal(t, intent, receipt.Intent)
+	require.Equal(t, receipt.Ticket.Hash().Hex(), h.rec.receipt["ticket_hash"])
+	require.Equal(t, "runner-1", receipt.RunnerID)
+	require.Equal(t, manifest, receipt.ManifestID)
+	require.Equal(t, h.buyer, receipt.Ticket.Sender)
+	require.Equal(t, h.orchAddr, receipt.Ticket.Recipient)
+	require.False(t, receipt.AcceptedAt.IsZero())
+
+	// The existing queue received the same signed ticket for delivery.
+	require.Equal(t, 1, h.queuedCount())
+	queued := h.queuedTicket()
+	require.NotNil(t, queued)
+	require.Equal(t, receipt.Ticket.Hash(), queued.Hash())
+	require.Equal(t, receipt.Ticket.Sig, queued.Sig)
+	require.NotNil(t, queued.RecipientRand)
+}
+
+func TestFixedPurchaseCoreIntegrationRetryAfterExpiry(t *testing.T) {
+	h := newCheckoutNativeHarness(t)
+	upstream := checkoutTestApp(t, h)
+	defer upstream.Close()
+	h.registerRunner(t, upstream.URL)
+	intent := strings.Repeat("e0", 32)
+	manifest, oInfo := h.challenge(t, intent)
+
+	payment, segment := h.buyerPayment(t, oInfo, manifest, 7)
+	first := httptest.NewRecorder()
+	h.lp.ServeHTTP(first, h.paidAppRequest(t, manifest, intent, payment, segment, nil))
+	require.Equal(t, http.StatusOK, first.Code, first.Body.String())
+	require.Equal(t, 1, h.rec.calls)
+	before, err := h.dbh.FixedPurchaseReceiptByIntent(h.buyer, intent)
+	require.NoError(t, err)
+	require.NotNil(t, before)
+
+	// Expire the real segment auth and evict the quote. Recover the same ticket
+	// through core and the durable queue without another payment.
+	h.lp.fixedRunnerQuotesMu.Lock()
+	delete(h.lp.fixedRunnerQuotes, manifest)
+	h.lp.fixedRunnerQuotesMu.Unlock()
+
+	raw, err := base64.StdEncoding.DecodeString(segment)
+	require.NoError(t, err)
+	var expired lpnet.SegData
+	require.NoError(t, proto.Unmarshal(raw, &expired))
+	expired.AuthToken.Expiration = 1
+	raw, err = proto.Marshal(&expired)
+	require.NoError(t, err)
+	segment = base64.StdEncoding.EncodeToString(raw)
+	retry := httptest.NewRecorder()
+	h.lp.ServeHTTP(retry, h.paidAppRequest(t, manifest, intent, payment, segment, nil))
+	require.Equal(t, http.StatusOK, retry.Code, retry.Body.String())
+
+	after, err := h.dbh.FixedPurchaseReceiptByIntent(h.buyer, intent)
+	require.NoError(t, err)
+	require.NotNil(t, after)
+	require.Equal(t, before.Ticket.Hash(), after.Ticket.Hash())
+	require.Equal(t, before.AcceptedAt.Unix(), after.AcceptedAt.Unix())
+	require.Equal(t, 2, h.rec.calls)
+	require.Equal(t, 1, h.queuedCount())
+}
+
+func (h *checkoutNativeHarness) queuedCount() int {
+	n, err := h.dbh.WinningTicketCount(h.buyer, 0)
+	require.NoError(h.t, err)
+	return n
+}
+func (h *checkoutNativeHarness) queuedTicket() *pm.SignedTicket {
+	ticket, err := h.dbh.SelectEarliestWinningTicket(h.buyer, 0)
+	require.NoError(h.t, err)
+	return ticket
+}
