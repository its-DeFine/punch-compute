+func TestLiveRunnerRegistry_ReserveCoveredSessionWithAcceptedQuote(t *testing.T) {
+	payer := "0x" + strings.Repeat("ab", 20)
+	accepted := LiveRunnerPriceInfo{Price: json.Number("3"), Currency: "wei", Unit: "fixed"}
+	var received []sessionAdmissionRequest
+	callback := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body sessionAdmissionRequest
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			http.Error(w, "bad callback body", http.StatusBadRequest)
+			return
+		}
+		received = append(received, body)
+		// The application grant only covers the previously accepted fixed price.
+		authorized := body.RunnerID == "covered-quote" && body.PayerAddress == payer &&
+			string(body.Quote.Price) == "3" && body.Quote.Currency == "wei" && body.Quote.Unit == "fixed"
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(sessionAdmissionResponse{Authorized: authorized})
+	}))
+	defer callback.Close()
+
+	registry := newOnchainLiveRunnerTestRegistry()
+	req := liveRunnerTestHeartbeat("covered-quote")
+	req.Mode = LiveRunnerModePersistent
+	req.RunnerURL = callback.URL
+	req.Capacity = 4
+	req.PriceInfo = LiveRunnerPriceInfo{Price: json.Number("9"), Currency: "wei", Unit: "fixed"}
+	req.SessionAdmissionPath = "/session-admission"
+	liveRunnerTestRegister(t, registry, req)
+
+	usedCapacity := func() int {
+		t.Helper()
+		runners := registry.Runners()
+		if len(runners) != 1 {
+			t.Fatalf("expected one covered runner, got %+v", runners)
+		}
+		return runners[0].CapacityUsed
+	}
+
+	// The accepted quote is honored even though the current registry price moved to 9.
+	sessionID, _, err := registry.ReserveCoveredSessionWithQuote(
+		context.Background(), "covered-quote", payer, strings.Repeat("ab", 24), accepted)
+	if err != nil {
+		t.Fatalf("ReserveCoveredSessionWithQuote: %v", err)
+	}
+	if len(received) != 1 || string(received[0].Quote.Price) != "3" {
+		t.Fatalf("callback did not receive the accepted quote: %+v", received)
+	}
+	snapshot, err := registry.SessionPriceInfo("covered-quote", sessionID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(snapshot.Price) != "3" || snapshot.Currency != "wei" || snapshot.Unit != "fixed" {
+		t.Fatalf("session snapshot is not the accepted quote: %+v", snapshot)
+	}
+	if usedCapacity() != 1 {
+		t.Fatalf("expected one allocated session, got %d", usedCapacity())
+	}
+
+	// Legacy path still sends the current registry price, which the grant denies.
+	if _, _, err := registry.ReserveCoveredSession(
+		context.Background(), "covered-quote", payer, strings.Repeat("cd", 24)); !isRunnerErrorStatus(err, http.StatusForbidden) {
+		t.Fatalf("expected admission denied for the drifted current price, got %v", err)
+	}
+	if len(received) != 2 || string(received[1].Quote.Price) != "9" {
+		t.Fatalf("legacy path did not send the current price: %+v", received)
+	}
+	if usedCapacity() != 1 {
+		t.Fatalf("denied legacy reserve allocated capacity")
+	}
+
+	// A tampered quote the grant never accepted allocates nothing.
+	wrong := LiveRunnerPriceInfo{Price: json.Number("5"), Currency: "wei", Unit: "fixed"}
+	if _, _, err := registry.ReserveCoveredSessionWithQuote(
+		context.Background(), "covered-quote", payer, strings.Repeat("ef", 24), wrong); !isRunnerErrorStatus(err, http.StatusForbidden) {
+		t.Fatalf("expected admission denied for the wrong price, got %v", err)
+	}
+	if usedCapacity() != 1 {
+		t.Fatalf("denied wrong-price reserve allocated capacity")
+	}
+
+	// Invalid tokens and non-fixed quotes reject before the callback or capacity.
+	calls := len(received)
+	if _, _, err := registry.ReserveCoveredSessionWithQuote(
+		context.Background(), "covered-quote", payer, "bad-token", accepted); !isRunnerErrorStatus(err, http.StatusForbidden) {
+		t.Fatalf("expected invalid token rejection, got %v", err)
+	}
+	usd := LiveRunnerPriceInfo{Price: json.Number("0.001"), Currency: "usd", Unit: "fixed"}
+	if _, _, err := registry.ReserveCoveredSessionWithQuote(
+		context.Background(), "covered-quote", payer, strings.Repeat("12", 24), usd); !isRunnerErrorStatus(err, http.StatusBadRequest) {
+		t.Fatalf("expected non-fixed quote rejection, got %v", err)
+	}
+	if len(received) != calls {
+		t.Fatalf("unexpected callback traffic for invalid requests: %+v", received)
+	}
+	if usedCapacity() != 1 {
+		t.Fatalf("invalid reserve allocated capacity")
+	}
+}
diff --git a/cmd/livepeer/account_init.go b/cmd/livepeer/account_init.go
new file mode 100644
index 00000000..7291b59e
--- /dev/null
+++ b/cmd/livepeer/account_init.go
@@ -0,0 +1,122 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/ethereum/go-ethereum/accounts"
+	"github.com/ethereum/go-ethereum/accounts/keystore"
+	ethcommon "github.com/ethereum/go-ethereum/common"
+)
+
+// initNodeAccount prepares the node's Ethereum keystore account without any
+// network, signing, export or chain access. The caller (setup state pins the
+// returned address before node startup) emits the address; this function only
+// returns it. The password is read internally and never emitted.
+//
+// selectedAddress empty: reuse the exactly-one existing account, refuse an
+// ambiguous keystore with more than one, and create a single account only
+// when the keystore is empty. selectedAddress set: it must be a strict
+// 0x-prefixed 20-byte hex address already present in the keystore; a missing
+// selection is refused and never replaced by a newly created account.
+// Either way the account is unlock-verified with the password file first.
+func initNodeAccount(keystoreDir, passwordFile, selectedAddress string) (string, error) {
+	if err := ensurePrivateDir(keystoreDir); err != nil {
+		return "", err
+	}
+	passphrase, err := readPrivatePassword(passwordFile)
+	if err != nil {
+		return "", err
+	}
+	// Library-standard encryption; never weaker test/production params.
+	ks := keystore.NewKeyStore(keystoreDir, keystore.StandardScryptN, keystore.StandardScryptP)
+	var acct accounts.Account
+	if selectedAddress != "" {
+		if len(selectedAddress) != 42 || !strings.HasPrefix(selectedAddress, "0x") || !ethcommon.IsHexAddress(selectedAddress) {
+			return "", fmt.Errorf("invalid selected address: must be 0x-prefixed 20-byte hex")
+		}
+		addr := ethcommon.HexToAddress(selectedAddress)
+		if addr == (ethcommon.Address{}) {
+			return "", fmt.Errorf("invalid selected address: zero address")
+		}
+		found := false
+		for _, existing := range ks.Accounts() {
+			if existing.Address == addr {
+				acct, found = existing, true
+				break
+			}
+		}
+		if !found {
+			return "", fmt.Errorf("selected account %s not found in keystore: refusing to create a replacement", addr.Hex())
+		}
+	} else {
+		existing := ks.Accounts()
+		switch len(existing) {
+		case 0:
+			acct, err = ks.NewAccount(passphrase)
+			if err != nil {
+				return "", fmt.Errorf("keystore account creation failed: %w", err)
+			}
+		case 1:
+			acct = existing[0]
+		default:
+			return "", fmt.Errorf("ambiguous keystore: %d accounts present, select one explicitly", len(existing))
+		}
+	}
+	if err := ks.Unlock(acct, passphrase); err != nil {
+		return "", fmt.Errorf("account unlock failed: %w", err)
+	}
+	if err := ks.Lock(acct.Address); err != nil {
+		return "", fmt.Errorf("account lock failed: %w", err)
+	}
+	return acct.Address.Hex(), nil
+}
+
+func ensurePrivateDir(dir string) error {
+	if dir == "" {
+		return fmt.Errorf("keystore directory is required")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return fmt.Errorf("keystore directory unavailable: %w", err)
+	}
+	info, err := os.Lstat(dir)
+	if err != nil {
+		return fmt.Errorf("keystore directory unreadable: %w", err)
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("keystore path must be a directory, not a symlink or file")
+	}
+	if info.Mode().Perm()&0077 != 0 {
+		return fmt.Errorf("keystore directory must not be group/world accessible")
+	}
+	return nil
+}
+
+func readPrivatePassword(path string) (string, error) {
+	if path == "" {
+		return "", fmt.Errorf("password file is required")
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return "", fmt.Errorf("password file unreadable: %w", err)
+	}
+	if !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 {
+		return "", fmt.Errorf("password file must be a private regular file, not a symlink")
+	}
+	if info.Mode().Perm()&0077 != 0 {
+		return "", fmt.Errorf("password file must not be group/world accessible")
+	}
+	if info.Size() == 0 {
+		return "", fmt.Errorf("password file is empty")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return "", fmt.Errorf("password file unreadable: %w", err)
+	}
+	passphrase := strings.TrimSpace(string(raw))
+	if passphrase == "" {
+		return "", fmt.Errorf("password file is empty")
+	}
+	return passphrase, nil
+}
