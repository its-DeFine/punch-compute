+)
+
+// Exercise the actual node unlock path, not just the initializer's own reader.
+func TestInitNodeAccountNativePasswordCompatibility(t *testing.T) {
+	root := t.TempDir()
+	dir := filepath.Join(root, "keystore")
+	pass := writePassFile(t, root, "password", "  synthetic-node-password \n", 0600)
+	addr, err := initNodeAccount(dir, pass, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	node, err := eth.NewAccountManager(ethcommon.HexToAddress(addr), dir, big.NewInt(1), pass)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := node.Unlock(pass); err != nil {
+		t.Fatalf("native node cannot unlock initialized account: %v", err)
+	}
+	defer node.Lock()
+}
+
+const (
+	initTestPass  = "synthetic-init-pass-1"
+	initTestPass2 = "synthetic-init-pass-2"
+	// Fixed synthetic address, never a real key.
+	missingAddress = "0x1111111111111111111111111111111111111111"
+)
+
+func writePassFile(t *testing.T, dir, name, content string, mode os.FileMode) string {
+	t.Helper()
+	path := filepath.Join(dir, name)
+	if err := os.WriteFile(path, []byte(content), mode); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(path, mode); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func keystoreAccountCount(t *testing.T, dir string) int {
+	t.Helper()
+	ks := keystore.NewKeyStore(dir, keystore.StandardScryptN, keystore.StandardScryptP)
+	return len(ks.Accounts())
+}
+
+func TestInitNodeAccountCreateReuseSameAddress(t *testing.T) {
+	root := t.TempDir()
+	dir := filepath.Join(root, "keystore") // absent: init must create it private
+	pass := writePassFile(t, root, "pass", initTestPass+"\n", 0600)
+
+	addr, err := initNodeAccount(dir, pass, "")
+	if err != nil {
+		t.Fatalf("create failed: %v", err)
+	}
+	if !ethcommon.IsHexAddress(addr) || addr != ethcommon.HexToAddress(addr).Hex() {
+		t.Fatalf("not a checksummed address: %q", addr)
+	}
+	if got := keystoreAccountCount(t, dir); got != 1 {
+		t.Fatalf("expected 1 account, have %d", got)
+	}
+
+	reused, err := initNodeAccount(dir, pass, "")
+	if err != nil {
+		t.Fatalf("reuse failed: %v", err)
+	}
+	if reused != addr {
+		t.Fatalf("reuse returned %s, want %s", reused, addr)
+	}
+
+	selected, err := initNodeAccount(dir, pass, strings.ToLower(addr))
+	if err != nil {
+		t.Fatalf("selected reuse failed: %v", err)
+	}
+	if selected != addr {
+		t.Fatalf("selected returned %s, want %s", selected, addr)
+	}
+	if got := keystoreAccountCount(t, dir); got != 1 {
+		t.Fatalf("expected still 1 account, have %d", got)
+	}
+}
+
+func TestInitNodeAccountMissingSelectedRefusesWithNoNewAccount(t *testing.T) {
+	root := t.TempDir()
+	dir := filepath.Join(root, "keystore")
+	pass := writePassFile(t, root, "pass", initTestPass, 0600)
+
+	if _, err := initNodeAccount(dir, pass, missingAddress); err == nil {
+		t.Fatal("missing selected address accepted")
+	} else if !strings.Contains(err.Error(), "not found") {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got := keystoreAccountCount(t, dir); got != 0 {
+		t.Fatalf("refused selection created %d accounts", got)
+	}
+
+	// Same refusal when one unrelated account already exists.
+	existing, err := initNodeAccount(dir, pass, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := initNodeAccount(dir, pass, missingAddress); err == nil {
+		t.Fatal("missing selected address accepted beside existing account")
+	}
+	if got := keystoreAccountCount(t, dir); got != 1 {
+		t.Fatalf("expected still 1 account, have %d", got)
+	}
+	_ = existing
+}
+
+func TestInitNodeAccountAmbiguousRefuses(t *testing.T) {
+	root := t.TempDir()
+	dir := filepath.Join(root, "keystore")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	ks := keystore.NewKeyStore(dir, keystore.StandardScryptN, keystore.StandardScryptP)
+	if _, err := ks.NewAccount(initTestPass); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ks.NewAccount(initTestPass2); err != nil {
+		t.Fatal(err)
+	}
+	pass := writePassFile(t, root, "pass", initTestPass, 0600)
+
+	if _, err := initNodeAccount(dir, pass, ""); err == nil {
+		t.Fatal("ambiguous keystore accepted without selection")
+	} else if !strings.Contains(err.Error(), "ambiguous") {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got := keystoreAccountCount(t, dir); got != 2 {
+		t.Fatalf("expected still 2 accounts, have %d", got)
+	}
+}
+
+func TestInitNodeAccountPrivateFilesRefused(t *testing.T) {
+	root := t.TempDir()
+	good := writePassFile(t, root, "good", initTestPass, 0600)
+
+	cases := map[string]struct {
+		pass string
+		dir  string
+	}{
+		"group-readable password": {pass: writePassFile(t, root, "p0644", initTestPass, 0644), dir: filepath.Join(root, "k1")},
+		"empty password":          {pass: writePassFile(t, root, "pempty", "", 0600), dir: filepath.Join(root, "k2")},
+		"missing password":        {pass: filepath.Join(root, "absent"), dir: filepath.Join(root, "k3")},
+	}
+	symPass := filepath.Join(root, "psym")
+	if err := os.Symlink(good, symPass); err != nil {
+		t.Fatal(err)
+	}
+	cases["symlink password"] = struct {
+		pass string
+		dir  string
+	}{pass: symPass, dir: filepath.Join(root, "k4")}
+
+	looseDir := filepath.Join(root, "loose")
+	if err := os.MkdirAll(looseDir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	cases["group-accessible keystore dir"] = struct {
+		pass string
+		dir  string
+	}{pass: good, dir: looseDir}
+
+	symDir := filepath.Join(root, "ksym")
+	realDir := filepath.Join(root, "kreal")
+	if err := os.MkdirAll(realDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(realDir, symDir); err != nil {
+		t.Fatal(err)
+	}
+	cases["symlink keystore dir"] = struct {
+		pass string
+		dir  string
+	}{pass: good, dir: symDir}
+
+	for name, tc := range cases {
+		if _, err := initNodeAccount(tc.dir, tc.pass, ""); err == nil {
+			t.Errorf("%s: accepted", name)
+		}
+	}
+}
+
+func TestInitNodeAccountWrongPasswordRefused(t *testing.T) {
+	root := t.TempDir()
+	dir := filepath.Join(root, "keystore")
+	passA := writePassFile(t, root, "passA", initTestPass, 0600)
+	passB := writePassFile(t, root, "passB", initTestPass2, 0600)
+
+	addr, err := initNodeAccount(dir, passA, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, err := initNodeAccount(dir, passB, ""); err == nil {
+		t.Fatalf("wrong password accepted for %s", got)
+	} else if !strings.Contains(err.Error(), "unlock") {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got := keystoreAccountCount(t, dir); got != 1 {
+		t.Fatalf("expected still 1 account, have %d", got)
+	}
+	_ = addr
+}
