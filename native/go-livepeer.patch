+	require.NoError(t, err)
+	require.Nil(t, absent)
+	receipt, _, err := orch.AcceptFixedPurchase(context.Background(), *payment, terms)
+	require.NoError(t, err)
+	// Recovery requires neither a functioning recipient nor cached session state.
+	node.Recipient = nil
+	recovered, err := orch.RecoverFixedPurchase(context.Background(), *payment, terms.Intent, terms.RunnerID)
+	require.NoError(t, err)
+	require.Equal(t, receipt.Ticket.Hash(), recovered.Ticket.Hash())
+	view, err := orch.FixedPurchaseForSession(sender, terms.Intent, terms.RunnerID, string(terms.ManifestID))
+	require.NoError(t, err)
+	require.Equal(t, receipt.Ticket.Hash(), view.Ticket.Hash())
+	_, err = orch.FixedPurchaseForSession(sender, terms.Intent, terms.RunnerID, "another-session")
+	require.Error(t, err)
+	_, err = orch.RecoverFixedPurchase(context.Background(), *payment, terms.Intent, "another-runner")
+	require.Error(t, err)
+	payment.TicketSenderParams[0].Sig = []byte("not-the-original-signature")
