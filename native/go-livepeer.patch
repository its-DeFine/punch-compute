+// Clearing the expiring challenge cache after successful payment reproduces the
+// same boundary as quote expiry without sleeping or changing the payment stub.
+type checkoutQuoteExpiryOrchestrator struct {
+	*stubOrchestrator
+	afterPayment func()
+}
+
+func (o *checkoutQuoteExpiryOrchestrator) ProcessPayment(ctx context.Context, payment lpnet.Payment, manifest core.ManifestID) error {
+	if err := o.stubOrchestrator.ProcessPayment(ctx, payment, manifest); err != nil {
+		return err
+	}
+	o.afterPayment()
+	return nil
+}
+
+// AcceptFixedPurchase routes the expiry test through the durable server path
+// while preserving its boundary: the stub still processes the legacy payment
+// (firing the pin-deletion hook), and the returned receipt carries the
+// accepted snapshot the proxy must retain.
+func (o *checkoutQuoteExpiryOrchestrator) AcceptFixedPurchase(ctx context.Context, payment lpnet.Payment, terms core.FixedPurchaseTerms) (*common.FixedPurchaseReceipt, bool, error) {
+	if err := o.ProcessPayment(ctx, payment, core.ManifestID(terms.ManifestID)); err != nil {
+		return nil, false, err
+	}
+	return &common.FixedPurchaseReceipt{
+		Intent:     terms.Intent,
+		RunnerID:   terms.RunnerID,
+		ManifestID: string(terms.ManifestID),
+		PriceWei:   strconv.FormatInt(terms.PriceWei, 10),
+		Ticket: &pm.SignedTicket{
+			Ticket: &pm.Ticket{
+				Sender:    terms.Payer,
+				Recipient: terms.Recipient,
+			},
+			Sig:           []byte("synthetic-expiry-test-sig"),
+			RecipientRand: big.NewInt(11),
+		},
+	}, true, nil
+}
+
