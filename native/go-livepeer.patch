+package server
+
+// Token checkout binding tests: the optional Livepeer-Purchase-Intent header
+// binds a fixed purchase quote to its paid request and gives the proxied app
+// server-verified paid provenance. Uses the existing onchain stub harness with
+// synthetic signatures exactly where existing live-runner tests use them; no
+// chain, funds, or network beyond local httptest servers.
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/livepeer/go-livepeer/ai/runner"
+	"github.com/livepeer/go-livepeer/common"
+	"github.com/livepeer/go-livepeer/core"
+	lpnet "github.com/livepeer/go-livepeer/net"
+	"github.com/livepeer/go-livepeer/pm"
+	"github.com/stretchr/testify/require"
+)
+
+// acceptFixedPurchaseStubOrchestrator exposes the durable acceptance method
+// with the exact core signature. The canned receipt carries synthetic values
+// explicitly labelled as test provenance, never real tickets or funds.
+type acceptFixedPurchaseStubOrchestrator struct {
+	*stubOrchestrator
+	acceptCalls int
+	gotTerms    core.FixedPurchaseTerms
+	accept      func(ctx context.Context, payment lpnet.Payment, terms core.FixedPurchaseTerms) (*common.FixedPurchaseReceipt, bool, error)
+}
+
+func (o *acceptFixedPurchaseStubOrchestrator) AcceptFixedPurchase(ctx context.Context, payment lpnet.Payment, terms core.FixedPurchaseTerms) (*common.FixedPurchaseReceipt, bool, error) {
+	o.acceptCalls++
+	o.gotTerms = terms
+	return o.accept(ctx, payment, terms)
+}
+
+func purchaseIntentFor(t *testing.T, orderID string) string {
+	t.Helper()
+	sum := sha256.Sum256([]byte(orderID))
+	return hex.EncodeToString(sum[:])
+}
+
+func registerFixedSingleShotRunner(t *testing.T, lp *lphttp, runnerID, appURL string) {
+	t.Helper()
+	registerLiveRunnerForSession(t, lp, &liveRunnerRegistrationOptions{
+		RunnerID:  runnerID,
+		RunnerURL: appURL,
+		Mode:      runner.LiveRunnerModeSingleShot,
+		PriceInfo: &runner.LiveRunnerPriceInfo{Price: json.Number("0.001"), Unit: "fixed"},
+	})
+}
+
+func requestFixedPurchaseChallenge(t *testing.T, lp *lphttp, orch *stubOrchestrator, runnerID, intent string, purchase bool) *httptest.ResponseRecorder {
+	t.Helper()
+	path := "/apps/" + runnerID + "/session"
+	mode, err := lp.node.LiveRunnerManager.(*runner.LiveRunnerRegistry).RunnerMode(runnerID)
+	require.NoError(t, err)
+	if mode == runner.LiveRunnerModeSingleShot {
+		path = "/apps/" + runnerID + "/app/charge"
+	}
+	req := httptest.NewRequest(http.MethodPost, path, nil)
+	setRequestHeaders(req, liveRunnerSenderHeaders(orch))
+	if purchase {
+		req.Header.Set("Livepeer-Fixed-Quote", "purchase")
+	}
+	if intent != "" {
+		req.Header.Set("Livepeer-Purchase-Intent", intent)
+	}
+	w := httptest.NewRecorder()
+	lp.ServeHTTP(w, req)
+	return w
+}
+
+func paidSingleShotRequest(t *testing.T, orch *stubOrchestrator, oInfo *lpnet.OrchestratorInfo, manifestID, runnerID, intent string, extra map[string]string) *http.Request {
+	t.Helper()
+	headers := liveRunnerReservationPaymentHeadersWithPrice(t, orch, oInfo.GetAuthToken(), manifestID, oInfo.GetPriceInfo())
+	req := httptest.NewRequest(http.MethodPost, "/apps/"+runnerID+"/app/charge", strings.NewReader(`{"order":"ord-1"}`))
+	setRequestHeaders(req, headers)
+	req.Header.Set("Livepeer-Fixed-Quote", "purchase")
+	if intent != "" {
+		req.Header.Set("Livepeer-Purchase-Intent", intent)
+	}
+	for k, v := range extra {
+		req.Header.Set(k, v)
+	}
+	return req
+}
+
+func TestPurchaseIntentChallengeValidation(t *testing.T) {
+	lp := newLiveRunnerHTTPOnchain(t)
+	orch := lp.orchestrator.(*stubOrchestrator)
+	registerLiveRunnerForSession(t, lp, &liveRunnerRegistrationOptions{
+		PriceInfo: &runner.LiveRunnerPriceInfo{Price: json.Number("0.001"), Unit: "fixed"},
+	})
+	intent := purchaseIntentFor(t, "ord-intent-1")
+
+	// Valid intent on the fixed purchase quote: 402 with echo, pinned with
+	// the intent and the native quote recipient from the actual challenge.
+	w := requestFixedPurchaseChallenge(t, lp, orch, "runner-1", intent, true)
+	require.Equal(t, http.StatusPaymentRequired, w.Code, w.Body.String())
+	require.Equal(t, intent, w.Header().Get("Livepeer-Purchase-Intent"))
+	_, oInfo := decodeLiveRunnerPaymentChallenge(t, w.Body.Bytes())
+	require.Positive(t, oInfo.GetPriceInfo().GetPricePerUnit())
+
+	// Legacy purchase challenge without intent: 402 with no echo, empty pin.
+	legacy := requestFixedPurchaseChallenge(t, lp, orch, "runner-1", "", true)
+	require.Equal(t, http.StatusPaymentRequired, legacy.Code, legacy.Body.String())
+	require.Empty(t, legacy.Header().Get("Livepeer-Purchase-Intent"))
+
+	// Malformed intent on the purchase quote is rejected, not pinned.
+	for _, bad := range []string{"not-hex", strings.ToUpper(intent), intent[:63]} {
+		badResp := requestFixedPurchaseChallenge(t, lp, orch, "runner-1", bad, true)
+		require.Equal(t, http.StatusBadRequest, badResp.Code, badResp.Body.String())
+	}
+
+	// A valid intent outside the fixed purchase quote is rejected.
+	offPath := requestFixedPurchaseChallenge(t, lp, orch, "runner-1", intent, false)
+	require.Equal(t, http.StatusBadRequest, offPath.Code, offPath.Body.String())
+}
+
+func TestIntentBoundPaidRequestRejectsMismatch(t *testing.T) {
+	for _, kind := range []string{"missing", "changed", "malformed", "unpinned"} {
+		t.Run(kind, func(t *testing.T) {
+			lp := newLiveRunnerHTTPOnchain(t)
+			orch := lp.orchestrator.(*stubOrchestrator)
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusOK) }))
+			defer upstream.Close()
+			registerFixedSingleShotRunner(t, lp, "runner-1", upstream.URL)
+			intent := purchaseIntentFor(t, "ord-intent-"+kind)
+
+			challengeIntent := intent
+			if kind == "unpinned" {
+				challengeIntent = ""
+			}
+			w := requestFixedPurchaseChallenge(t, lp, orch, "runner-1", challengeIntent, true)
+			require.Equal(t, http.StatusPaymentRequired, w.Code, w.Body.String())
+			challenge, oInfo := decodeLiveRunnerPaymentChallenge(t, w.Body.Bytes())
+
+			// Arm the stub ledger so any ProcessPayment would be visible.
+			// Rejection must happen before reservation/payment: no balance,
+			// no session.
+			orch.balances = make(map[ethcommon.Address]map[core.ManifestID]*big.Rat)
+			orch.paymentCredit = big.NewRat(oInfo.GetPriceInfo().GetPricePerUnit(), 1)
+
+			reqIntent := intent
+			switch kind {
+			case "missing":
+				reqIntent = ""
+			case "changed":
+				reqIntent = purchaseIntentFor(t, "ord-other")
+			case "malformed":
+				reqIntent = "short"
+			case "unpinned":
+				// Legacy pin carries no intent; presenting one fails closed.
+				reqIntent = intent
+			}
+			req := paidSingleShotRequest(t, orch, oInfo, challenge.ManifestID, "runner-1", reqIntent, nil)
+			resp := httptest.NewRecorder()
+			lp.ServeHTTP(resp, req)
+			require.Equal(t, http.StatusForbidden, resp.Code, resp.Body.String())
+			require.Contains(t, resp.Body.String(), "purchase intent")
+			require.Empty(t, orch.balances)
+			_, err := lp.node.LiveRunnerManager.(*runner.LiveRunnerRegistry).RunnerEndpointForSession("runner-1", challenge.ManifestID)
+			require.Error(t, err)
+		})
+	}
+}
