+package eth
+
+import (
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/ethereum/go-ethereum/accounts/keystore"
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAccountManagerCreateFromPasswordFile(t *testing.T) {
+	root := t.TempDir()
+	passwordFile := filepath.Join(root, "password")
+	require.NoError(t, os.WriteFile(passwordFile, []byte("synthetic-only-passphrase\n"), 0600))
+	dir := filepath.Join(root, "keystore")
+	manager, err := NewAccountManager(ethcommon.Address{}, dir, big.NewInt(1), passwordFile)
+	require.NoError(t, err)
+	require.NoError(t, manager.Unlock(passwordFile))
+	original := manager.Account().Address
+	require.NoError(t, manager.Lock())
+	reopened, err := NewAccountManager(original, dir, big.NewInt(1), passwordFile)
+	require.NoError(t, err)
+	require.NoError(t, reopened.Unlock(passwordFile))
+	require.Equal(t, original, reopened.Account().Address)
+	require.NoError(t, reopened.Lock())
+	ks := keystore.NewKeyStore(dir, keystore.StandardScryptN, keystore.StandardScryptP)
+	require.Len(t, ks.Accounts(), 1)
+}
