+func TestLiveRunnerFixedPurchaseQuoteRejectsChangedBinding(t *testing.T) {
+	for _, kind := range []string{"amount", "runner", "payer", "missing", "expired", "missing-header"} {
+		t.Run(kind, func(t *testing.T) {
+			lp := newLiveRunnerHTTPOnchain(t)
+			registerLiveRunnerForSession(t, lp, &liveRunnerRegistrationOptions{
+				PriceInfo: &runner.LiveRunnerPriceInfo{Price: json.Number("0.001"), Unit: "fixed"},
+			})
+			orch := lp.orchestrator.(*stubOrchestrator)
+			quoteRequest := httptest.NewRequest(http.MethodPost, "/apps/runner-1/session", nil)
+			setRequestHeaders(quoteRequest, liveRunnerSenderHeaders(orch))
+			if kind == "payer" {
+				quoteRequest.Header.Set(liveRunnerSenderHeader, "0x0000000000000000000000000000000000000001")
+			}
+			quoteRequest.Header.Set("Livepeer-Fixed-Quote", "purchase")
+			quoteResponse := httptest.NewRecorder()
+			lp.ServeHTTP(quoteResponse, quoteRequest)
+			require.Equal(t, http.StatusPaymentRequired, quoteResponse.Code, quoteResponse.Body.String())
+			challenge, oInfo := decodeLiveRunnerPaymentChallenge(t, quoteResponse.Body.Bytes())
+			require.LessOrEqual(t, oInfo.GetAuthToken().GetExpiration(), time.Now().Add(5*time.Minute).Unix())
+			price := proto.Clone(oInfo.GetPriceInfo()).(*lpnet.PriceInfo)
+			wanted := http.StatusForbidden
+			target := "runner-1"
+			switch kind {
+			case "amount":
+				price.PricePerUnit--
+				wanted = http.StatusBadRequest
+			case "runner":
+				target = "runner-2"
+				registerLiveRunnerForSession(t, lp, &liveRunnerRegistrationOptions{
+					RunnerID:  target,
+					PriceInfo: &runner.LiveRunnerPriceInfo{Price: json.Number("0.001"), Unit: "fixed"},
+				})
+			case "missing", "missing-header":
+				delete(lp.fixedRunnerQuotes, challenge.ManifestID)
+			case "expired":
+				quote := lp.fixedRunnerQuotes[challenge.ManifestID]
+				quote.expiresAt = time.Now().Unix() - 1
+				lp.fixedRunnerQuotes[challenge.ManifestID] = quote
+			}
+			headers := liveRunnerReservationPaymentHeadersWithPrice(t, orch, oInfo.GetAuthToken(), challenge.ManifestID, price)
+			req := httptest.NewRequest(http.MethodPost, "/apps/"+target+"/session", nil)
+			setRequestHeaders(req, headers)
+			if kind != "missing-header" {
+				req.Header.Set("Livepeer-Fixed-Quote", "purchase")
+			}
+			response := httptest.NewRecorder()
+			lp.ServeHTTP(response, req)
+			require.Equal(t, wanted, response.Code, response.Body.String())
+			_, err := lp.node.LiveRunnerManager.(*runner.LiveRunnerRegistry).RunnerEndpointForSession(target, challenge.ManifestID)
+			require.Error(t, err)
+		})
+	}
+}
