+	require.Equal(t, 1, wrapper.acceptCalls)
+
+	// A durable error grants nothing: no app call, no session, no ledger trace.
+	require.Equal(t, 0, appCalls)
+	require.Empty(t, orch.balances)
+	_, err := lp.node.LiveRunnerManager.(*runner.LiveRunnerRegistry).RunnerEndpointForSession("runner-1", challenge.ManifestID)
+	require.Error(t, err)
+}
