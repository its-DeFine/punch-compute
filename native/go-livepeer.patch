+func (r *fixedPurchaseDeliveryRecipient) QueueFixedPurchase(ticket *pm.SignedTicket) error {
+	if r.fail {
+		return context.DeadlineExceeded
+	}
+	r.delivered = append(r.delivered, ticket)
+	return nil
+}
