+// Real native signature and recipient validation; chain/sender availability is
+// synthetic. The ephemeral test key has no wallet or funded endpoint.
+func fixedPurchaseFixture(t *testing.T) (Recipient, *Ticket, []byte, *big.Int) {
+	t.Helper()
+	_, broker, _, gas, monitor, clock, cfg, _ := newRecipientFixtureOrFatal(t)
+	key, err := crypto.GenerateKey()
+	require.NoError(t, err)
+	signer := guaranteedTicketTestSigner{key: key}
+	r, err := NewRecipient(RandAddress(), broker, NewValidator(&DefaultSigVerifier{}, clock), gas, monitor, clock, cfg)
+	require.NoError(t, err)
+	params, err := r.(FixedPriceRecipient).TicketParamsForFixedPrice(signer.Account().Address, big.NewRat(5000000, 1))
+	require.NoError(t, err)
+	ticket := newTicket(signer.Account().Address, params, 1)
+	sig, err := signer.Sign(ticket.Hash().Bytes())
+	require.NoError(t, err)
+	return r, ticket, sig, params.Seed
+}
+
+func TestFixedPurchaseCommitBeforeNonce(t *testing.T) {
+	r, ticket, sig, seed := fixedPurchaseFixture(t)
+	acceptor := r.(FixedPurchaseAcceptor)
+	calls := 0
+	err := acceptor.AcceptFixedPurchase(ticket, sig, seed, func(saved *SignedTicket) error {
+		calls++
+		require.Equal(t, ticket.Hash(), saved.Hash())
+		require.Equal(t, sig, saved.Sig)
+		require.NoError(t, r.(*recipient).val.ValidateTicket(ticket.Recipient, saved.Ticket, saved.Sig, saved.RecipientRand))
+		return io.ErrClosedPipe
+	})
+	require.ErrorIs(t, err, io.ErrClosedPipe)
+	require.Empty(t, r.(*recipient).senderNonces)
+	require.NoError(t, acceptor.AcceptFixedPurchase(ticket, sig, seed, func(saved *SignedTicket) error { calls++; return nil }))
+	require.Error(t, acceptor.AcceptFixedPurchase(ticket, sig, seed, func(saved *SignedTicket) error { calls++; return nil }))
+	require.Equal(t, 2, calls)
+	_, _, err = r.ReceiveTicket(ticket, sig, seed)
+	require.Error(t, err, "legacy admission must not reuse a committed nonce")
+}
+
+func TestFixedPurchaseInvalidNeverPersists(t *testing.T) {
+	for _, kind := range []string{"signature", "expiry", "probability", "nil callback"} {
+		t.Run(kind, func(t *testing.T) {
+			r, ticket, sig, seed := fixedPurchaseFixture(t)
+			calls := 0
+			persist := func(*SignedTicket) error { calls++; return nil }
+			switch kind {
+			case "signature":
+				sig[0] ^= 1
+			case "expiry":
+				r.(*recipient).tm.(*stubTimeManager).lastSeenBlock = new(big.Int).Set(ticket.ParamsExpirationBlock)
+			case "probability":
+				ticket.WinProb = big.NewInt(1)
+			case "nil callback":
+				persist = nil
+			}
+			require.Error(t, r.(FixedPurchaseAcceptor).AcceptFixedPurchase(ticket, sig, seed, persist))
+			require.Zero(t, calls)
+			require.Empty(t, r.(*recipient).senderNonces)
+		})
+	}
+}
+
+func TestFixedPurchaseConcurrentCommitOnce(t *testing.T) {
+	r, ticket, sig, seed := fixedPurchaseFixture(t)
+	var committed, accepted atomic.Int32
+	var wg sync.WaitGroup
