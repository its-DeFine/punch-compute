+	intent := purchaseIntentFor(t, "ord-expiring-quote")
+	challengeResponse := requestFixedPurchaseChallenge(t, lp, orch, "runner-1", intent, true)
+	require.Equal(t, http.StatusPaymentRequired, challengeResponse.Code, challengeResponse.Body.String())
+	challenge, info := decodeLiveRunnerPaymentChallenge(t, challengeResponse.Body.Bytes())
+	orch.balances = make(map[ethcommon.Address]map[core.ManifestID]*big.Rat)
+	orch.paymentCredit = big.NewRat(info.GetPriceInfo().GetPricePerUnit(), 1)
+	lp.orchestrator = &checkoutQuoteExpiryOrchestrator{stubOrchestrator: orch, afterPayment: func() {
+		lp.fixedRunnerQuotesMu.Lock()
