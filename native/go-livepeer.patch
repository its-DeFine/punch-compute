+func TestLiveRunnerCoveredSessionWithAcceptedQuoteHeader(t *testing.T) {
+	lp := newLiveRunnerHTTPOnchain(t)
+	orch := lp.orchestrator.(*stubOrchestrator)
+	payer := orch.Address().Hex()
+	manager := lp.node.LiveRunnerManager.(*runner.LiveRunnerRegistry)
+	var callbackPrices []string
+	callback := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Token        string                     `json:"token"`
+			RunnerID     string                     `json:"runnerId"`
+			PayerAddress string                     `json:"payerAddress"`
+			Quote        runner.LiveRunnerPriceInfo `json:"quote"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			http.Error(w, "bad callback body", http.StatusBadRequest)
+			return
+		}
+		callbackPrices = append(callbackPrices, string(body.Quote.Price))
+		// The application grant only covers the previously accepted fixed price.
+		authorized := body.RunnerID == "covered-quote" && body.PayerAddress == payer &&
+			string(body.Quote.Price) == "3"
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]bool{"authorized": authorized})
+	}))
+	defer callback.Close()
+
+	registration, err := manager.Heartbeat(runner.LiveRunnerHeartbeatRequest{
+		RunnerID:             "covered-quote",
+		RunnerURL:            callback.URL + "/native",
+		Status:               "ready",
+		Mode:                 runner.LiveRunnerModePersistent,
+		App:                  "live-video-to-video/scope",
+		Capacity:             4,
+		PriceInfo:            runner.LiveRunnerPriceInfo{Price: "9", Currency: "wei", Unit: "fixed"},
+		SessionAdmissionPath: "/session-admission",
+	}, orch.RegistrationSecret())
+	require.NoError(t, err)
+
+	capacityUsed := func() int {
+		runners := manager.Runners()
+		require.Len(t, runners, 1)
+		return runners[0].CapacityUsed
+	}
+	request := func(token, price string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/apps/"+registration.RunnerID+"/session", nil)
+		req.Header.Set(liveRunnerSenderHeader, payer)
+		if token != "" {
+			req.Header.Set(runner.LiveRunnerSessionAdmissionHeader, token)
+		}
+		if price != "" {
+			req.Header.Set(sessionPriceHeader, price)
+		}
+		lp.ServeHTTP(w, req)
+		return w
+	}
+	acceptedHeader := `{"price":"3","currency":"wei","unit":"fixed"}`
+
+	// The accepted quote is honored even though the current registry price is 9.
+	first := request(strings.Repeat("ab", 24), acceptedHeader)
+	require.Equal(t, http.StatusOK, first.Code, first.Body.String())
+	require.Equal(t, []string{"3"}, callbackPrices)
+	var session struct {
+		SessionID string `json:"session_id"`
+	}
+	require.NoError(t, json.Unmarshal(first.Body.Bytes(), &session))
+	require.NotEmpty(t, session.SessionID)
+	snapshot, err := manager.SessionPriceInfo(registration.RunnerID, session.SessionID)
+	require.NoError(t, err)
+	require.Equal(t, "3", string(snapshot.Price))
+	require.Equal(t, "wei", snapshot.Currency)
+	require.Equal(t, "fixed", snapshot.Unit)
+	require.Equal(t, 1, capacityUsed())
+
+	// Header-absent legacy requests still take the current price, which the grant denies.
+	legacy := request(strings.Repeat("cd", 24), "")
+	require.Equal(t, http.StatusForbidden, legacy.Code)
+	require.Equal(t, []string{"3", "9"}, callbackPrices)
+	require.Equal(t, 1, capacityUsed())
+
+	// A tampered quote the grant never accepted allocates nothing.
+	wrong := request(strings.Repeat("ef", 24), `{"price":"5","currency":"wei","unit":"fixed"}`)
+	require.Equal(t, http.StatusForbidden, wrong.Code)
+	require.Equal(t, 1, capacityUsed())
+
+	// Malformed quotes and invalid tokens reject before capacity allocation.
+	calls := len(callbackPrices)
+	malformed := request(strings.Repeat("12", 24), "not-json")
+	require.Equal(t, http.StatusBadRequest, malformed.Code)
+	badToken := request("bad-token", acceptedHeader)
+	require.Equal(t, http.StatusForbidden, badToken.Code)
+	require.Equal(t, calls, len(callbackPrices))
+	require.Equal(t, 1, capacityUsed())
+}
