+func newCheckoutNativeHarness(t *testing.T) *checkoutNativeHarness {
+	t.Helper()
+	h := &checkoutNativeHarness{t: t}
+	dbh, dbraw, err := common.TempDB(t)
+	require.NoError(t, err)
+	t.Cleanup(func() { dbh.Close(); dbraw.Close() })
+	h.dbh = dbh
+
+	h.orchAddr = ethcommon.HexToAddress("0x0000000000000000000000000000000000aa01")
+	require.NoError(t, dbh.UpdateOrch(&common.DBOrch{
+		EthereumAddr:      h.orchAddr.Hex(),
+		ActivationRound:   1,
+		DeactivationRound: 999,
+	}))
+	h.blockHash = pm.RandHash()
+
+	node, err := core.NewLivepeerNode(nil, t.TempDir(), dbh)
+	require.NoError(t, err)
+	node.Eth = &eth.StubClient{TranscoderAddress: h.orchAddr}
+	h.secret = "checkout-test-secret"
+	node.OrchSecret = h.secret
+	svcURL, err := url.Parse("http://localhost:1234")
+	require.NoError(t, err)
+	node.SetServiceURI(svcURL)
+
+	tm := &checkoutTestTimeManager{
+		round:     big.NewInt(10),
+		block:     big.NewInt(1000),
+		poolSize:  big.NewInt(1),
+		blockHash: h.blockHash,
+	}
+	funds, ok := new(big.Int).SetString("1000000000000000000000000", 10)
+	require.True(t, ok)
+	smgr := &checkoutTestSenderManager{deposit: funds}
+	monitor := pm.NewSenderMonitor(
+		&pm.LocalSenderMonitorConfig{
+			Claimant:        h.orchAddr,
+			CleanupInterval: time.Minute,
+			TTL:             100,
+			RedeemGas:       1000,
+			SuggestGasPrice: func(context.Context) (*big.Int, error) { return big.NewInt(1), nil },
+			RPCTimeout:      time.Second,
+		},
+		checkoutTestBroker{},
+		smgr,
+		tm,
+		dbh,
+	)
+	t.Cleanup(monitor.Stop)
+	recipient, err := pm.NewRecipient(
+		h.orchAddr,
+		checkoutTestBroker{},
+		pm.NewValidator(&pm.DefaultSigVerifier{}, tm),
+		&checkoutTestGasMonitor{price: big.NewInt(1)},
+		monitor,
+		tm,
+		pm.TicketParamsConfig{EV: big.NewInt(1), RedeemGas: 1000, TxCostMultiplier: 1},
+	)
+	require.NoError(t, err)
+	node.Recipient = recipient
+
+	orch := core.NewOrchestrator(node, &checkoutTestRoundsManager{round: big.NewInt(10)})
+	manager := runner.NewLiveRunnerRegistry(runner.LiveRunnerRegistryConfig{
+		Host:    testLiveRunnerHost{orchestrator: orch},
+		Onchain: true,
+	})
+	t.Cleanup(manager.Stop)
+	node.LiveRunnerManager = manager
+	h.lp = &lphttp{orchestrator: orch, node: node, transRPC: http.NewServeMux()}
+	require.NoError(t, startAIServer(h.lp))
+
+	prevWatcher := core.PriceFeedWatcher
+	core.PriceFeedWatcher = stubPriceFeedWatcher{price: eth.PriceData{Price: big.NewRat(2000, 1)}}
+	t.Cleanup(func() { core.PriceFeedWatcher = prevWatcher })
+
+	h.buyerKey, err = ethcrypto.GenerateKey()
+	require.NoError(t, err)
+	h.buyer = ethcrypto.PubkeyToAddress(h.buyerKey.PublicKey)
+	return h
+}
