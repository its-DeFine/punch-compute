+func TestAcceptFixedPurchaseConcurrentReplay(t *testing.T) {
+	recipient := pm.RandAddress()
+	sender := pm.RandAddress()
+	intent := strings.Repeat("f6", 32)
+	dbh, dbraw := registeredFixedPurchaseDB(t, recipient)
+	defer dbh.Close()
+	defer dbraw.Close()
+
+	acceptor := &fixedPurchaseAcceptorRecipient{MockRecipient: new(pm.MockRecipient)}
+	orch, _ := newFixedPurchaseOrch(t, dbh, acceptor)
+	terms := fixedPurchaseTestTerms(intent, recipient, sender)
+
+	payment := fixedPurchaseTestPayment(sender, recipient, terms.PriceWei, 9)
+	const writers = 16
+	var createdCount atomic.Int64
+	var wg sync.WaitGroup
+	errs := make([]error, writers)
+	hashes := make([]string, writers)
+	for i := 0; i < writers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			receipt, created, err := orch.AcceptFixedPurchase(context.Background(),
+				*payment, terms)
+			if err != nil {
+				errs[i] = err
+				return
+			}
+			if created {
+				createdCount.Add(1)
+			}
+			hashes[i] = receipt.Ticket.Hash().Hex()
+		}(i)
+	}
+	wg.Wait()
+	for _, err := range errs {
+		require.NoError(t, err)
+	}
+	require.Equal(t, int64(1), createdCount.Load())
+	for _, h := range hashes {
+		require.Equal(t, hashes[0], h)
+	}
+}
