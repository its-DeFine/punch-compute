+++ b/common/ticket_queue_replay_test.go
@@ -0,0 +1,34 @@
+package common
+
+import (
+	"testing"
+
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/livepeer/go-livepeer/pm"
+	"github.com/stretchr/testify/require"
+)
+
+func TestWinningTicketQueueExactReplayPreservesHistory(t *testing.T) {
+	db, raw, err := TempDB(t)
+	require.NoError(t, err)
+	defer db.Close()
+	defer raw.Close()
+	_, ticket, sig, random := defaultWinningTicket(t)
+	signed := &pm.SignedTicket{Ticket: ticket, Sig: sig, RecipientRand: random}
+	require.NoError(t, db.StoreWinningTicket(signed))
+	require.NoError(t, db.StoreWinningTicket(signed), "lost acknowledgement must not reject the same ticket")
+	var count int
+	require.NoError(t, raw.QueryRow("SELECT count(*) FROM ticketQueue").Scan(&count))
+	require.Equal(t, 1, count)
+	tx := ethcommon.HexToHash("0x1234")
+	require.NoError(t, db.MarkWinningTicketRedeemed(signed, tx))
+	require.NoError(t, db.StoreWinningTicket(signed))
+	var kept string
+	require.NoError(t, raw.QueryRow("SELECT txHash FROM ticketQueue WHERE sig=?", sig).Scan(&kept))
+	require.Equal(t, tx.Hex(), kept)
+	changed := *ticket
+	changed.SenderNonce++
+	require.Error(t, db.StoreWinningTicket(&pm.SignedTicket{Ticket: &changed, Sig: sig, RecipientRand: random}))
+	require.NoError(t, raw.QueryRow("SELECT count(*) FROM ticketQueue").Scan(&count))
+	require.Equal(t, 1, count)
+}
diff --git a/core/fixed_purchase.go b/core/fixed_purchase.go
new file mode 100644
index 00000000..e05c90c4
--- /dev/null
+++ b/core/fixed_purchase.go
@@ -0,0 +1,322 @@
+package core
+
+// Fixed-purchase acceptance for one upfront face=EV ticket.
+//
+// This path replaces the legacy ticket-credit accounting for the single-shot
+// token checkout: exactly one validated ticket commits exactly one durable
+// receipt (common.FixedPurchaseReceipt). It never calls legacy ProcessPayment,
+// never writes transient balances, and never invokes AccountPayment. Later
+// same-ticket delivery and the wrapper grant are unimplemented here and are
+// NOT financially settled by this method: the receipt is acceptance evidence
+// the wrapper reconciles, not proof of funds.
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"fmt"
+	"math/big"
+	"strconv"
+	"strings"
+
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/livepeer/go-livepeer/common"
+	"github.com/livepeer/go-livepeer/net"
+	"github.com/livepeer/go-livepeer/pm"
+)
+
+// FixedPurchaseTerms is the immutable purchase binding for one upfront
+// face=EV ticket. PriceWei is the positive integer wei amount from the native
+// quote; the ticket face, expected price, and stored receipt must equal it.
+type FixedPurchaseTerms struct {
+	Intent     string
+	RunnerID   string
+	ManifestID ManifestID
+	Payer      ethcommon.Address
+	Recipient  ethcommon.Address
+	PriceWei   int64
+}
+
+// fixedPurchaseMaxWinProb is the protocol maximum win probability (2^256 - 1).
+// A fixed-purchase ticket must carry exactly this value so face equals EV.
+// Kept local; pm internals stay with the recipient implementation.
+var fixedPurchaseMaxWinProb = new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 256), big.NewInt(1))
+
+// AcceptFixedPurchase validates a single-ticket fixed purchase payment against
+// the immutable terms and commits one durable receipt before any admission
+// side effect. An exact replay of the same ticket and binding returns the
+// stored receipt with created=false — even after restart or quote expiry —
+// with zero new recipient calls. A conflicting ticket or binding is refused
+// without admission. If the durable commit result is uncertain, the exact
+// stored receipt is resolved rather than accepting a new ticket.
+func (orch *orchestrator) AcceptFixedPurchase(ctx context.Context, payment net.Payment, terms FixedPurchaseTerms) (*common.FixedPurchaseReceipt, bool, error) {
+	if orch.node == nil || orch.node.Recipient == nil {
+		return nil, false, fmt.Errorf("fixed purchase recipient unavailable")
+	}
+	if orch.node.Database == nil {
+		return nil, false, fmt.Errorf("fixed purchase receipt database unavailable")
+	}
+	acceptor, ok := orch.node.Recipient.(pm.FixedPurchaseAcceptor)
+	if !ok {
+		return nil, false, fmt.Errorf("recipient does not support fixed purchase acceptance")
+	}
+	if err := validateFixedPurchaseTerms(terms); err != nil {
+		return nil, false, err
+	}
+
+	ticket, sig, seed, err := fixedPurchaseTicket(payment, terms)
+	if err != nil {
+		return nil, false, err
+	}
+	db := orch.node.Database
+
+	// Existing receipt lookup first: replay/readback performs no admission.
+	if found, err := db.FixedPurchaseReceiptByTicketHash(ticket.Hash()); err != nil {
+		return nil, false, fmt.Errorf("fixed purchase receipt lookup failed: %w", err)
+	} else if found != nil {
+		if err := matchFixedPurchaseReceipt(found, terms, ticket, sig); err != nil {
+			return nil, false, err
+		}
+		return found, false, nil
+	}
+	if found, err := db.FixedPurchaseReceiptByIntent(terms.Payer, terms.Intent); err != nil {
+		return nil, false, fmt.Errorf("fixed purchase receipt lookup failed: %w", err)
+	} else if found != nil {
+		if err := matchFixedPurchaseReceipt(found, terms, ticket, sig); err != nil {
+			return nil, false, err
+		}
+		return found, false, nil
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, false, err
+	}
+
+	// The ticket recipient must be a registered active orchestrator.
+	active, err := orch.isActive(terms.Recipient)
+	if err != nil {
+		return nil, false, fmt.Errorf("fixed purchase recipient check failed: %w", err)
+	}
+	if !active {
+		return nil, false, fmt.Errorf("fixed purchase recipient %v is inactive, cannot accept payment", terms.Recipient.Hex())
+	}
+
+	var result *common.FixedPurchaseReceipt
+	var created bool
+	persist := func(signed *pm.SignedTicket) error {
+		receipt, c, err := db.StoreFixedPurchaseReceipt(&common.FixedPurchaseReceipt{
+			Intent:     terms.Intent,
+			RunnerID:   terms.RunnerID,
+			ManifestID: string(terms.ManifestID),
+			PriceWei:   strconv.FormatInt(terms.PriceWei, 10),
+			Ticket:     signed,
+		})
+		if err != nil {
+			return err
+		}
+		result, created = receipt, c
+		return nil
+	}
+	if err := acceptor.AcceptFixedPurchase(ticket, sig, seed, persist); err != nil {
+		// Uncertain commit: resolve the exact stored receipt rather than a
+		// new ticket. A concurrent identical acceptance that won the race
+		// reads back here as a replay.
+		if found, rerr := db.FixedPurchaseReceiptByTicketHash(ticket.Hash()); rerr == nil && found != nil {
+			if merr := matchFixedPurchaseReceipt(found, terms, ticket, sig); merr == nil {
+				return found, false, nil
+			}
+		}
+		return nil, false, fmt.Errorf("fixed purchase acceptance failed: %w", err)
+	}
+	if result == nil {
+		return nil, false, fmt.Errorf("fixed purchase acceptance left no receipt")
+	}
+	return result, created, nil
+}
+
+var errFixedPurchaseBindingConflict = fmt.Errorf("fixed purchase binding conflict")
+
+func validateFixedPurchaseTerms(terms FixedPurchaseTerms) error {
+	intent, intentErr := hex.DecodeString(terms.Intent)
+	if intentErr != nil || len(intent) != 32 || terms.Intent != strings.ToLower(terms.Intent) || strings.TrimSpace(terms.RunnerID) == "" || strings.TrimSpace(string(terms.ManifestID)) == "" {
+		return fmt.Errorf("fixed purchase terms require intent, runnerID and manifestID: %w", errFixedPurchaseBindingConflict)
+	}
+	if terms.Payer == (ethcommon.Address{}) || terms.Recipient == (ethcommon.Address{}) {
+		return fmt.Errorf("fixed purchase terms require payer and recipient: %w", errFixedPurchaseBindingConflict)
+	}
+	if terms.PriceWei <= 0 {
+		return fmt.Errorf("fixed purchase terms require a positive price: %w", errFixedPurchaseBindingConflict)
+	}
+	return nil
+}
+
+// fixedPurchaseTicket validates the full request shape and equality against
+// the terms before any side effect, then builds the actual ticket with the
+// existing pm helper and a reconstructed price-per-pixel of price/1.
+func fixedPurchaseTicket(payment net.Payment, terms FixedPurchaseTerms) (*pm.Ticket, []byte, *big.Int, error) {
+	fail := func(format string, args ...interface{}) (*pm.Ticket, []byte, *big.Int, error) {
+		return nil, nil, nil, fmt.Errorf(format+": %w", append(args, errFixedPurchaseBindingConflict)...)
+	}
+	if len(payment.Sender) != ethcommon.AddressLength || ethcommon.BytesToAddress(payment.Sender) != terms.Payer {
+		return fail("fixed purchase payer mismatch")
+	}
+	tp := payment.TicketParams
+	if tp == nil {
+		return fail("fixed purchase ticket params missing")
+	}
+	if len(tp.Recipient) != ethcommon.AddressLength || ethcommon.BytesToAddress(tp.Recipient) != terms.Recipient {
+		return fail("fixed purchase recipient mismatch")
+	}
+	price := big.NewInt(terms.PriceWei)
+	if len(tp.FaceValue) == 0 || new(big.Int).SetBytes(tp.FaceValue).Cmp(price) != 0 {
+		return fail("fixed purchase face value must equal the quoted price")
+	}
+	if len(tp.WinProb) == 0 || new(big.Int).SetBytes(tp.WinProb).Cmp(fixedPurchaseMaxWinProb) != 0 {
+		return fail("fixed purchase win probability must be the protocol maximum")
+	}
+	exp := payment.GetExpectedPrice()
+	if exp == nil || exp.GetPricePerUnit() != terms.PriceWei || exp.GetPixelsPerUnit() != 1 {
+		return fail("fixed purchase expected price must be price/1")
+	}
+	if payment.ExpirationParams == nil {
+		return fail("fixed purchase expiration params missing")
+	}
+	if len(payment.TicketSenderParams) != 1 {
+		return fail("fixed purchase requires exactly one ticket")
+	}
+	tsp := payment.TicketSenderParams[0]
+	if tsp == nil || len(tsp.Sig) == 0 {
+		return fail("fixed purchase ticket signature missing")
+	}
+	if len(tp.Seed) == 0 || len(tp.Seed) > 32 {
+		return fail("fixed purchase ticket seed missing")
+	}
+	if expiry := new(big.Int).SetBytes(tp.ExpirationBlock); expiry.Sign() <= 0 || !expiry.IsInt64() {
+		return fail("fixed purchase ticket expiration block missing")
+	}
+	if len(tp.RecipientRandHash) != ethcommon.HashLength || payment.ExpirationParams.CreationRound < 0 || len(payment.ExpirationParams.CreationRoundBlockHash) != ethcommon.HashLength {
+		return fail("fixed purchase ticket recipient rand hash missing")
+	}
+	seed := new(big.Int).SetBytes(tp.Seed)
+	params := &pm.TicketParams{
+		Recipient:         terms.Recipient,
+		FaceValue:         new(big.Int).Set(price),
+		WinProb:           new(big.Int).Set(fixedPurchaseMaxWinProb),
+		RecipientRandHash: ethcommon.BytesToHash(tp.RecipientRandHash),
+		Seed:              seed,
+		ExpirationBlock:   new(big.Int).SetBytes(tp.ExpirationBlock),
+		PricePerPixel:     big.NewRat(terms.PriceWei, 1),
+		ExpirationParams: &pm.TicketExpirationParams{
+			CreationRound:          payment.ExpirationParams.CreationRound,
+			CreationRoundBlockHash: ethcommon.BytesToHash(payment.ExpirationParams.CreationRoundBlockHash),
+		},
+	}
+	return pm.NewTicket(params, params.ExpirationParams, terms.Payer, tsp.SenderNonce), tsp.Sig, seed, nil
+}
+
+// matchFixedPurchaseReceipt verifies a stored row is the exact same ticket
+// and binding, allowing replay/readback without new admission.
+func matchFixedPurchaseReceipt(found *common.FixedPurchaseReceipt, terms FixedPurchaseTerms, ticket *pm.Ticket, sig []byte) error {
+	mismatch := func(field string) error {
+		return fmt.Errorf("stored receipt has a different %s: %w", field, errFixedPurchaseBindingConflict)
+	}
+	if found.Ticket.Hash() != ticket.Hash() || found.Ticket.ParamsExpirationBlock.Cmp(ticket.ParamsExpirationBlock) != 0 {
+		return mismatch("ticket")
+	}
+	if found.Intent != terms.Intent {
+		return mismatch("intent")
+	}
+	if found.RunnerID != terms.RunnerID {
+		return mismatch("runnerID")
+	}
+	if found.ManifestID != string(terms.ManifestID) {
+		return mismatch("manifestID")
+	}
+	if found.PriceWei != strconv.FormatInt(terms.PriceWei, 10) {
+		return mismatch("priceWei")
+	}
+	if found.Ticket.Sender != terms.Payer || found.Ticket.Recipient != terms.Recipient {
+		return mismatch("payer/recipient")
+	}
+	if !bytes.Equal(found.Ticket.Sig, sig) {
+		return mismatch("signature")
+	}
+	return nil
+}
+
+// RecoverFixedPurchase resolves an already accepted payment without a cached
+// quote, a live segment-auth secret, or another admission attempt. Unknown
+// purchases return nil; callers must use the normal authenticated quote path
+// for new purchases. The original signed ticket and every saved binding must
+// match before recovery may resume delivery to the runner.
+func (orch *orchestrator) RecoverFixedPurchase(ctx context.Context, payment net.Payment, intent, runnerID string) (*common.FixedPurchaseReceipt, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if orch.node == nil || orch.node.Database == nil {
+		return nil, fmt.Errorf("fixed purchase receipt database unavailable")
+	}
+	if len(payment.Sender) != ethcommon.AddressLength {
+		return nil, errFixedPurchaseBindingConflict
+	}
+	found, err := orch.node.Database.FixedPurchaseReceiptByIntent(ethcommon.BytesToAddress(payment.Sender), intent)
+	if err != nil || found == nil {
+		return nil, err
+	}
+	price, err := strconv.ParseInt(found.PriceWei, 10, 64)
+	if err != nil {
+		return nil, err
+	}
+	terms := FixedPurchaseTerms{Intent: intent, RunnerID: runnerID, ManifestID: ManifestID(found.ManifestID),
+		Payer: found.Ticket.Sender, Recipient: found.Ticket.Recipient, PriceWei: price}
+	if err := validateFixedPurchaseTerms(terms); err != nil {
+		return nil, err
+	}
+	ticket, sig, _, err := fixedPurchaseTicket(payment, terms)
+	if err != nil {
+		return nil, err
+	}
+	if err := matchFixedPurchaseReceipt(found, terms, ticket, sig); err != nil {
+		return nil, err
+	}
+	return found, nil
+}
+
+// DeliverFixedPurchase hands the saved ticket to the existing durable redeemer
+// queue. Retry uses the persisted random/signature and never re-admits or signs.
+// Queue failure leaves the receipt intact for the same operation to recover.
+func (orch *orchestrator) DeliverFixedPurchase(ctx context.Context, receipt *common.FixedPurchaseReceipt) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if orch.node == nil || orch.node.Database == nil || receipt == nil || receipt.Ticket == nil || receipt.Ticket.Ticket == nil {
+		return fmt.Errorf("fixed purchase receipt unavailable")
+	}
+	saved, err := orch.node.Database.FixedPurchaseReceiptByTicketHash(receipt.Ticket.Hash())
+	if err != nil {
+		return err
+	}
+	if saved == nil || saved.Intent != receipt.Intent || saved.RunnerID != receipt.RunnerID || saved.ManifestID != receipt.ManifestID {
+		return errFixedPurchaseBindingConflict
+	}
+	delivery, ok := orch.node.Recipient.(pm.FixedPurchaseDeliverer)
+	if !ok {
+		return fmt.Errorf("fixed purchase delivery unavailable")
+	}
+	return delivery.QueueFixedPurchase(saved.Ticket)
+}
+
+// FixedPurchaseForSession reads accepted terms for an authenticated native
+// session. The HTTP caller must validate its runner session token first.
+func (orch *orchestrator) FixedPurchaseForSession(payer ethcommon.Address, intent, runnerID, manifestID string) (*common.FixedPurchaseReceipt, error) {
+	if orch.node == nil || orch.node.Database == nil {
+		return nil, fmt.Errorf("fixed purchase receipt database unavailable")
+	}
+	found, err := orch.node.Database.FixedPurchaseReceiptByIntent(payer, intent)
+	if err != nil || found == nil {
+		return nil, err
+	}
+	if found.RunnerID != runnerID || found.ManifestID != manifestID {
+		return nil, errFixedPurchaseBindingConflict
+	}
+	return found, nil
+}
diff --git a/core/fixed_purchase_test.go b/core/fixed_purchase_test.go
new file mode 100644
index 00000000..f437b5aa
--- /dev/null
+++ b/core/fixed_purchase_test.go
@@ -0,0 +1,447 @@
+package core
+
+// Durable collateral for orchestrator fixed-purchase acceptance: the actual
+// core method against actual common SQLite. Only the external chain/recipient
+// seam is mocked, following the existing fixedPriceMockRecipient pattern.
+// No funds, network, keys, or signing; synthetic tickets only.
+
+import (
+	"context"
+	"database/sql"
+	"math/big"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	ethcommon "github.com/ethereum/go-ethereum/common"
+	"github.com/livepeer/go-livepeer/common"
+	"github.com/livepeer/go-livepeer/net"
+	"github.com/livepeer/go-livepeer/pm"
+	"github.com/stretchr/testify/require"
+)
+
+type fixedPurchaseAcceptorRecipient struct {
+	*pm.MockRecipient
+	calls  atomic.Int64
+	accept func(ticket *pm.Ticket, sig []byte, seed *big.Int, persist func(*pm.SignedTicket) error) error
+}
+
+func (m *fixedPurchaseAcceptorRecipient) AcceptFixedPurchase(ticket *pm.Ticket, sig []byte, seed *big.Int, persist func(*pm.SignedTicket) error) error {
+	m.calls.Add(1)
+	if m.accept != nil {
+		return m.accept(ticket, sig, seed, persist)
+	}
+	return persist(&pm.SignedTicket{Ticket: ticket, Sig: sig, RecipientRand: big.NewInt(7)})
+}
+
+func fixedPurchaseMaxWinProbBytes() []byte {
+	return new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 256), big.NewInt(1)).Bytes()
+}
+
+func fixedPurchaseTestPayment(sender, recipient ethcommon.Address, price int64, nonce uint32) *net.Payment {
+	return &net.Payment{
+		Sender: sender.Bytes(),
+		TicketParams: &net.TicketParams{
+			Recipient:         recipient.Bytes(),
+			FaceValue:         big.NewInt(price).Bytes(),
+			WinProb:           fixedPurchaseMaxWinProbBytes(),
+			RecipientRandHash: pm.RandHash().Bytes(),
+			Seed:              big.NewInt(99).Bytes(),
+			ExpirationBlock:   big.NewInt(5000).Bytes(),
+		},
+		ExpirationParams: &net.TicketExpirationParams{
+			CreationRound:          5,
+			CreationRoundBlockHash: ethcommon.HexToHash("0x05").Bytes(),
+		},
+		TicketSenderParams: []*net.TicketSenderParams{
+			{SenderNonce: nonce, Sig: []byte("test-ticket-sig")},
+		},
+		ExpectedPrice: &net.PriceInfo{PricePerUnit: price, PixelsPerUnit: 1},
+	}
+}
+
+func fixedPurchaseTestTerms(intent string, recipient ethcommon.Address, sender ethcommon.Address) FixedPurchaseTerms {
+	return FixedPurchaseTerms{
+		Intent:     intent,
+		RunnerID:   "runner-1",
+		ManifestID: ManifestID("purchase-m1"),
+		Payer:      sender,
+		Recipient:  recipient,
+		PriceWei:   1000,
+	}
+}
+
+func newFixedPurchaseOrch(t *testing.T, dbh *common.DB, recipient *fixedPurchaseAcceptorRecipient) (*orchestrator, *LivepeerNode) {
+	t.Helper()
+	n, err := NewLivepeerNode(nil, "", dbh)
+	require.NoError(t, err)
+	n.Balances = NewAddressBalances(5 * time.Second)
+	n.Recipient = recipient
+	orch := NewOrchestrator(n, &stubRoundsManager{round: big.NewInt(10)})
+	return orch, n
+}
+
+func registeredFixedPurchaseDB(t *testing.T, recipient ethcommon.Address) (*common.DB, *sql.DB) {
+	t.Helper()
+	return tempDBWithOrch(t, &common.DBOrch{
+		EthereumAddr:      recipient.Hex(),
+		ActivationRound:   1,
+		DeactivationRound: 999,
+	})
+}
+
+func TestAcceptFixedPurchaseSuccess(t *testing.T) {
+	recipient := pm.RandAddress()
+	sender := pm.RandAddress()
+	dbh, dbraw := registeredFixedPurchaseDB(t, recipient)
+	defer dbh.Close()
+	defer dbraw.Close()
+
+	acceptor := &fixedPurchaseAcceptorRecipient{MockRecipient: new(pm.MockRecipient)}
+	orch, node := newFixedPurchaseOrch(t, dbh, acceptor)
+	terms := fixedPurchaseTestTerms(strings.Repeat("a1", 32), recipient, sender)
+	payment := fixedPurchaseTestPayment(sender, recipient, terms.PriceWei, 9)
+
+	receipt, created, err := orch.AcceptFixedPurchase(context.Background(), *payment, terms)
+	require.NoError(t, err)
+	require.True(t, created)
+	require.Equal(t, int64(1), acceptor.calls.Load())
+	require.Equal(t, terms.Intent, receipt.Intent)
+	require.Equal(t, terms.RunnerID, receipt.RunnerID)
+	require.Equal(t, string(terms.ManifestID), receipt.ManifestID)
+	require.Equal(t, "1000", receipt.PriceWei)
+	require.Equal(t, sender, receipt.Ticket.Sender)
+	require.Equal(t, recipient, receipt.Ticket.Recipient)
+	require.False(t, receipt.AcceptedAt.IsZero())
+
+	// This path grants no transient balance and sets no session price: the
+	// receipt replaces that accounting for the future opt-in caller.
+	require.Nil(t, node.Balances.Balance(sender, terms.ManifestID))
+	require.Nil(t, node.Balances.FixedPrice(sender, terms.ManifestID))
+}
+
+func TestAcceptFixedPurchaseReplayAfterRestart(t *testing.T) {
+	recipient := pm.RandAddress()
+	sender := pm.RandAddress()
+	path := filepath.Join(t.TempDir(), "fixed-purchase.db")
+	dbh, err := common.InitDB(path)
+	require.NoError(t, err)
+	require.NoError(t, dbh.UpdateOrch(&common.DBOrch{
+		EthereumAddr:      recipient.Hex(),
+		ActivationRound:   1,
+		DeactivationRound: 999,
+	}))
+
+	acceptor := &fixedPurchaseAcceptorRecipient{MockRecipient: new(pm.MockRecipient)}
+	orch, _ := newFixedPurchaseOrch(t, dbh, acceptor)
+	terms := fixedPurchaseTestTerms(strings.Repeat("b2", 32), recipient, sender)
+	payment := fixedPurchaseTestPayment(sender, recipient, terms.PriceWei, 9)
+
+	first, created, err := orch.AcceptFixedPurchase(context.Background(), *payment, terms)
+	require.NoError(t, err)
+	require.True(t, created)
+	require.Equal(t, int64(1), acceptor.calls.Load())
+	dbh.Close()
+
+	// Reopen the same database with a fresh orchestrator and recipient: the
+	// replay must read back the stored receipt with zero new recipient calls,
+	// even though the quote has conceptually expired.
+	dbh2, err := common.InitDB(path)
+	require.NoError(t, err)
+	defer dbh2.Close()
+	fresh := &fixedPurchaseAcceptorRecipient{MockRecipient: new(pm.MockRecipient)}
+	orch2, _ := newFixedPurchaseOrch(t, dbh2, fresh)
+
+	second, created, err := orch2.AcceptFixedPurchase(context.Background(), *payment, terms)
+	require.NoError(t, err)
+	require.False(t, created)
+	require.Equal(t, int64(0), fresh.calls.Load())
+	require.Equal(t, first.Ticket.Hash(), second.Ticket.Hash())
+	require.Equal(t, first.AcceptedAt.Unix(), second.AcceptedAt.Unix())
+}
+
+func TestAcceptFixedPurchaseRejectsShapeAndBinding(t *testing.T) {
+	recipient := pm.RandAddress()
+	sender := pm.RandAddress()
+	other := pm.RandAddress()
+	intent := strings.Repeat("c3", 32)
+
+	build := func() (FixedPurchaseTerms, *net.Payment) {
+		terms := fixedPurchaseTestTerms(intent, recipient, sender)
+		return terms, fixedPurchaseTestPayment(sender, recipient, terms.PriceWei, 9)
+	}
+
+	cases := map[string]func(*FixedPurchaseTerms, **net.Payment){
+		"two tickets": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			tsp := append([]*net.TicketSenderParams{}, (*payment).TicketSenderParams...)
+			tsp = append(tsp, &net.TicketSenderParams{SenderNonce: 10, Sig: []byte("other-sig")})
+			(*payment).TicketSenderParams = tsp
+		},
+		"face mismatch": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).TicketParams.FaceValue = big.NewInt(999).Bytes()
+		},
+		"winprob not max": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).TicketParams.WinProb = big.NewInt(1).Bytes()
+		},
+		"expected price mismatch": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).ExpectedPrice = &net.PriceInfo{PricePerUnit: 999, PixelsPerUnit: 1}
+		},
+		"expected units mismatch": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).ExpectedPrice = &net.PriceInfo{PricePerUnit: 1000, PixelsPerUnit: 2}
+		},
+		"payer mismatch": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).Sender = other.Bytes()
+		},
+		"recipient mismatch": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).TicketParams.Recipient = other.Bytes()
+		},
+		"nil expiration": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).ExpirationParams = nil
+		},
+		"empty sig": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).TicketSenderParams[0].Sig = nil
+		},
+		"empty seed": func(terms *FixedPurchaseTerms, payment **net.Payment) {
+			(*payment).TicketParams.Seed = nil
+		},
+		"zero terms price": func(terms *FixedPurchaseTerms, payment **net.Payment) {
