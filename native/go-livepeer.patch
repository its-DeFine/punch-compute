+
+// The external admission seam is synthetic; the HTTP reservation, proxy,
+// quote eviction and same-request recovery route are the real implementation.
+type recoveringPurchaseOrchestrator struct {
+	*acceptFixedPurchaseStubOrchestrator
+	saved      *common.FixedPurchaseReceipt
+	queueCalls int
+	failQueue  bool
+}
+
+func (o *recoveringPurchaseOrchestrator) RecoverFixedPurchase(ctx context.Context, p lpnet.Payment, intent, runnerID string) (*common.FixedPurchaseReceipt, error) {
+	if o.saved != nil && o.saved.Intent == intent && o.saved.RunnerID == runnerID {
+		return o.saved, nil
+	}
+	return nil, nil
+}
+func (o *recoveringPurchaseOrchestrator) DeliverFixedPurchase(context.Context, *common.FixedPurchaseReceipt) error {
+	o.queueCalls++
+	if o.failQueue {
+		return errors.New("synthetic queue response lost")
+	}
+	return nil
+}
+func TestIntentBoundRecoversQueueFailureAfterQuoteEviction(t *testing.T) {
+	grants := 0
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { grants++; w.Write([]byte("granted")) }))
+	defer upstream.Close()
+	lp := newLiveRunnerHTTPOnchain(t)
+	original := lp.orchestrator.(*stubOrchestrator)
+	registerFixedSingleShotRunner(t, lp, "runner-recover", upstream.URL)
+	intent := purchaseIntentFor(t, "recover-order")
+	challengeResponse := requestFixedPurchaseChallenge(t, lp, original, "runner-recover", intent, true)
+	require.Equal(t, 402, challengeResponse.Code)
+	challenge, info := decodeLiveRunnerPaymentChallenge(t, challengeResponse.Body.Bytes())
+	orch := &recoveringPurchaseOrchestrator{acceptFixedPurchaseStubOrchestrator: &acceptFixedPurchaseStubOrchestrator{stubOrchestrator: original}, failQueue: true}
+	orch.accept = func(ctx context.Context, p lpnet.Payment, terms core.FixedPurchaseTerms) (*common.FixedPurchaseReceipt, bool, error) {
+		orch.saved = &common.FixedPurchaseReceipt{Intent: terms.Intent, RunnerID: terms.RunnerID, ManifestID: string(terms.ManifestID), PriceWei: strconv.FormatInt(terms.PriceWei, 10), Ticket: &pm.SignedTicket{Ticket: &pm.Ticket{Sender: terms.Payer, Recipient: terms.Recipient}}}
+		return orch.saved, true, nil
+	}
+	lp.orchestrator = orch
+	req := paidSingleShotRequest(t, original, info, challenge.ManifestID, "runner-recover", intent, nil)
+	first := httptest.NewRecorder()
+	lp.ServeHTTP(first, req)
+	require.Equal(t, 503, first.Code, first.Body.String())
+	require.Zero(t, grants)
+	lp.fixedRunnerQuotesMu.Lock()
+	lp.fixedRunnerQuotes = make(map[string]fixedRunnerQuote)
+	lp.fixedRunnerQuotesMu.Unlock()
+	orch.failQueue = false
+	info.AuthToken.Expiration = 1 // Real protobuf credentials, expired Unix timestamp.
+	retry := paidSingleShotRequest(t, original, info, challenge.ManifestID, "runner-recover", intent, nil)
+	second := httptest.NewRecorder()
+	lp.ServeHTTP(second, retry)
+	require.Equal(t, 200, second.Code, second.Body.String())
+	require.Equal(t, 1, orch.acceptCalls)
+	require.Equal(t, 2, orch.queueCalls)
+	require.Equal(t, 1, grants)
+	require.Empty(t, original.balances)
+}
