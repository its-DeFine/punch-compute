diff --git a/model/strict_text_policy.go b/model/strict_text_policy.go
new file mode 100644
index 000000000..eae827320
--- /dev/null
+++ b/model/strict_text_policy.go
@@ -0,0 +1,79 @@
+package model
+
+import (
+	"database/sql/driver"
+	"fmt"
+	"math"
+	"strings"
+	"unicode"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+// StrictTextPolicy is the immutable per-order strict-text billing policy
+// persisted with a Token. Relay binds the request model and captured rates
+// from it; see relay/request_billing.go.
+type StrictTextPolicy struct {
+	InputRate       float64 `json:"input_rate"`
+	OutputRate      float64 `json:"output_rate"`
+	CacheRate       float64 `json:"cache_rate"`
+	ContextTokens   int     `json:"context_tokens"`
+	MaxOutputTokens int     `json:"max_output_tokens"`
+	ReasoningEffort string  `json:"reasoning_effort,omitempty"`
+}
+
+// Value implements driver.Valuer, storing the policy as JSON text. String
+// (never []byte) keeps Postgres simple-protocol writes off bytea.
+func (p *StrictTextPolicy) Value() (driver.Value, error) {
+	if p == nil {
+		return nil, nil
+	}
+	data, err := common.Marshal(p)
+	if err != nil {
+		return nil, err
+	}
+	return string(data), nil
+}
+
+// Scan implements sql.Scanner, accepting the text/bytes forms drivers return.
+// A NULL column leaves the target untouched so legacy rows stay policy-less.
+func (p *StrictTextPolicy) Scan(value any) error {
+	raw := jsonScanBytes(value)
+	if raw == nil {
+		return nil
+	}
+	return common.Unmarshal(raw, p)
+}
+
+func (p StrictTextPolicy) Validate() error {
+	for name, rate := range map[string]float64{"input_rate": p.InputRate, "output_rate": p.OutputRate} {
+		if math.IsNaN(rate) || math.IsInf(rate, 0) || rate <= 0 {
+			return fmt.Errorf("strict_text_policy.%s must be a finite positive rate", name)
+		}
+	}
+	if math.IsInf(p.OutputRate/p.InputRate, 0) || p.OutputRate/p.InputRate == 0 {
+		return fmt.Errorf("strict_text_policy output/input ratio is outside supported precision")
+	}
+	if math.IsNaN(p.CacheRate) || math.IsInf(p.CacheRate, 0) || p.CacheRate < 0 || p.CacheRate > p.InputRate {
+		return fmt.Errorf("strict_text_policy.cache_rate must be finite, non-negative and <= input_rate")
+	}
+	if p.ContextTokens <= 0 {
+		return fmt.Errorf("strict_text_policy.context_tokens must be a positive integer")
+	}
+	if p.MaxOutputTokens <= 0 || p.MaxOutputTokens > p.ContextTokens {
+		return fmt.Errorf("strict_text_policy.max_output_tokens must be positive and <= context_tokens")
+	}
+	if p.ReasoningEffort != "" && p.ReasoningEffort != "low" {
+		return fmt.Errorf("strict_text_policy.reasoning_effort must be empty or low")
+	}
+	return nil
+}
+
+// StrictPolicySingleModel accepts exactly one nonempty model name.
+func StrictPolicySingleModel(modelLimits string) (string, bool) {
+	name := modelLimits
+	if name == "" || strings.ContainsAny(name, ",*") || strings.IndexFunc(name, func(r rune) bool { return unicode.IsSpace(r) || unicode.IsControl(r) }) >= 0 {
+		return "", false
+	}
+	return name, true
+}
