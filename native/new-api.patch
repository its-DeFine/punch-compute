+	waitStrictFixtureTasks(t)
+	user := &model.User{Username: "admission-order-user", Quota: 100}
+	require.NoError(t, db.Create(user).Error)
+	token := &model.Token{UserId: user.Id, Key: "synthetic-admission-key", Name: "admission-order",
+		Status: common.TokenStatusEnabled, RemainQuota: 100,
+		ModelLimitsEnabled: true, ModelLimits: "revision-b", ExpiredTime: -1,
+		StrictTextPolicy: &model.StrictTextPolicy{InputRate: 1, OutputRate: 5, CacheRate: 1, ContextTokens: 64, MaxOutputTokens: 6}}
+	require.NoError(t, token.Insert())
+	ref := model.StrictOrderRef{ID: token.Id, Key: token.Key}
+	c, info := newStrictAdmissionContext(t, user, token)
+	require.Nil(t, PrepareRequestBilling(c, info))
+	assert.Equal(t, 1, model.StrictTokenAdmittedCount(ref))
+	ReleaseStrictOrderAdmission(c)
+	assert.Equal(t, 0, model.StrictTokenAdmittedCount(ref))
+	// Repeat release is a no-op: no negative counts, no panic.
+	ReleaseStrictOrderAdmission(c)
+	assert.Equal(t, 0, model.StrictTokenAdmittedCount(ref))
+
+	// While draining, the same valid request is denied without admission.
+	model.StrictTokenBeginDisable(ref)
+	c2, info2 := newStrictAdmissionContext(t, user, token)
+	apiErr := PrepareRequestBilling(c2, info2)
+	require.NotNil(t, apiErr)
+	assert.Equal(t, http.StatusForbidden, apiErr.StatusCode)
+	assert.Equal(t, 0, model.StrictTokenAdmittedCount(ref))
+	model.StrictTokenClearDisable(ref)
+}
