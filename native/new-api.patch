+// and rejects an absent model (server-models.cpp:1849,1962 at 391fac164).
+// Exercise the actual dispatch preparation through its HTTP boundary; an
+// over-context response stops before any reservation or inference is possible.
+func TestStrictTextTokenizerUsesSelectedModel(t *testing.T) {
+	for _, selected := range []string{"model-revision-a", "model-revision-b"} {
+		t.Run(selected, func(t *testing.T) {
+			var templateModel, tokenizerModel string
+			backend := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var body map[string]any
+				if json.NewDecoder(r.Body).Decode(&body) != nil {
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				name, _ := body["model"].(string)
+				switch r.URL.Path {
+				case "/apply-template":
+					templateModel = name
+					_ = json.NewEncoder(w).Encode(map[string]any{"prompt": "rendered:" + name})
+				case "/tokenize":
+					tokenizerModel = name
+					if name == "" {
+						http.Error(w, "model name is missing from the request", http.StatusBadRequest)
+						return
+					}
+					_ = json.NewEncoder(w).Encode(map[string]any{"tokens": make([]int, 4097)})
+				default:
+					w.WriteHeader(http.StatusNotFound)
+				}
+			}))
+			defer backend.Close()
+			t.Setenv("PUNCH_STRICT_TEXT_BASE_URL", backend.URL)
+			t.Setenv("PUNCH_STRICT_TEXT_MODEL", selected)
+			c, _ := gin.CreateTestContext(httptest.NewRecorder())
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil)
+			info := &relaycommon.RelayInfo{UserSetting: dto.UserSetting{QuotaWarningThreshold: -1000000}, ChannelMeta: &relaycommon.ChannelMeta{ChannelBaseUrl: backend.URL}}
+			data := []byte(`{"model":"` + selected + `","messages":[{"role":"user","content":"hello"}],"max_tokens":1}`)
+			_, apiErr := prepareStrictTextDispatch(c, info, data)
+			require.Error(t, apiErr)
+			assert.Equal(t, selected, templateModel)
+			assert.Equal(t, templateModel, tokenizerModel)
+			assert.True(t, strings.Contains(apiErr.Error(), "4096-token context"), apiErr.Error())
+			assert.Nil(t, info.Billing)
+		})
+	}
+}
