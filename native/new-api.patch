+	UpdateToken(dctx)
+	require.True(t, decodeAPIResponse(t, drecorder).Success)
+
+	ctx, recorder := newAuthenticatedContext(t, http.MethodPut, "/api/token/?model_only=true",
+		map[string]any{"id": token.Id, "expected_model": "model-a", "model": "model-b"}, user.Id)
+	UpdateToken(ctx)
