+	"github.com/shopspring/decimal"
+)
+
+const strictOrderContextKey = "punch.strict.order"
+
+type strictOrderBinding struct {
+	Model  string
+	Policy model.StrictTextPolicy
+}
+
+// This snapshot is captured before routing/reservation and is never refreshed
+// during a request. Model changes affect only subsequently admitted requests.
+func strictOrderFromContext(c *gin.Context) *strictOrderBinding {
+	value, exists := c.Get(strictOrderContextKey)
+	if !exists {
+		return nil
+	}
+	binding, _ := value.(*strictOrderBinding)
+	return binding
+}
+
+// This opt-in path is deliberately limited to the pinned text-only llama.cpp
+// channel. New API's native wallet/token reservations remain the sole ledger.
+func strictTextBody(data []byte, model string) ([]byte, int, error) {
+	return strictTextBodyWithLimits(data, model, 256, "low")
+}
+
+func strictTextBodyWithLimits(data []byte, model string, outputLimit int, reasoning string) ([]byte, int, error) {
+	var body map[string]any
+	if err := common.Unmarshal(data, &body); err != nil {
+		return nil, 0, err
+	}
+	allowed := map[string]bool{"model": true, "messages": true, "max_tokens": true, "max_completion_tokens": true, "n": true, "stream": true, "stream_options": true, "temperature": true, "top_p": true, "stop": true, "seed": true, "reasoning_effort": true}
+	for key := range body {
+		if !allowed[key] {
+			return nil, 0, fmt.Errorf("strict text mode does not support %s", key)
+		}
+	}
+	if body["model"] != model {
+		return nil, 0, fmt.Errorf("strict text model changed")
+	}
+	messages, ok := body["messages"].([]any)
+	if !ok || len(messages) == 0 {
+		return nil, 0, fmt.Errorf("strict text mode requires messages")
+	}
+	for _, v := range messages {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return nil, 0, fmt.Errorf("invalid message")
+		}
+		for key := range m {
+			if key != "role" && key != "content" {
+				return nil, 0, fmt.Errorf("strict text message does not support %s", key)
+			}
+		}
+		if m["role"] != "system" && m["role"] != "user" && m["role"] != "assistant" {
+			return nil, 0, fmt.Errorf("unsupported text role")
+		}
+		if _, ok := m["content"].(string); !ok {
+			return nil, 0, fmt.Errorf("strict mode supports text content only")
+		}
+	}
+	if n, exists := body["n"]; exists && n != float64(1) {
+		return nil, 0, fmt.Errorf("strict mode requires n=1")
+	}
+	maximum := outputLimit
+	if v, exists := body["max_completion_tokens"]; exists {
+		f, ok := v.(float64)
+		if !ok || f < 1 || f > float64(outputLimit) || f != float64(int(f)) {
+			return nil, 0, fmt.Errorf("max_completion_tokens must be an integer from 1 to %d", outputLimit)
+		}
+		maximum = int(f)
+	}
+	if v, exists := body["max_tokens"]; exists {
+		f, ok := v.(float64)
+		if !ok || f < 1 || f > float64(outputLimit) || f != float64(int(f)) {
+			return nil, 0, fmt.Errorf("max_tokens must be an integer from 1 to %d", outputLimit)
+		}
+		if other, exists := body["max_completion_tokens"]; exists && other != v {
+			return nil, 0, fmt.Errorf("conflicting output limits")
+		}
+		maximum = int(f)
+	}
+	if value, exists := body["reasoning_effort"]; exists && value != reasoning {
+		return nil, 0, fmt.Errorf("reasoning effort differs from the accepted model profile")
+	}
+	if reasoning == "" {
+		delete(body, "reasoning_effort")
+	} else {
+		body["reasoning_effort"] = reasoning
+	}
+	body["max_tokens"] = maximum
+	delete(body, "max_completion_tokens")
+	body["n"] = 1
+	encoded, err := common.Marshal(body)
+	return encoded, maximum, err
+}
+
+func strictBackendJSON(ctx context.Context, base, path string, body any, out any) error {
+	data, err := common.Marshal(body)
+	if err != nil {
+		return err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, base+path, bytes.NewReader(data))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	client := http.Client{Timeout: 5 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return fmt.Errorf("strict tokenizer redirect refused") }}
+	res, err := client.Do(req)
+	if err != nil {
+		return fmt.Errorf("strict tokenizer unavailable")
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return fmt.Errorf("strict tokenizer returned HTTP %d", res.StatusCode)
+	}
+	data, err = io.ReadAll(io.LimitReader(res.Body, 8*1024*1024))
+	if err != nil {
+		return err
+	}
+	return common.Unmarshal(data, out)
+}
+
+func prepareStrictTextDispatch(c *gin.Context, info *relaycommon.RelayInfo, data []byte) ([]byte, *types.NewAPIError) {
+	invalid := func(err error) ([]byte, *types.NewAPIError) {
+		return nil, types.NewErrorWithStatusCode(err, types.ErrorCodeInvalidRequest, http.StatusBadRequest, types.ErrOptionWithSkipRetry())
+	}
+	base := os.Getenv("PUNCH_STRICT_TEXT_BASE_URL")
+	if base == "" || info.ChannelBaseUrl != base || info.Billing != nil {
+		return invalid(fmt.Errorf("strict text channel or billing session changed"))
+	}
+	selected, outputLimit, contextLimit, reasoning := os.Getenv("PUNCH_STRICT_TEXT_MODEL"), 256, 4096, "low"
+	binding := strictOrderFromContext(c)
+	if binding != nil {
+		selected = binding.Model
+		outputLimit, contextLimit, reasoning = binding.Policy.MaxOutputTokens, binding.Policy.ContextTokens, binding.Policy.ReasoningEffort
+		if info.OriginModelName != selected || info.IsModelMapped {
+			return invalid(fmt.Errorf("strict order model routing changed"))
+		}
+	}
+	data, maximum, err := strictTextBodyWithLimits(data, selected, outputLimit, reasoning)
+	if err != nil {
+		return invalid(err)
+	}
+	var body map[string]any
+	if err = common.Unmarshal(data, &body); err != nil {
+		return invalid(err)
+	}
+	var formatted struct {
+		Prompt string `json:"prompt"`
+	}
+	if err = strictBackendJSON(c.Request.Context(), base, "/apply-template", body, &formatted); err != nil {
+		return invalid(err)
+	}
+	var tokenized struct {
+		Tokens []int `json:"tokens"`
+	}
+	if err = strictBackendJSON(c.Request.Context(), base, "/tokenize", map[string]any{"model": body["model"], "content": formatted.Prompt, "add_special": true, "parse_special": true}, &tokenized); err != nil {
+		return invalid(err)
+	}
+	prompt := len(tokenized.Tokens)
+	if prompt < 1 || prompt > contextLimit-maximum {
+		return invalid(fmt.Errorf("strict text request exceeds the %d-token context", contextLimit))
+	}
+	info.SetEstimatePromptTokens(prompt)
+	common.SetContextKey(c, constant.ContextKeyPromptTokens, prompt)
+	var quota int
+	if binding != nil {
+		p := binding.Policy
+		// Snapshot directly into the existing settlement price structure. No global
+		// model-rate mutation and no secondary balance/accounting store.
+		info.PriceData = hosttypes.PriceData{
+			ModelRatio: p.InputRate, CompletionRatio: p.OutputRate / p.InputRate,
+			CacheRatio:     p.CacheRate / p.InputRate,
+			GroupRatioInfo: hosttypes.GroupRatioInfo{GroupRatio: 1},
+		}
+		info.BillingModelName = info.OriginModelName
+		info.TieredBillingSnapshot = nil
+		upper := decimal.NewFromInt(int64(prompt)).Mul(decimal.NewFromFloat(p.InputRate)).Add(
+			decimal.NewFromInt(int64(maximum)).Mul(decimal.NewFromFloat(p.OutputRate)))
+		quota, err = common.QuotaFromDecimalStrict(upper.Ceil())
+	} else {
+		price, priceErr := helper.ModelPriceHelper(c, info, prompt, &types.TokenCountMeta{MaxTokens: maximum})
+		if priceErr != nil {
+			return invalid(priceErr)
+		}
+		// Retained single-model prototype keeps its accepted 1/5/1 pricing.
+		if price.UsePrice || price.FreeModel || info.TieredBillingSnapshot != nil || price.ModelRatio != 1 || price.CompletionRatio != 5 || price.CacheRatio != 1 || price.GroupRatioInfo.GroupRatio != 1 {
+			return invalid(fmt.Errorf("strict fixture pricing differs from accepted input1/output5/cache1 rates"))
+		}
+		quota, err = common.QuotaFromFloatStrict(float64(prompt) + 5*float64(maximum))
+	}
+	if err != nil {
+		return invalid(err)
+	}
+	policy := model.StrictTextPolicy{InputRate: 1, OutputRate: 5, CacheRate: 1,
+		ContextTokens: contextLimit, MaxOutputTokens: outputLimit, ReasoningEffort: reasoning}
+	if binding != nil {
+		policy = binding.Policy
+	}
+	info.StrictTextPolicyJSON, err = common.Marshal(policy)
+	if err != nil {
+		return invalid(err)
+	}
+	info.PriceData.QuotaToPreConsume = quota
+	info.ForcePreConsume = true
+	info.UserSetting.BillingPreference = "wallet_only"
+	if apiErr := service.PreConsumeBilling(c, quota, info); apiErr != nil {
+		return nil, apiErr
+	}
+	return data, nil
+}
