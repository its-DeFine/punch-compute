+func TestUpdateTokenModelOnlyDeniedWhileAdmitted(t *testing.T) {
+	user := setupStrictPolicyControllerTest(t)
+	token := insertStrictPolicyToken(t, user.Id, "model-a", 1000)
+
+	// Admit one request while enabled, as an in-flight relay request would.
+	ref := model.StrictOrderRef{ID: token.Id, Key: token.Key}
+	require.True(t, model.StrictTokenAdmit(ref))
+
+	// Disabling with the admission held cannot finish the drain: the
+	// response reports it, but the persisted status is already disabled.
+	timeoutCtx, timeoutCancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer timeoutCancel()
+	dctx, drecorder := newAuthenticatedContext(t, http.MethodPut, "/api/token/?status_only=true",
+		map[string]any{"id": token.Id, "status": common.TokenStatusDisabled}, user.Id)
+	dctx.Request = dctx.Request.WithContext(timeoutCtx)
+	UpdateToken(dctx)
+	require.False(t, decodeAPIResponse(t, drecorder).Success)
+	assert.Equal(t, common.TokenStatusDisabled, readStrictPolicyToken(t, token.Id).Status)
+
+	// A held admission blocks the replacement without touching the row.
+	mctx, mrecorder := newAuthenticatedContext(t, http.MethodPut, "/api/token/?model_only=true",
+		map[string]any{"id": token.Id, "expected_model": "model-a", "model": "model-b"}, user.Id)
+	UpdateToken(mctx)
+	require.False(t, decodeAPIResponse(t, mrecorder).Success)
+
+	stored := readStrictPolicyToken(t, token.Id)
+	assert.Equal(t, "model-a", stored.ModelLimits)
+	assert.Equal(t, token.Key, stored.Key)
+	assert.Equal(t, 1000, stored.RemainQuota)
+	require.NotNil(t, stored.StrictTextPolicy)
+
+	// Completion releases the order: the same update now succeeds.
+	model.StrictTokenRelease(ref)
+	mctx2, mrecorder2 := newAuthenticatedContext(t, http.MethodPut, "/api/token/?model_only=true",
+		map[string]any{"id": token.Id, "expected_model": "model-a", "model": "model-b"}, user.Id)
+	UpdateToken(mctx2)
+	require.True(t, decodeAPIResponse(t, mrecorder2).Success)
+	assert.Equal(t, "model-b", readStrictPolicyToken(t, token.Id).ModelLimits)
+}
