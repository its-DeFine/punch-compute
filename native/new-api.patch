+// model after ownership and policy checks, updating model_limits alone.
+func updateTokenStrictModel(c *gin.Context, userId int, request tokenRequest) {
+	if request.Token.Id == 0 {
+		common.ApiError(c, fmt.Errorf("strict policy model update requires token id"))
+		return
+	}
+	cleanToken, unlock, err := model.GetTokenForStrictOperation(request.Token.Id, userId)
+	defer unlock()
+	if err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	if err := cleanToken.ValidateStrictTextPolicy(); err != nil {
+		common.ApiError(c, fmt.Errorf("strict policy model update unavailable"))
+		return
+	}
+	current, ok := model.StrictPolicySingleModel(cleanToken.ModelLimits)
+	if !cleanToken.ModelLimitsEnabled || !ok || current != request.ExpectedModel {
+		common.ApiError(c, fmt.Errorf("strict policy current model mismatch"))
+		return
+	}
+	next, ok := model.StrictPolicySingleModel(request.Model)
+	if !ok {
+		common.ApiError(c, fmt.Errorf("strict policy model invalid"))
+		return
+	}
+	// Replacement waits for a drained order: the token must already be
+	// disabled and no strict request may still be admitted. The swap itself
+	// still touches model_limits alone, never key, quota or policy.
+	orderRef := model.StrictOrderRef{ID: cleanToken.Id, Key: cleanToken.Key}
+	if cleanToken.Status != common.TokenStatusDisabled {
+		common.ApiError(c, fmt.Errorf("strict policy model update requires disabled token"))
+		return
+	}
+	summary, reservationErr := model.StrictTextReservationSummary(cleanToken.Id)
+	if reservationErr != nil {
+		common.ApiError(c, reservationErr)
+		return
+	}
+	if summary.ReservedCount+summary.DispatchedCount > 0 {
+		common.ApiError(c, fmt.Errorf("strict order has unresolved reservations"))
+		return
+	}
+	if model.StrictTokenAdmittedCount(orderRef) > 0 {
+		common.ApiError(c, fmt.Errorf("strict policy model update waits for admitted requests to finish"))
+		return
+	}
+	swapped, err := model.CASStrictTextModel(cleanToken.Id, userId, cleanToken.Key, current, next)
+	if err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	if !swapped {
+		common.ApiError(c, fmt.Errorf("strict policy model changed concurrently"))
+		return
+	}
+	cleanToken.ModelLimits = next
+	params := tokenAuditParams(c)
+	params["id"] = cleanToken.Id
+	params["changed_fields"] = []string{"model_limits"}
+	common.SetContextKey(c, constant.ContextKeyTokenAuditSucceeded, true)
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"message": "",
+		"data":    buildMaskedTokenResponse(cleanToken),
+	})
+}
