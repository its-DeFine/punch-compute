@@ -0,0 +1,184 @@
+package model
+
+import (
+	"math"
+	"sync"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func validTestPolicy() *StrictTextPolicy {
+	return &StrictTextPolicy{
+		InputRate: 1, OutputRate: 5, CacheRate: 1,
+		ContextTokens: 4096, MaxOutputTokens: 256, ReasoningEffort: "low",
+	}
+}
+
+func TestStrictTextPolicyValidate(t *testing.T) {
+	good := *validTestPolicy()
+	for _, tc := range []struct {
+		name   string
+		mutate func(*StrictTextPolicy)
+		valid  bool
+	}{
+		{"valid", func(p *StrictTextPolicy) {}, true},
+		{"zero cache", func(p *StrictTextPolicy) { p.CacheRate = 0 }, true},
+		{"cache equals input", func(p *StrictTextPolicy) { p.CacheRate = p.InputRate }, true},
+		{"empty reasoning", func(p *StrictTextPolicy) { p.ReasoningEffort = "" }, true},
+		{"nan input", func(p *StrictTextPolicy) { p.InputRate = math.NaN() }, false},
+		{"ratio overflow", func(p *StrictTextPolicy) {
+			p.InputRate = math.SmallestNonzeroFloat64
+			p.CacheRate = 0
+			p.OutputRate = math.MaxFloat64
+		}, false},
+		{"inf output", func(p *StrictTextPolicy) { p.OutputRate = math.Inf(1) }, false},
+		{"zero input", func(p *StrictTextPolicy) { p.InputRate = 0 }, false},
+		{"negative output", func(p *StrictTextPolicy) { p.OutputRate = -1 }, false},
+		{"negative cache", func(p *StrictTextPolicy) { p.CacheRate = -1 }, false},
+		{"cache above input", func(p *StrictTextPolicy) { p.CacheRate = 2 }, false},
+		{"zero context", func(p *StrictTextPolicy) { p.ContextTokens = 0 }, false},
+		{"zero max output", func(p *StrictTextPolicy) { p.MaxOutputTokens = 0 }, false},
+		{"max above context", func(p *StrictTextPolicy) { p.MaxOutputTokens = 5000 }, false},
+		{"bad reasoning", func(p *StrictTextPolicy) { p.ReasoningEffort = "high" }, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			policy := good
+			tc.mutate(&policy)
+			if tc.valid {
+				require.NoError(t, policy.Validate())
+			} else {
+				require.Error(t, policy.Validate())
+			}
+		})
+	}
+}
+
+func TestStrictTextPolicySingleModel(t *testing.T) {
+	name, ok := StrictPolicySingleModel("punch-test-model")
+	require.True(t, ok)
+	assert.Equal(t, "punch-test-model", name)
+	for _, bad := range []string{"", "  ", "a,b", "a, b", " model", "a\nb", "a\x00b", "*"} {
+		_, ok := StrictPolicySingleModel(bad)
+		assert.False(t, ok, bad)
+	}
+}
+
+func insertPolicyToken(t *testing.T, userID int, modelName string, quota int, policy *StrictTextPolicy) Token {
+	t.Helper()
+	token := Token{
+		UserId:             userID,
+		Key:                "policy-token-" + common.GetRandomString(8),
+		Name:               "policy-" + modelName,
+		Status:             1,
+		ExpiredTime:        -1,
+		RemainQuota:        quota,
+		ModelLimitsEnabled: true,
+		ModelLimits:        modelName,
+		StrictTextPolicy:   policy,
+	}
+	require.NoError(t, token.Insert())
+	return token
+}
+
+func TestStrictTextPolicyRoundTripAndLegacyNil(t *testing.T) {
+	user := createReserveTestUser(t, 100000)
+	stored := insertPolicyToken(t, user.Id, "model-a", 1000, validTestPolicy())
+	read := getTokenFromDB(t, stored.Id)
+	require.NotNil(t, read.StrictTextPolicy)
+	require.NoError(t, read.ValidateStrictTextPolicy())
+	assert.Equal(t, *validTestPolicy(), *read.StrictTextPolicy)
+
+	legacy := createReserveTestToken(t, 500)
+	legacyRead := getTokenFromDB(t, legacy.Id)
+	assert.Nil(t, legacyRead.StrictTextPolicy)
+	require.Error(t, legacyRead.ValidateStrictTextPolicy())
+}
+
+func TestStrictTextPolicyInsertGuards(t *testing.T) {
+	user := createReserveTestUser(t, 100000)
+	base := Token{UserId: user.Id, Key: "guard-token", Name: "guard", Status: 1,
+		ExpiredTime: -1, RemainQuota: 100, ModelLimitsEnabled: true,
+		ModelLimits: "model-a", StrictTextPolicy: validTestPolicy()}
+	unlimited := base
+	unlimited.Key = "guard-unlimited"
+	unlimited.UnlimitedQuota = true
+	require.Error(t, unlimited.Insert())
+
+	unenforced := base
+	unenforced.Key = "guard-unenforced"
+	unenforced.ModelLimitsEnabled = false
+	require.Error(t, unenforced.Insert())
+
+	multi := base
+	multi.Key = "guard-multi"
+	multi.ModelLimits = "model-a,model-b"
+	require.Error(t, multi.Insert())
+
+	badRate := base
+	badRate.Key = "guard-badrate"
+	badRate.StrictTextPolicy = &StrictTextPolicy{InputRate: -1, OutputRate: 5,
+		CacheRate: 0, ContextTokens: 4096, MaxOutputTokens: 256}
+	require.Error(t, badRate.Insert())
+
+	require.NoError(t, base.Insert())
+}
+
+func TestCASStrictTextModelConcurrentQuota(t *testing.T) {
+	user := createReserveTestUser(t, 100000)
+	token := insertPolicyToken(t, user.Id, "model-a", 1000, validTestPolicy())
+	before := getTokenFromDB(t, token.Id)
+
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	swap := make(chan bool, 1)
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		<-start
+		changed, err := CASStrictTextModel(token.Id, user.Id, token.Key, "model-a", "model-b")
+		assert.NoError(t, err)
+		swap <- changed
+	}()
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			ok, err := TryReserveTokenQuota(token.Id, token.Key, 10, false)
+			assert.NoError(t, err)
+			assert.True(t, ok)
+		}()
+	}
+	close(start)
+	wg.Wait()
+	require.True(t, <-swap)
+	swappedAgain, err := CASStrictTextModel(token.Id, user.Id, token.Key, "model-a", "model-c")
+	require.NoError(t, err)
+	require.False(t, swappedAgain)
+
+	after := getTokenFromDB(t, token.Id)
+	assert.Equal(t, "model-b", after.ModelLimits)
+	assert.Equal(t, before.RemainQuota-80, after.RemainQuota)
+	assert.Equal(t, before.UsedQuota+80, after.UsedQuota)
+	assert.Equal(t, before.Key, after.Key)
+	assert.Equal(t, before.Name, after.Name)
+	assert.Equal(t, before.ExpiredTime, after.ExpiredTime)
+	require.NotNil(t, after.StrictTextPolicy)
+	assert.Equal(t, *validTestPolicy(), *after.StrictTextPolicy)
+	require.NoError(t, after.ValidateStrictTextPolicy())
+}
+
+func TestStrictTextPolicyPersistedGuards(t *testing.T) {
+	for _, mutation := range []func(*Token){
+		func(t *Token) { t.UnlimitedQuota = true },
+		func(t *Token) { t.ModelLimitsEnabled = false },
+		func(t *Token) { t.ModelLimits = "a,b" },
+	} {
+		token := Token{ModelLimitsEnabled: true, ModelLimits: "model-a", StrictTextPolicy: validTestPolicy()}
+		mutation(&token)
+		require.Error(t, token.ValidateStrictTextPolicy())
+	}
+}
diff --git a/model/strict_text_reservation.go b/model/strict_text_reservation.go
new file mode 100644
index 000000000..b5baabe39
--- /dev/null
+++ b/model/strict_text_reservation.go
@@ -0,0 +1,663 @@
+package model
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+
+	"github.com/QuantumNous/new-api/common"
+
+	"gorm.io/gorm"
+)
+
+// Strict reservation states for durable wallet-backed strict-text accounting.
+// Only RESERVED rows may be refunded after a restart; DISPATCHED rows stay
+// held for an operator verdict because a missing consume log is NOT proof
+// that the upstream call never happened. Logs may live in a separate
+// database, so this table never assumes an atomic cross-DB commit with them.
+const (
+	StrictReservationReserved   = "RESERVED"
+	StrictReservationDispatched = "DISPATCHED"
+	StrictReservationSettled    = "SETTLED"
+	StrictReservationRefunded   = "REFUNDED"
+)
+
+var (
+	ErrStrictReservationNotFound      = errors.New("strict reservation not found")
+	ErrStrictReservationConflict      = errors.New("strict reservation conflict")
+	ErrStrictReservationInsufficient  = errors.New("strict reservation insufficient quota")
+	ErrStrictReservationHeld          = errors.New("strict reservation dispatched; held, no automatic refund")
+	ErrStrictReservationSyncMode      = errors.New("strict reservation requires synchronous database balances: disable Redis quota cache and batch updates, or invalidate them around these calls")
+	ErrStrictReservationCapExceeded   = errors.New("strict reservation actual quota exceeds reserved quota")
+	ErrStrictReservationInvalidInput  = errors.New("strict reservation invalid input")
+	ErrStrictReservationTokenMismatch = errors.New("strict reservation token mismatch")
+)
+
+// StrictTextReservation is the durable wallet-leg reservation for one strict
+// request. Balances stay in the existing stores (users.quota and
+// tokens.remain_quota/used_quota); this row is the write-ahead record, not a
+// second ledger. request_id is unique: a repeated reserve with the identical
+// snapshot replays, any differing snapshot or illegal transition rejects.
+type StrictTextReservation struct {
+	Id              int     `json:"id"`
+	RequestId       string  `json:"request_id" gorm:"type:varchar(64);uniqueIndex"`
+	UserId          int     `json:"user_id" gorm:"index"`
+	TokenId         int     `json:"token_id" gorm:"index"`
+	TokenKeyHash    string  `json:"-" gorm:"type:varchar(64)"`
+	ChannelId       int     `json:"channel_id" gorm:"index"`
+	Model           string  `json:"model" gorm:"type:varchar(128)"`
+	InputRate       float64 `json:"input_rate"`
+	OutputRate      float64 `json:"output_rate"`
+	CacheRate       float64 `json:"cache_rate"`
+	ContextTokens   int     `json:"context_tokens"`
+	MaxOutputTokens int     `json:"max_output_tokens"`
+	ReasoningEffort string  `json:"reasoning_effort" gorm:"type:varchar(16)"`
+	ReservedQuota   int     `json:"reserved_quota"`
+	ActualQuota     int     `json:"actual_quota"`
+	// Known-result fields: a DISPATCHED row carries no usage until the
+	// upstream verdict is durably recorded. Only a recorded result may be
+	// recovered after a restart; an unrecorded DISPATCHED row stays held.
+	ActualPromptTokens     int    `json:"actual_prompt_tokens"`
+	ActualCompletionTokens int    `json:"actual_completion_tokens"`
+	ResultRecorded         bool   `json:"result_recorded"`
+	State                  string `json:"state" gorm:"type:varchar(16);index"`
+	CreatedAt              int64  `json:"created_at" gorm:"bigint"`
+	UpdatedAt              int64  `json:"updated_at" gorm:"bigint;index"`
+}
+
+func (r *StrictTextReservation) BeforeCreate(tx *gorm.DB) error {
+	now := common.GetTimestamp()
+	r.CreatedAt = now
+	r.UpdatedAt = now
+	return nil
+}
+
+func (r *StrictTextReservation) BeforeUpdate(tx *gorm.DB) error {
+	r.UpdatedAt = common.GetTimestamp()
+	return nil
+}
+
+// StrictReservationInput carries the immutable snapshot bound at reserve time.
+type StrictReservationInput struct {
+	RequestId     string
+	UserId        int
+	TokenId       int
+	TokenKey      string
+	ChannelId     int
+	Model         string
+	Policy        StrictTextPolicy
+	ReservedQuota int
+}
+
+func requireStrictSyncMode() error {
+	if common.RedisEnabled || common.BatchUpdateEnabled {
+		return ErrStrictReservationSyncMode
+	}
+	return nil
+}
+
+func validateStrictReservationInput(input StrictReservationInput) error {
+	if input.RequestId == "" || len(input.RequestId) > 64 {
+		return fmt.Errorf("%w: request_id is empty", ErrStrictReservationInvalidInput)
+	}
+	if input.UserId <= 0 || input.TokenId <= 0 {
+		return fmt.Errorf("%w: user and token ids must be positive", ErrStrictReservationInvalidInput)
+	}
+	if input.TokenKey == "" {
+		return fmt.Errorf("%w: token key is empty", ErrStrictReservationInvalidInput)
+	}
+	if input.ChannelId < 0 {
+		return fmt.Errorf("%w: channel id must not be negative", ErrStrictReservationInvalidInput)
+	}
+	if input.ReservedQuota <= 0 {
+		return fmt.Errorf("%w: reserved quota must be positive", ErrStrictReservationInvalidInput)
+	}
+	if err := common.ValidateWalletQuota(input.ReservedQuota); err != nil {
+		return fmt.Errorf("%w: %w", ErrStrictReservationInvalidInput, err)
+	}
+	if _, ok := StrictPolicySingleModel(input.Model); !ok || len(input.Model) > 128 {
+		return fmt.Errorf("%w: model must be exactly one name", ErrStrictReservationInvalidInput)
+	}
+	if err := input.Policy.Validate(); err != nil {
+		return fmt.Errorf("%w: %w", ErrStrictReservationInvalidInput, err)
+	}
+	return nil
+}
+
+func sameStrictSnapshot(row *StrictTextReservation, input StrictReservationInput) bool {
+	return row.UserId == input.UserId &&
+		row.ChannelId == input.ChannelId &&
+		row.TokenId == input.TokenId &&
+		row.TokenKeyHash == fmt.Sprintf("%x", sha256.Sum256([]byte(input.TokenKey))) &&
+		row.Model == input.Model &&
+		row.InputRate == input.Policy.InputRate &&
+		row.OutputRate == input.Policy.OutputRate &&
+		row.CacheRate == input.Policy.CacheRate &&
+		row.ContextTokens == input.Policy.ContextTokens &&
+		row.MaxOutputTokens == input.Policy.MaxOutputTokens &&
+		row.ReasoningEffort == input.Policy.ReasoningEffort &&
+		row.ReservedQuota == input.ReservedQuota
+}
+
+// ReserveStrictTextWalletReservation atomically deducts ReservedQuota from
+// BOTH users.quota and tokens.remain_quota (used_quota rises by the same
+// amount) and inserts the RESERVED row in one transaction. A repeated call
+// with the identical snapshot returns the existing row without deducting
+// again; a reused request_id with any differing field rejects.
+func ReserveStrictTextWalletReservation(input StrictReservationInput) (*StrictTextReservation, error) {
+	if err := requireStrictSyncMode(); err != nil {
+		return nil, err
+	}
+	if err := validateStrictReservationInput(input); err != nil {
+		return nil, err
+	}
+	row := &StrictTextReservation{}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var existing StrictTextReservation
+		lookup := tx.Where("request_id = ?", input.RequestId).First(&existing)
+		if lookup.Error == nil {
+			if existing.State == StrictReservationReserved && sameStrictSnapshot(&existing, input) {
+				*row = existing
+				return nil
+			}
+			return fmt.Errorf("%w: request_id %q already recorded in state %s",
+				ErrStrictReservationConflict, input.RequestId, existing.State)
+		}
+		if !errors.Is(lookup.Error, gorm.ErrRecordNotFound) {
+			return lookup.Error
+		}
+		var token Token
+		if err := lockForUpdate(tx).Where("id = ?", input.TokenId).First(&token).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return fmt.Errorf("%w: token %d: %w", ErrStrictReservationTokenMismatch, input.TokenId, ErrStrictReservationNotFound)
+			}
+			return err
+		}
+		if token.Key != input.TokenKey || token.UserId != input.UserId {
+			return fmt.Errorf("%w: token %d is not owned by this user/key",
+				ErrStrictReservationTokenMismatch, input.TokenId)
+		}
+		if token.StrictTextPolicy != nil && (token.ModelLimits != input.Model || *token.StrictTextPolicy != input.Policy) {
+			return ErrStrictReservationTokenMismatch
+		}
+		if token.UnlimitedQuota {
+			return fmt.Errorf("%w: strict reservation requires a finite token quota",
+				ErrStrictReservationTokenMismatch)
+		}
+		wallet := tx.Model(&User{}).
+			Where("id = ? AND quota >= ?", input.UserId, input.ReservedQuota).
+			Update("quota", gorm.Expr("quota - ?", input.ReservedQuota))
+		if wallet.Error != nil {
+			return wallet.Error
+		}
+		if wallet.RowsAffected != 1 {
+			return fmt.Errorf("%w: wallet quota insufficient for user %d",
+				ErrStrictReservationInsufficient, input.UserId)
+		}
+		leg := tx.Model(&Token{}).
+			Where("id = ? AND remain_quota >= ?", input.TokenId, input.ReservedQuota).
+			Updates(map[string]any{
+				"remain_quota":  gorm.Expr("remain_quota - ?", input.ReservedQuota),
+				"used_quota":    gorm.Expr("used_quota + ?", input.ReservedQuota),
+				"accessed_time": common.GetTimestamp(),
+			})
+		if leg.Error != nil {
+			return leg.Error
+		}
+		if leg.RowsAffected != 1 {
+			return fmt.Errorf("%w: token quota insufficient for token %d",
+				ErrStrictReservationInsufficient, input.TokenId)
+		}
+		*row = StrictTextReservation{
+			RequestId:       input.RequestId,
+			UserId:          input.UserId,
+			TokenId:         input.TokenId,
+			TokenKeyHash:    fmt.Sprintf("%x", sha256.Sum256([]byte(input.TokenKey))),
+			ChannelId:       input.ChannelId,
+			Model:           input.Model,
+			InputRate:       input.Policy.InputRate,
+			OutputRate:      input.Policy.OutputRate,
+			CacheRate:       input.Policy.CacheRate,
+			ContextTokens:   input.Policy.ContextTokens,
+			MaxOutputTokens: input.Policy.MaxOutputTokens,
+			ReasoningEffort: input.Policy.ReasoningEffort,
+			ReservedQuota:   input.ReservedQuota,
+			State:           StrictReservationReserved,
+		}
+		return tx.Create(row).Error
+	})
+	if err != nil {
+		return nil, err
+	}
+	return row, nil
+}
+
+// MarkStrictTextReservationDispatched flips RESERVED to DISPATCHED before the
+// upstream network call. A DISPATCHED row refuses a second dispatch;
+// any other state rejects.
+func MarkStrictTextReservationDispatched(requestId string) (*StrictTextReservation, error) {
+	if err := requireStrictSyncMode(); err != nil {
+		return nil, err
+	}
+	if requestId == "" {
+		return nil, fmt.Errorf("%w: request_id is empty", ErrStrictReservationInvalidInput)
+	}
+	row := &StrictTextReservation{}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		flipped := tx.Model(&StrictTextReservation{}).
+			Where("request_id = ? AND state = ?", requestId, StrictReservationReserved).
+			Updates(map[string]any{
+				"state":      StrictReservationDispatched,
+				"updated_at": common.GetTimestamp(),
+			})
+		if flipped.Error != nil {
+			return flipped.Error
+		}
+		if flipped.RowsAffected == 1 {
+			return tx.Where("request_id = ?", requestId).First(row).Error
+		}
+		return readStrictReservationTx(tx, requestId, row, func(existing *StrictTextReservation) error {
+			if existing.State == StrictReservationDispatched {
+				return ErrStrictReservationHeld // never authorize a second network dispatch
+			}
+			return fmt.Errorf("%w: cannot dispatch from state %s",
+				ErrStrictReservationConflict, existing.State)
+		})
+	})
+	if err != nil {
+		return nil, err
+	}
+	return row, nil
+}
+
+// RecordStrictTextResult durably retains one known upstream verdict on a
+// DISPATCHED row before settlement: input/output usage plus the actual quota
+// the service layer derived from them. Repeating the identical verdict
+// replays; any differing verdict rejects. Rows in any other state reject, so
+// a result can never be attached before dispatch or after terminality.
+func RecordStrictTextResult(requestId string, promptTokens, completionTokens, actualQuota int) (*StrictTextReservation, error) {
+	if err := requireStrictSyncMode(); err != nil {
+		return nil, err
+	}
+	if requestId == "" {
+		return nil, fmt.Errorf("%w: request_id is empty", ErrStrictReservationInvalidInput)
+	}
+	if promptTokens < 1 {
+		return nil, fmt.Errorf("%w: prompt tokens must be positive", ErrStrictReservationInvalidInput)
+	}
+	if completionTokens < 0 {
+		return nil, fmt.Errorf("%w: completion tokens must not be negative", ErrStrictReservationInvalidInput)
+	}
+	if actualQuota < 0 {
+		return nil, fmt.Errorf("%w: actual quota must not be negative", ErrStrictReservationInvalidInput)
+	}
+	if err := common.ValidateWalletQuota(actualQuota); err != nil {
+		return nil, fmt.Errorf("%w: %w", ErrStrictReservationInvalidInput, err)
+	}
+	row := &StrictTextReservation{}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var existing StrictTextReservation
+		if err := lockForUpdate(tx).Where("request_id = ?", requestId).First(&existing).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return fmt.Errorf("%w: %q", ErrStrictReservationNotFound, requestId)
+			}
+			return err
+		}
+		if existing.State != StrictReservationDispatched {
+			return fmt.Errorf("%w: cannot record a result in state %s",
+				ErrStrictReservationConflict, existing.State)
+		}
+		if existing.ResultRecorded {
+			if existing.ActualPromptTokens != promptTokens ||
+				existing.ActualCompletionTokens != completionTokens ||
+				existing.ActualQuota != actualQuota {
+				return fmt.Errorf("%w: a different verdict is already recorded",
+					ErrStrictReservationConflict)
+			}
+			*row = existing
+			return nil
+		}
+		if actualQuota > existing.ReservedQuota {
+			return fmt.Errorf("%w: actual %d exceeds reserved %d",
+				ErrStrictReservationCapExceeded, actualQuota, existing.ReservedQuota)
+		}
+		flipped := tx.Model(&StrictTextReservation{}).
+			Where("request_id = ? AND state = ? AND (result_recorded = ? OR result_recorded IS NULL)", requestId, StrictReservationDispatched, false).
+			Updates(map[string]any{
+				"actual_prompt_tokens":     promptTokens,
+				"actual_completion_tokens": completionTokens,
+				"actual_quota":             actualQuota,
+				"result_recorded":          true,
+				"updated_at":               common.GetTimestamp(),
+			})
+		if flipped.Error != nil {
+			return flipped.Error
+		}
+		if flipped.RowsAffected != 1 {
+			return fmt.Errorf("%w: reservation changed concurrently",
+				ErrStrictReservationConflict)
+		}
+		return tx.Where("request_id = ?", requestId).First(row).Error
+	})
+	if err != nil {
+		return nil, err
+	}
+	return row, nil
+}
+
+// RecoverRecordedStrictTextResult settles a DISPATCHED row that already
+// carries a recorded known result, using exactly that recorded actual. It is
+// the restart-recovery entry point: idempotent, single-commit, and safe to
+// retry. A DISPATCHED row without a recorded result stays held; any other
+// state resolves through the ordinary settle/refund transitions.
+func RecoverRecordedStrictTextResult(requestId string) (*StrictTextReservation, error) {
+	if err := requireStrictSyncMode(); err != nil {
+		return nil, err
+	}
+	row, err := GetStrictTextReservation(requestId)
+	if err != nil {
+		return nil, err
+	}
+	if row.State == StrictReservationSettled {
+		return row, nil
+	}
+	if row.State != StrictReservationDispatched || !row.ResultRecorded {
+		if row.State == StrictReservationDispatched {
+			return nil, fmt.Errorf("%w: %q", ErrStrictReservationHeld, requestId)
+		}
+		return nil, fmt.Errorf("%w: cannot recover from state %s",
+			ErrStrictReservationConflict, row.State)
+	}
+	return SettleStrictTextReservation(requestId, row.ActualQuota)
+}
+
+// SettleStrictTextReservation settles actualQuota (0 <= actual <= reserved,
+// the strict cap) from RESERVED or DISPATCHED, returning the
+// reserved-actual delta to BOTH balances atomically with the state flip.
+// Balance, usage statistics and the row commit in ONE transaction, so the
+// statistics can never run ahead of the money. A DISPATCHED row with a
+// recorded verdict only settles with exactly that recorded actual.
+// Repeating with the same actual replays; a different actual rejects.
+func SettleStrictTextReservation(requestId string, actualQuota int) (*StrictTextReservation, error) {
+	if err := requireStrictSyncMode(); err != nil {
+		return nil, err
+	}
+	if requestId == "" {
+		return nil, fmt.Errorf("%w: request_id is empty", ErrStrictReservationInvalidInput)
+	}
+	if actualQuota < 0 {
+		return nil, fmt.Errorf("%w: actual quota must not be negative", ErrStrictReservationInvalidInput)
+	}
+	if err := common.ValidateWalletQuota(actualQuota); err != nil {
+		return nil, fmt.Errorf("%w: %w", ErrStrictReservationInvalidInput, err)
+	}
+	row := &StrictTextReservation{}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var existing StrictTextReservation
+		if err := lockForUpdate(tx).Where("request_id = ?", requestId).First(&existing).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return fmt.Errorf("%w: %q", ErrStrictReservationNotFound, requestId)
+			}
+			return err
+		}
+		if existing.State == StrictReservationSettled {
+			if existing.ActualQuota != actualQuota {
+				return fmt.Errorf("%w: already settled with actual %d, not %d",
+					ErrStrictReservationConflict, existing.ActualQuota, actualQuota)
+			}
+			*row = existing
+			return nil
+		}
+		if existing.State != StrictReservationReserved && existing.State != StrictReservationDispatched {
+			return fmt.Errorf("%w: cannot settle from state %s",
+				ErrStrictReservationConflict, existing.State)
+		}
+		if existing.State == StrictReservationDispatched && existing.ResultRecorded && existing.ActualQuota != actualQuota {
+			return fmt.Errorf("%w: recorded actual is %d, not %d",
+				ErrStrictReservationConflict, existing.ActualQuota, actualQuota)
+		}
+		if actualQuota > existing.ReservedQuota {
+			return fmt.Errorf("%w: actual %d exceeds reserved %d",
+				ErrStrictReservationCapExceeded, actualQuota, existing.ReservedQuota)
+		}
+		if delta := existing.ReservedQuota - actualQuota; delta > 0 {
+			if err := creditStrictBalancesTx(tx, &existing, delta); err != nil {
+				return err
+			}
+		}
+		if err := debitStrictStatsTx(tx, &existing, actualQuota); err != nil {
+			return err
+		}
+		flipped := tx.Model(&StrictTextReservation{}).
+			Where("request_id = ? AND state = ?", requestId, existing.State).
+			Updates(map[string]any{
+				"state":        StrictReservationSettled,
+				"actual_quota": actualQuota,
+				"updated_at":   common.GetTimestamp(),
+			})
+		if flipped.Error != nil {
+			return flipped.Error
+		}
+		if flipped.RowsAffected != 1 {
+			return fmt.Errorf("%w: reservation changed concurrently",
+				ErrStrictReservationConflict)
+		}
+		return tx.Where("request_id = ?", requestId).First(row).Error
+	})
+	if err != nil {
+		return nil, err
+	}
+	return row, nil
+}
+
+// RefundStrictTextReservation refunds the full reserved amount to BOTH
+// balances atomically with the RESERVED to REFUNDED flip. DISPATCHED rows
+// reject and stay held; an already REFUNDED row replays. Callers recover
+// RESERVED rows after a restart only under caller-owned quiescence.
+func RefundStrictTextReservation(requestId string) (*StrictTextReservation, error) {
+	if err := requireStrictSyncMode(); err != nil {
+		return nil, err
+	}
+	if requestId == "" {
+		return nil, fmt.Errorf("%w: request_id is empty", ErrStrictReservationInvalidInput)
+	}
+	row := &StrictTextReservation{}
+	err := DB.Transaction(func(tx *gorm.DB) error {
+		var existing StrictTextReservation
+		if err := lockForUpdate(tx).Where("request_id = ?", requestId).First(&existing).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return fmt.Errorf("%w: %q", ErrStrictReservationNotFound, requestId)
+			}
+			return err
+		}
+		if existing.State == StrictReservationRefunded {
+			*row = existing
+			return nil
+		}
+		if existing.State == StrictReservationDispatched {
+			return fmt.Errorf("%w: %q", ErrStrictReservationHeld, requestId)
+		}
+		if existing.State != StrictReservationReserved {
+			return fmt.Errorf("%w: cannot refund from state %s",
+				ErrStrictReservationConflict, existing.State)
+		}
+		if err := creditStrictBalancesTx(tx, &existing, existing.ReservedQuota); err != nil {
+			return err
+		}
+		flipped := tx.Model(&StrictTextReservation{}).
+			Where("request_id = ? AND state = ?", requestId, StrictReservationReserved).
+			Updates(map[string]any{
+				"state":      StrictReservationRefunded,
+				"updated_at": common.GetTimestamp(),
+			})
+		if flipped.Error != nil {
+			return flipped.Error
+		}
+		if flipped.RowsAffected != 1 {
+			return fmt.Errorf("%w: reservation changed concurrently",
+				ErrStrictReservationConflict)
+		}
+		return tx.Where("request_id = ?", requestId).First(row).Error
+	})
+	if err != nil {
+		return nil, err
+	}
+	return row, nil
+}
+
+// creditStrictBalancesTx returns amount to the wallet and the token leg
+// inside the caller's transaction: used_quota moves back consistently, so a
+// fully refunded reservation leaves remain and used exactly as before.
+func creditStrictBalancesTx(tx *gorm.DB, row *StrictTextReservation, amount int) error {
+	wallet := tx.Model(&User{}).
+		Where("id = ? AND quota <= ?", row.UserId, common.MaxWalletQuota-amount).
+		Update("quota", gorm.Expr("quota + ?", amount))
+	if wallet.Error != nil {
+		return wallet.Error
+	}
+	if wallet.RowsAffected != 1 {
+		return fmt.Errorf("%w: wallet credit would exceed the cap or user %d is gone",
+			ErrStrictReservationConflict, row.UserId)
+	}
+	leg := tx.Model(&Token{}).
+		Where("id = ? AND user_id = ? AND remain_quota <= ? AND used_quota >= ?", row.TokenId, row.UserId, common.MaxWalletQuota-amount, amount).
+		Updates(map[string]any{
+			"remain_quota":  gorm.Expr("remain_quota + ?", amount),
+			"used_quota":    gorm.Expr("used_quota - ?", amount),
+			"accessed_time": common.GetTimestamp(),
+		})
+	if leg.Error != nil {
+		return leg.Error
+	}
+	if leg.RowsAffected != 1 {
+		return fmt.Errorf("%w: token %d is gone", ErrStrictReservationConflict, row.TokenId)
+	}
+	return nil
+}
+
+// debitStrictStatsTx records one settled request's usage statistics inside
+// the caller's settlement transaction: the user leg, the token leg via the
+// reserve/credit pair, and the channel leg. Statistics and money share one
+// commit; a failed settlement leaves no statistics behind. Replays return
+// before this runs, so each settlement counts exactly once.
+func debitStrictStatsTx(tx *gorm.DB, row *StrictTextReservation, actualQuota int) error {
+	user := tx.Model(&User{}).Where("id = ?", row.UserId).Updates(map[string]any{
+		"used_quota":    gorm.Expr("used_quota + ?", actualQuota),
+		"request_count": gorm.Expr("request_count + ?", 1),
+	})
+	if user.Error != nil {
+		return user.Error
+	}
+	if user.RowsAffected != 1 {
+		return fmt.Errorf("%w: user %d is gone", ErrStrictReservationConflict, row.UserId)
+	}
+	if row.ChannelId > 0 && actualQuota > 0 {
+		channel := tx.Model(&Channel{}).Where("id = ?", row.ChannelId).
+			Update("used_quota", gorm.Expr("used_quota + ?", actualQuota))
+		if channel.Error != nil {
+			return channel.Error
+		}
+		if channel.RowsAffected != 1 {
+			return fmt.Errorf("%w: channel %d is gone", ErrStrictReservationConflict, row.ChannelId)
+		}
+	}
+	return nil
+}
+
+func readStrictReservationTx(tx *gorm.DB, requestId string, row *StrictTextReservation, check func(*StrictTextReservation) error) error {
+	var existing StrictTextReservation
+	if err := tx.Where("request_id = ?", requestId).First(&existing).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return fmt.Errorf("%w: %q", ErrStrictReservationNotFound, requestId)
+		}
+		return err
+	}
+	if check != nil {
+		if err := check(&existing); err != nil {
+			return err
+		}
+	}
+	*row = existing
+	return nil
+}
+
+// GetStrictTextReservation reads one reservation by request id for status and
+// recovery inspection. It never mutates.
+func GetStrictTextReservation(requestId string) (*StrictTextReservation, error) {
+	if requestId == "" {
+		return nil, fmt.Errorf("%w: request_id is empty", ErrStrictReservationInvalidInput)
+	}
+	row := &StrictTextReservation{}
+	if err := DB.Where("request_id = ?", requestId).First(row).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, fmt.Errorf("%w: %q", ErrStrictReservationNotFound, requestId)
+		}
+		return nil, err
+	}
+	return row, nil
+}
+
+// ListUnresolvedStrictTextReservations returns RESERVED and DISPATCHED rows
+// for the startup scan. Recovery refunds RESERVED rows only under
+// caller-owned quiescence; DISPATCHED rows stay held.
+func ListUnresolvedStrictTextReservations(limit int) ([]StrictTextReservation, error) {
+	if limit <= 0 {
+		limit = 200
+	}
+	var rows []StrictTextReservation
+	if err := DB.Where("state IN ?", []string{StrictReservationReserved, StrictReservationDispatched}).
+		Order("id asc").Limit(limit).Find(&rows).Error; err != nil {
+		return nil, err
+	}
+	return rows, nil
+}
+
+// StrictReservationSummary reports pending operations, never a second balance.
+type StrictReservationSummary struct {
+	ReservedCount          int64 `json:"reserved_count"`
+	DispatchedCount        int64 `json:"dispatched_count"`
+	HeldQuota              int64 `json:"held_quota"`
+	SettledCount           int64 `json:"settled_count"`
+	SettledQuota           int64 `json:"settled_quota"`
+	InputTokens            int64 `json:"input_tokens"`
+	OutputTokens           int64 `json:"output_tokens"`
+	UnrecordedSettledCount int64 `json:"unrecorded_settled_count"`
+}
+
+func StrictTextReservationSummary(tokenID int) (*StrictReservationSummary, error) {
+	result := &StrictReservationSummary{}
+	err := DB.Model(&StrictTextReservation{}).Where("token_id = ?", tokenID).
+		Select("COALESCE(SUM(CASE WHEN state = ? THEN 1 ELSE 0 END),0) AS reserved_count, "+
+			"COALESCE(SUM(CASE WHEN state = ? THEN 1 ELSE 0 END),0) AS dispatched_count, "+
+			"COALESCE(SUM(CASE WHEN state IN (?,?) THEN reserved_quota ELSE 0 END),0) AS held_quota, "+
+			"COALESCE(SUM(CASE WHEN state = ? THEN 1 ELSE 0 END),0) AS settled_count, "+
+			"COALESCE(SUM(CASE WHEN state = ? THEN actual_quota ELSE 0 END),0) AS settled_quota, "+
+			"COALESCE(SUM(CASE WHEN state = ? AND result_recorded = ? THEN actual_prompt_tokens ELSE 0 END),0) AS input_tokens, "+
+			"COALESCE(SUM(CASE WHEN state = ? AND result_recorded = ? THEN actual_completion_tokens ELSE 0 END),0) AS output_tokens, "+
+			"COALESCE(SUM(CASE WHEN state = ? AND (result_recorded = ? OR result_recorded IS NULL) THEN 1 ELSE 0 END),0) AS unrecorded_settled_count",
+			StrictReservationReserved, StrictReservationDispatched, StrictReservationReserved, StrictReservationDispatched,
+			StrictReservationSettled, StrictReservationSettled, StrictReservationSettled, true,
+			StrictReservationSettled, true, StrictReservationSettled, false).
+		Scan(result).Error
+	return result, err
+}
+
+// RecoverUndispatchedStrictTextReservations runs only before serving requests
+// in the explicitly selected single-process seller startup. No age heuristic,
+// missing-log inference or DISPATCHED refund is allowed.
+func RecoverUndispatchedStrictTextReservations() error {
+	for {
+		var rows []StrictTextReservation
+		if err := DB.Where("state = ?", StrictReservationReserved).Order("id").Limit(100).Find(&rows).Error; err != nil {
+			return err
+		}
+		if len(rows) == 0 {
+			return nil
+		}
+		for _, row := range rows {
+			if _, err := RefundStrictTextReservation(row.RequestId); err != nil {
+				return err
+			}
+		}
+	}
+}
