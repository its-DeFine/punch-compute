index 000000000..6529f3db3
--- /dev/null
+++ b/model/strict_token_gate.go
@@ -0,0 +1,141 @@
+package model
+
+import (
+	"context"
+	"sync"
+)
+
+// StrictOrderRef identifies one strict policy token for request draining.
+// The key joins the id because test databases restart autoincrement ids
+// while production ids never repeat; admissions for distinct orders must
+// never share a gate.
+type StrictOrderRef struct {
+	ID  int
+	Key string
+}
+
+type strictTokenGate struct {
+	control  sync.Mutex
+	mu       sync.Mutex
+	cond     *sync.Cond
+	admitted int
+	draining bool
+}
+
+var strictTokenGates = struct {
+	sync.Mutex
+	entries map[StrictOrderRef]*strictTokenGate
+}{entries: make(map[StrictOrderRef]*strictTokenGate)}
+
+func strictTokenGateFor(ref StrictOrderRef) *strictTokenGate {
+	strictTokenGates.Lock()
+	defer strictTokenGates.Unlock()
+	gate, ok := strictTokenGates.entries[ref]
+	if !ok {
+		gate = &strictTokenGate{}
+		gate.cond = sync.NewCond(&gate.mu)
+		strictTokenGates.entries[ref] = gate
+	}
+	return gate
+}
+
+// StrictTokenAdmit records one admitted strict request. It reports false
+// while the order is draining, so no new request starts after disable.
+func StrictTokenAdmit(ref StrictOrderRef) bool {
+	gate := strictTokenGateFor(ref)
+	gate.mu.Lock()
+	defer gate.mu.Unlock()
+	if gate.draining {
+		return false
+	}
+	gate.admitted++
+	return true
+}
+
+// StrictTokenRelease drops one admission. Every Admit caller must release
+// exactly once on every exit path, including settlement and failure.
+func StrictTokenRelease(ref StrictOrderRef) {
+	gate := strictTokenGateFor(ref)
+	gate.mu.Lock()
+	defer gate.mu.Unlock()
+	if gate.admitted > 0 {
+		gate.admitted--
+	}
+	if gate.admitted == 0 {
+		gate.cond.Broadcast()
+	}
+}
+
+// StrictTokenAdmittedCount reports currently admitted strict requests.
+func StrictTokenAdmittedCount(ref StrictOrderRef) int {
+	gate := strictTokenGateFor(ref)
+	gate.mu.Lock()
+	defer gate.mu.Unlock()
+	return gate.admitted
+}
+
+// StrictTokenBeginDisable starts rejecting new admissions. Callers must set
+// this before persisting the disabled status: admissions check the gate
+// after reading the row, so any admission that saw the old enabled status
+// either admitted before this call (and stays counted) or is rejected.
+func StrictTokenBeginDisable(ref StrictOrderRef) {
+	gate := strictTokenGateFor(ref)
+	gate.mu.Lock()
+	defer gate.mu.Unlock()
+	gate.draining = true
+}
+
+// StrictTokenClearDisable reopens admissions after the token returns to
+// enabled. The persisted status remains the authority across restarts.
+func StrictTokenClearDisable(ref StrictOrderRef) {
+	gate := strictTokenGateFor(ref)
+	gate.mu.Lock()
+	defer gate.mu.Unlock()
+	gate.draining = false
+	gate.cond.Broadcast()
+}
+
+// StrictTokenWaitDrained blocks until no admitted requests remain or ctx
+// ends. A cancelled wait leaves draining set: the order stays closed to
+// new admissions and the persisted disabled status is unchanged.
+func StrictTokenWaitDrained(ctx context.Context, ref StrictOrderRef) error {
+	gate := strictTokenGateFor(ref)
+	gate.mu.Lock()
+	defer gate.mu.Unlock()
+	if gate.admitted == 0 {
+		return nil
+	}
+	stop := context.AfterFunc(ctx, func() {
+		gate.mu.Lock()
+		defer gate.mu.Unlock()
+		gate.cond.Broadcast()
+	})
+	defer stop()
+	for gate.admitted > 0 {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		gate.cond.Wait()
+	}
+	return nil
+}
+
+// GetTokenForStrictOperation serializes the authoritative snapshot and admission
+// with status/model changes in this single New API process. Re-read AFTER the
+// lock: an initial lookup may have raced an entire disable/swap/enable cycle.
+// Callers release before serving inference; admitted counts cover that lifetime.
+func GetTokenForStrictOperation(id, userId int) (*Token, func(), error) {
+	token, err := GetTokenByIds(id, userId)
+	noop := func() {}
+	if err != nil || token.StrictTextPolicy == nil {
+		return token, noop, err
+	}
+	gate := strictTokenGateFor(StrictOrderRef{ID: token.Id, Key: token.Key})
+	gate.control.Lock()
+	token, err = GetTokenByIds(id, userId)
+	if err != nil {
+		gate.control.Unlock()
+		return nil, noop, err
+	}
+	return token, gate.control.Unlock, nil
+}
