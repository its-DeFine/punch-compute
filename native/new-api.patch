+			info.StartTime = time.Now()
+			info.PriceData.ModelRatio = 1
+			info.PriceData.CompletionRatio = 1
+			info.PriceData.GroupRatioInfo.GroupRatio = 1
+			ctx := strictTestContext()
+			session, apiErr := NewBillingSession(ctx, info, 1000)
+			require.Nil(t, apiErr)
+			info.Billing = session
+			_, err := model.MarkStrictTextReservationDispatched(info.RequestId)
+			require.NoError(t, err)
+			require.NoError(t, model.DB.Exec("CREATE TRIGGER fail_result "+tc.trigger+" BEGIN SELECT RAISE(ABORT, 'injected result write failure'); END").Error)
+			t.Cleanup(func() { model.DB.Exec("DROP TRIGGER IF EXISTS fail_result") })
+			PostTextConsumeQuota(ctx, info, &dto.Usage{PromptTokens: 9, CompletionTokens: 1, TotalTokens: 10}, nil)
+			row, err := model.GetStrictTextReservation(info.RequestId)
+			require.NoError(t, err)
+			assert.Equal(t, model.StrictReservationDispatched, row.State)
+			assert.Equal(t, tc.recorded, row.ResultRecorded)
+			assert.Equal(t, 1000, userQuotaNow(t, 1))
+			assert.Equal(t, 1000, tokenRemainNow(t, 1))
+			used, count := userStatsNow(t, 1)
+			assert.Zero(t, used)
+			assert.Zero(t, count)
+			var logs int64
+			require.NoError(t, model.LOG_DB.Model(&model.Log{}).Where("token_id = ?", 1).Count(&logs).Error)
+			assert.Zero(t, logs)
+
+		})
+	}
+}
