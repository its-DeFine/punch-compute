+	ctx, recorder := newAuthenticatedContext(t, http.MethodPost, "/api/token/", body, user.Id)
+	AddToken(ctx)
+	response := decodeAPIResponse(t, recorder)
+	require.True(t, response.Success, response.Message)
+	var stored model.Token
+	require.NoError(t, model.DB.Where("user_id = ?", user.Id).First(&stored).Error)
+	require.Equal(t, policy, stored.StrictTextPolicy)
+	ctx, recorder = newAuthenticatedContext(t, http.MethodPut, "/api/token/?model_only=true",
+		map[string]any{"id": stored.Id, "expected_model": "model-a", "model": "model-b", "remain_quota": 9999}, user.Id+1)
+	UpdateToken(ctx)
+	require.False(t, decodeAPIResponse(t, recorder).Success)
+	require.Equal(t, "model-a", readStrictPolicyToken(t, stored.Id).ModelLimits)
+	ctx, recorder = newAuthenticatedContext(t, http.MethodPut, "/api/token/?status_only=true",
+		map[string]any{"id": stored.Id, "status": common.TokenStatusDisabled}, user.Id)
+	UpdateToken(ctx)
+	require.True(t, decodeAPIResponse(t, recorder).Success)
+	ctx, recorder = newAuthenticatedContext(t, http.MethodPut, "/api/token/?model_only=true",
+		map[string]any{"id": stored.Id, "expected_model": "model-a", "model": "model-b", "remain_quota": 9999}, user.Id)
+	UpdateToken(ctx)
+	require.True(t, decodeAPIResponse(t, recorder).Success)
+	after := readStrictPolicyToken(t, stored.Id)
+	require.Equal(t, 100, after.RemainQuota)
+	require.Equal(t, policy, after.StrictTextPolicy)
+	require.Equal(t, stored.Key, after.Key)
+}
+
+func TestStrictReservationRestartHoldBlocksModelChange(t *testing.T) {
+	user := setupStrictPolicyControllerTest(t)
+	token := insertStrictPolicyToken(t, user.Id, "model-a", 1000)
+	require.NoError(t, model.DB.Model(&model.User{}).Where("id = ?", user.Id).Update("quota", 1000).Error)
+	oldRedis, oldBatch := common.RedisEnabled, common.BatchUpdateEnabled
+	common.RedisEnabled, common.BatchUpdateEnabled = false, false
+	t.Cleanup(func() { common.RedisEnabled, common.BatchUpdateEnabled = oldRedis, oldBatch })
+	_, err := model.ReserveStrictTextWalletReservation(model.StrictReservationInput{
+		RequestId: "controller-held", UserId: user.Id, TokenId: token.Id, TokenKey: token.Key,
+		Model: "model-a", Policy: *token.StrictTextPolicy, ReservedQuota: 100,
+	})
+	require.NoError(t, err)
+	_, err = model.MarkStrictTextReservationDispatched("controller-held")
+	require.NoError(t, err)
+	// Durable restart checkpoint: token disabled; no in-memory admissions exist.
+	require.NoError(t, model.DB.Model(&model.Token{}).Where("id = ?", token.Id).Update("status", common.TokenStatusDisabled).Error)
+	require.Zero(t, model.StrictTokenAdmittedCount(model.StrictOrderRef{ID: token.Id, Key: token.Key}))
+	ctx, recorder := newAuthenticatedContext(t, http.MethodPut, "/api/token/?model_only=true", map[string]any{
+		"id": token.Id, "expected_model": "model-a", "model": "model-b",
+	}, user.Id)
+	UpdateToken(ctx)
+	require.False(t, decodeAPIResponse(t, recorder).Success)
+	require.Equal(t, "model-a", readStrictPolicyToken(t, token.Id).ModelLimits)
+	require.Equal(t, 900, readStrictPolicyToken(t, token.Id).RemainQuota)
+}
+
+func TestGetTokenDurableUsageSurvivesMissingConsumeLog(t *testing.T) {
+	user := setupStrictPolicyControllerTest(t)
+	require.NoError(t, model.DB.Model(user).Update("quota", 1000).Error)
+	token := insertStrictPolicyToken(t, user.Id, "model-a", 1000)
+	_, err := model.ReserveStrictTextWalletReservation(model.StrictReservationInput{
+		RequestId: "recovered-usage", UserId: user.Id, TokenId: token.Id, TokenKey: token.Key,
+		Model: "model-a", Policy: *token.StrictTextPolicy, ReservedQuota: 100,
+	})
+	require.NoError(t, err)
+	_, err = model.MarkStrictTextReservationDispatched("recovered-usage")
+	require.NoError(t, err)
+	_, err = model.RecordStrictTextResult("recovered-usage", 9, 1, 14)
+	require.NoError(t, err)
+	_, err = model.RecoverRecordedStrictTextResult("recovered-usage")
+	require.NoError(t, err)
+	// No consume log is written: the actual token readback must use its
+	// canonical native records, not a best-effort or truncated log query.
+	require.NoError(t, model.DB.Create(&model.StrictTextReservation{RequestId: "foreign", TokenId: token.Id + 1, State: model.StrictReservationSettled, ResultRecorded: true, ActualPromptTokens: 900, ActualCompletionTokens: 100, ActualQuota: 1400}).Error)
+	ctx, recorder := newAuthenticatedContext(t, http.MethodGet, "/api/token/"+strconv.Itoa(token.Id), nil, user.Id)
+	ctx.Params = gin.Params{{Key: "id", Value: strconv.Itoa(token.Id)}}
+	GetToken(ctx)
+	response := decodeAPIResponse(t, recorder)
+	require.True(t, response.Success, response.Message)
+	var data map[string]any
+	require.NoError(t, common.Unmarshal(response.Data, &data))
+	summary, ok := data["strict_reservations"].(map[string]any)
+	require.True(t, ok)
+	assert.Equal(t, float64(1), summary["settled_count"])
+	assert.Equal(t, float64(14), summary["settled_quota"])
+	assert.Equal(t, float64(9), summary["input_tokens"])
+	assert.Equal(t, float64(1), summary["output_tokens"])
+	assert.Equal(t, float64(0), summary["unrecorded_settled_count"])
+	assert.NotContains(t, recorder.Body.String(), token.Key)
+	denied, deniedRecorder := newAuthenticatedContext(t, http.MethodGet, "/api/token/"+strconv.Itoa(token.Id), nil, user.Id+1)
+	denied.Params = ctx.Params
+	GetToken(denied)
+	assert.False(t, decodeAPIResponse(t, deniedRecorder).Success)
+}
