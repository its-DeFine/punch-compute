diff --git a/service/strict_text_billing_test.go b/service/strict_text_billing_test.go
new file mode 100644
index 000000000..da7d571ff
--- /dev/null
+++ b/service/strict_text_billing_test.go
@@ -0,0 +1,342 @@
+package service
+
+// Strict text billing regression tests (opt-in per-order cap).
+//
+// Contract under test (see relay/request_billing.go opt-in,
+// service/billing_session.go Settle gate):
+//  1. ForcePreConsume disables the trust bypass even when balances sit
+//     above the trust threshold.
+//  2. On a strict session, Settle(actual > reserved) fails and preserves
+//     the reservation (no debit, session left unsettled for Refund).
+//  3. A successful strict Settle refunds the unused part exactly once;
+//     a later Refund is a no-op and cannot double refund.
+//  4. The normal (non-strict) Settle path still debits over-reservation
+//     actuals (documents the unchanged seam, not the desired cap).
+//  5. A dispatched strict request with no valid settlement keeps its
+//     reservation on Refund (uncertain inference is not a free retry).
+//
+// Reuses the service-package test DB fixtures (seedUser/seedToken/truncate
+// in task_billing_test.go) and real model quota functions; no mocks.
+
+import (
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/model"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func strictTestContext() *gin.Context {
+	ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	return ctx
+}
+
+func strictRelayInfo(userID, tokenID int, tokenKey string) *relaycommon.RelayInfo {
+	return &relaycommon.RelayInfo{
+		OriginModelName: "punch-test-model",
+		ChannelMeta:     &relaycommon.ChannelMeta{},
+		UserId:          userID,
+		TokenId:         tokenID,
+		TokenKey:        tokenKey,
+		UserSetting:     dto.UserSetting{BillingPreference: "wallet_only"},
+	}
+}
+
+func userQuotaNow(t *testing.T, userID int) int {
+	t.Helper()
+	q, err := model.GetUserQuota(userID, false)
+	require.NoError(t, err)
+	return q
+}
+
+func tokenRemainNow(t *testing.T, tokenID int) int {
+	t.Helper()
+	var tok model.Token
+	require.NoError(t, model.DB.First(&tok, tokenID).Error)
+	return tok.RemainQuota
+}
+
+func TestStrictForcePreConsumePreventsTrustAboveThreshold(t *testing.T) {
+	truncate(t)
+	const seed = 10000000 // above GetTrustQuota (10 * QuotaPerUnit)
+	seedUser(t, 1, seed)
+	seedToken(t, 1, 1, "sk-strict-trust", seed)
+
+	newSession := func(force bool) *BillingSession {
+		info := strictRelayInfo(1, 1, "sk-strict-trust")
+		info.TokenUnlimited = true
+		info.UserQuota = seed
+		info.ForcePreConsume = force
+		s, apiErr := NewBillingSession(strictTestContext(), info, 1000)
+		require.Nil(t, apiErr)
+		require.NotNil(t, s)
+		return s
+	}
+
+	plain := newSession(false)
+	assert.True(t, plain.trusted, "high-balance session without force must take the trust bypass")
+	assert.Equal(t, 0, plain.tokenConsumed)
+	assert.Equal(t, seed, userQuotaNow(t, 1))
+	assert.Equal(t, seed, tokenRemainNow(t, 1))
+
+	// The trusted call changed no quota; reuse that same fixture for forced admission.
+	forced := newSession(true)
+	assert.False(t, forced.trusted, "ForcePreConsume must prevent the trust bypass")
+	assert.Equal(t, 1000, forced.tokenConsumed)
+	assert.Equal(t, seed-1000, userQuotaNow(t, 1))
+	assert.Equal(t, seed-1000, tokenRemainNow(t, 1))
+}
+
+func TestStrictOversizedSettlementDeniedReservationPreserved(t *testing.T) {
+	truncate(t)
+	seedUser(t, 1, 2000)
+	seedToken(t, 1, 1, "sk-strict-cap", 2000)
+
+	info := strictRelayInfo(1, 1, "sk-strict-cap")
+	info.ForcePreConsume = true
+	info.StrictTextBilling = true
+	s, apiErr := NewBillingSession(strictTestContext(), info, 1000)
+	require.Nil(t, apiErr)
+	require.Equal(t, 1000, userQuotaNow(t, 1))
+	require.Equal(t, 1000, tokenRemainNow(t, 1))
+
+	err := s.Settle(1368)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "exceeds reserved")
+	assert.False(t, s.settled, "failed strict settle must leave the session unsettled")
+	assert.Equal(t, 1000, userQuotaNow(t, 1), "reservation preserved on user quota")
+	assert.Equal(t, 1000, tokenRemainNow(t, 1), "reservation preserved on token quota")
+
+	s.Refund(strictTestContext())
+	// Undispatched strict refund is synchronous: restoration is visible the
+	// moment Refund returns (old async code needed Eventually here and fails
+	// an immediate check).
+	assert.Equal(t, 2000, userQuotaNow(t, 1), "undispatched refund must restore the preserved reservation")
+	assert.Equal(t, 2000, tokenRemainNow(t, 1), "undispatched refund must restore the preserved reservation")
+}
+
+func TestStrictDispatchedUncertainResultRetainsReservation(t *testing.T) {
+	truncate(t)
+	seedUser(t, 1, 2000)
+	seedToken(t, 1, 1, "sk-strict-dispatched", 2000)
+
+	info := strictRelayInfo(1, 1, "sk-strict-dispatched")
+	info.ForcePreConsume = true
+	info.StrictTextBilling = true
+	s, apiErr := NewBillingSession(strictTestContext(), info, 1000)
+	require.Nil(t, apiErr)
+
+	require.Error(t, s.Settle(1368), "oversized actual must fail even after dispatch")
+	info.StrictTextDispatched = true // as compatible_handler does post-dispatch
+	s.Refund(strictTestContext())
+	require.Never(t, func() bool {
+		return userQuotaNow(t, 1) != 1000 || tokenRemainNow(t, 1) != 1000
+	}, 2*time.Second, 50*time.Millisecond,
+		"uncertain inference must not become a free retry: reservation retained, no funding/refund calls")
+	assert.False(t, s.settled)
+}
+
+func TestStrictSettlementRefundsUnusedOnce(t *testing.T) {
+	truncate(t)
+	seedUser(t, 1, 2000)
+	seedToken(t, 1, 1, "sk-strict-once", 2000)
+
+	info := strictRelayInfo(1, 1, "sk-strict-once")
+	info.ForcePreConsume = true
+	info.StrictTextBilling = true
+	s, apiErr := NewBillingSession(strictTestContext(), info, 1000)
+	require.Nil(t, apiErr)
+
+	require.NoError(t, s.Settle(800))
+	assert.True(t, s.settled)
+	assert.Equal(t, 1200, userQuotaNow(t, 1), "unused 200 of 1000 must be refunded once")
+	assert.Equal(t, 1200, tokenRemainNow(t, 1))
+
+	s.Refund(strictTestContext())
+	assert.Equal(t, 1200, userQuotaNow(t, 1), "post-settle refund must be a no-op")
+	assert.Equal(t, 1200, tokenRemainNow(t, 1), "post-settle refund must be a no-op")
+
+	require.NoError(t, s.Settle(800), "repeat settle must be idempotent")
+	assert.Equal(t, 1200, userQuotaNow(t, 1))
+}
+
+func TestNormalOversizedSettlementStillDebits(t *testing.T) {
+	truncate(t)
+	seedUser(t, 1, 1000)
+	seedToken(t, 1, 1, "sk-normal-cap", 1000)
+
+	info := strictRelayInfo(1, 1, "sk-normal-cap")
+	info.ForcePreConsume = true
+	s, apiErr := NewBillingSession(strictTestContext(), info, 756)
+	require.Nil(t, apiErr)
+
+	require.NoError(t, s.Settle(1368), "non-strict path keeps legacy over-reservation debit")
+	assert.Equal(t, 1000-1368, userQuotaNow(t, 1))
+	assert.Equal(t, 1000-1368, tokenRemainNow(t, 1))
+}
+
+func TestStrictNativeReservationRejectsUnaffordableRequest(t *testing.T) {
+	truncate(t)
+	seedUser(t, 1, 1000)
+	seedToken(t, 1, 1, "sk-strict-unaffordable", 1000)
+	info := strictRelayInfo(1, 1, "sk-strict-unaffordable")
+	info.ForcePreConsume = true
+	info.StrictTextBilling = true
+	session, err := NewBillingSession(strictTestContext(), info, 1368)
+	require.NotNil(t, err)
+	require.Nil(t, session)
+	assert.Equal(t, 1000, userQuotaNow(t, 1))
+	assert.Equal(t, 1000, tokenRemainNow(t, 1))
+}
+
+// A real SQL failure after the first balance write must not split the ledger.
+func TestStrictSettlementSQLFailureKeepsBothBalances(t *testing.T) {
+	truncate(t)
+	seedUser(t, 1, 2000)
+	seedToken(t, 1, 1, "sk-strict-sql-failure", 2000)
+	info := strictRelayInfo(1, 1, "sk-strict-sql-failure")
+	info.ForcePreConsume = true
+	info.StrictTextBilling = true
+	session, apiErr := NewBillingSession(strictTestContext(), info, 1000)
+	require.Nil(t, apiErr)
+	require.NoError(t, model.DB.Exec(`CREATE TRIGGER fail_strict_refund BEFORE UPDATE ON tokens
+        WHEN NEW.remain_quota > OLD.remain_quota BEGIN SELECT RAISE(ABORT, 'injected token write failure'); END`).Error)
+	t.Cleanup(func() { model.DB.Exec("DROP TRIGGER IF EXISTS fail_strict_refund") })
+	require.Error(t, session.Settle(800))
+	assert.Equal(t, 1000, userQuotaNow(t, 1), "failed settlement must preserve the full user reservation")
+	assert.Equal(t, 1000, tokenRemainNow(t, 1), "failed settlement must preserve the full token reservation")
+}
+
+func userStatsNow(t *testing.T, userID int) (usedQuota, requestCount int) {
+	t.Helper()
+	var user model.User
+	require.NoError(t, model.DB.Select("used_quota", "request_count").First(&user, userID).Error)
+	return user.UsedQuota, user.RequestCount
+}
+
+func channelUsedNow(t *testing.T, channelID int) int64 {
+	t.Helper()
+	var channel model.Channel
+	require.NoError(t, model.DB.Select("used_quota").First(&channel, channelID).Error)
+	return channel.UsedQuota
+}
+
+// Known-result recovery through a live session: record the verdict, settle
+// with exactly that actual, and prove balances plus statistics commit once.
+func TestStrictKnownResultRecordedThenSettledThroughSession(t *testing.T) {
+	truncate(t)
+	seedUser(t, 1, 2000)
+	seedToken(t, 1, 1, "sk-strict-known", 2000)
+	seedChannel(t, 7)
+
+	info := strictRelayInfo(1, 1, "sk-strict-known")
+	info.ForcePreConsume = true
+	info.StrictTextBilling = true
+	info.ChannelId = 7
+	s, apiErr := NewBillingSession(strictTestContext(), info, 1000)
+	require.Nil(t, apiErr)
+	require.NotEmpty(t, info.RequestId)
+
+	_, err := model.MarkStrictTextReservationDispatched(info.RequestId)
+	require.NoError(t, err)
+	_, err = model.RecordStrictTextResult(info.RequestId, 9, 1, 800)
+	require.NoError(t, err)
+
+	require.NoError(t, s.Settle(800))
+	assert.True(t, s.StrictStatsCommitted(), "durable settle must own the statistics commit")
+	assert.Equal(t, 1200, userQuotaNow(t, 1))
+	assert.Equal(t, 1200, tokenRemainNow(t, 1))
+	used, count := userStatsNow(t, 1)
+	assert.Equal(t, 800, used, "statistics must commit exactly once, not via legacy writes too")
+	assert.Equal(t, 1, count)
+	assert.EqualValues(t, 800, channelUsedNow(t, 7))
+
+	require.NoError(t, s.Settle(800), "repeat settle must be idempotent")
+	used, count = userStatsNow(t, 1)
+	assert.Equal(t, 800, used)
+	assert.Equal(t, 1, count)
+	assert.EqualValues(t, 800, channelUsedNow(t, 7))
+}
+
+// Old failure: settling a recorded verdict with a different actual silently
+// replaced it. New success: the recorded known result wins and the
+// reservation is preserved for the correct actual.
+func TestStrictRecordedMismatchRefusesSettle(t *testing.T) {
+	truncate(t)
+	seedUser(t, 1, 2000)
+	seedToken(t, 1, 1, "sk-strict-mismatch", 2000)
+
+	info := strictRelayInfo(1, 1, "sk-strict-mismatch")
+	info.ForcePreConsume = true
+	info.StrictTextBilling = true
+	s, apiErr := NewBillingSession(strictTestContext(), info, 1000)
+	require.Nil(t, apiErr)
+
+	_, err := model.MarkStrictTextReservationDispatched(info.RequestId)
+	require.NoError(t, err)
+	_, err = model.RecordStrictTextResult(info.RequestId, 9, 1, 800)
+	require.NoError(t, err)
+
+	require.Error(t, s.Settle(801), "recorded actual 800 must reject settle 801")
+	assert.False(t, s.StrictStatsCommitted())
+	assert.Equal(t, 1000, userQuotaNow(t, 1), "mismatched settle must preserve the reservation")
+	assert.Equal(t, 1000, tokenRemainNow(t, 1))
+	used, count := userStatsNow(t, 1)
+	assert.Equal(t, 0, used, "refused settlement must leave no statistics behind")
+	assert.Equal(t, 0, count)
+
+	require.NoError(t, s.Settle(800), "the recorded actual still settles afterwards")
+	assert.Equal(t, 1200, userQuotaNow(t, 1))
+	used, count = userStatsNow(t, 1)
+	assert.Equal(t, 800, used)
+	assert.Equal(t, 1, count)
+}
+
+func TestStrictResultWriteFailureCannotSettleOrLog(t *testing.T) {
+	for _, tc := range []struct {
+		name, trigger string
+		recorded      bool
+	}{
+		{"record", "BEFORE UPDATE OF result_recorded ON strict_text_reservations", false},
+		{"settle", "BEFORE UPDATE OF state ON strict_text_reservations WHEN NEW.state = 'SETTLED'", true},
