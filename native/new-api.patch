+// strictDurableBillingSession returns the durable strict session behind a
+// relay billing handle, or nil for every other path. Only that path owns
+// the known-result record and the atomic balance+statistics settlement;
+// legacy, task, audio and non-strict flows are untouched.
+func strictDurableBillingSession(relayInfo *relaycommon.RelayInfo) *BillingSession {
+	if relayInfo == nil || !relayInfo.StrictTextBilling {
+		return nil
+	}
+	session, ok := relayInfo.Billing.(*BillingSession)
+	if !ok || session == nil || session.durableRequestId == "" {
+		return nil
+	}
+	return session
+}
