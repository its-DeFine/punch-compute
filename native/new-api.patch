+// Admission, release and drain denial through the real PrepareRequestBilling
+// path: a valid order-bound request holds one admission the relay defer
+// releases, and the same request is denied while the order drains.
+func TestStrictOrderAdmissionLifecycle(t *testing.T) {
+	db := setupStrictOrderDB(t)
+	require.NoError(t, db.AutoMigrate(&model.User{}, &model.Token{}))
+	oldRedis, oldBatch := common.RedisEnabled, common.BatchUpdateEnabled
