+func newStrictAdmissionContext(t *testing.T, user *model.User, token *model.Token) (*gin.Context, *relaycommon.RelayInfo) {
+	t.Helper()
+	data := []byte(`{"model":"revision-b","messages":[{"role":"user","content":"hello"}],"max_tokens":6}`)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", bytes.NewReader(data))
+	t.Cleanup(func() { common.CleanupBodyStorage(c) })
+	info := &relaycommon.RelayInfo{UserId: user.Id, TokenId: token.Id, TokenKey: token.Key, OriginModelName: "revision-b", StartTime: time.Now()}
+	return c, info
+}
+
+// A request can read the old selection just before disable/swap/enable.
+// Exercise that exact stale DB snapshot through GORM's actual query callback.
+func TestStrictOrderStaleReadAcrossModelSwitch(t *testing.T) {
+	db := setupStrictOrderDB(t)
+	require.NoError(t, db.AutoMigrate(&model.User{}, &model.Token{}))
+	oldRedis := common.RedisEnabled
+	common.RedisEnabled = false
+	t.Cleanup(func() { common.RedisEnabled = oldRedis })
+	user := &model.User{Username: "stale-model-user", Quota: 100}
+	require.NoError(t, db.Create(user).Error)
+	token := &model.Token{UserId: user.Id, Key: "synthetic-stale-selection", Status: common.TokenStatusEnabled, RemainQuota: 100, ModelLimitsEnabled: true, ModelLimits: "revision-b", ExpiredTime: -1, StrictTextPolicy: &model.StrictTextPolicy{InputRate: 1, OutputRate: 5, CacheRate: 1, ContextTokens: 64, MaxOutputTokens: 6}}
+	require.NoError(t, token.Insert())
+	captured, proceed := make(chan struct{}), make(chan struct{})
+	var first atomic.Bool
+	require.NoError(t, db.Callback().Query().After("gorm:query").Register("punch-stale-snapshot", func(tx *gorm.DB) {
+		if tx.Statement.Table == "tokens" && first.CompareAndSwap(false, true) {
+			close(captured)
+			<-proceed
+		}
+	}))
+	t.Cleanup(func() { db.Callback().Query().Remove("punch-stale-snapshot") })
+	c, info := newStrictAdmissionContext(t, user, token)
+	result := make(chan bool, 1)
+	go func() { err := PrepareRequestBilling(c, info); ReleaseStrictOrderAdmission(c); result <- err != nil }()
+	<-captured
+	ref := model.StrictOrderRef{ID: token.Id, Key: token.Key}
+	model.StrictTokenBeginDisable(ref)
+	require.NoError(t, db.Model(&model.Token{}).Where("id = ?", token.Id).Updates(map[string]any{"status": common.TokenStatusDisabled, "model_limits": "revision-c"}).Error)
+	require.NoError(t, db.Model(&model.Token{}).Where("id = ?", token.Id).Update("status", common.TokenStatusEnabled).Error)
+	model.StrictTokenClearDisable(ref)
+	close(proceed)
+	require.True(t, <-result, "stale selection admitted after model switch")
+}
+
+// Native settlement schedules cache/notification callbacks. Join them before
+// restoring fixture DB/config; otherwise a passing assertion can race teardown.
+func waitStrictFixtureTasks(t *testing.T) {
+	t.Helper()
+	baseline := gopool.WorkerCount()
+	t.Cleanup(func() {
+		require.Eventually(t, func() bool { return gopool.WorkerCount() <= baseline }, 5*time.Second, time.Millisecond, "native fixture callbacks did not finish")
+	})
+}
