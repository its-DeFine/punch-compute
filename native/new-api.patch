+package model
+
+import (
+	"context"
+	"fmt"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+var strictGateTestSeq atomic.Int64
+
+func strictGateTestRef(t *testing.T) StrictOrderRef {
+	t.Helper()
+	return StrictOrderRef{ID: 1, Key: fmt.Sprintf("gate-test-%d", strictGateTestSeq.Add(1))}
+}
+
+func TestStrictTokenGateAdmitReleaseCount(t *testing.T) {
+	ref := strictGateTestRef(t)
+	require.True(t, StrictTokenAdmit(ref))
+	require.True(t, StrictTokenAdmit(ref))
+	assert.Equal(t, 2, StrictTokenAdmittedCount(ref))
+	StrictTokenRelease(ref)
+	assert.Equal(t, 1, StrictTokenAdmittedCount(ref))
+	StrictTokenRelease(ref)
+	assert.Equal(t, 0, StrictTokenAdmittedCount(ref))
+}
+
+func TestStrictTokenGateDrainRejectsNew(t *testing.T) {
+	ref := strictGateTestRef(t)
+	require.True(t, StrictTokenAdmit(ref))
+	StrictTokenBeginDisable(ref)
+	assert.False(t, StrictTokenAdmit(ref))
+	assert.Equal(t, 1, StrictTokenAdmittedCount(ref))
+	StrictTokenRelease(ref)
+	assert.Equal(t, 0, StrictTokenAdmittedCount(ref))
+	// Draining persists after the last release: the order stays closed.
+	assert.False(t, StrictTokenAdmit(ref))
+}
+
+func TestStrictTokenGateWaitDrainedReleases(t *testing.T) {
+	ref := strictGateTestRef(t)
+	require.True(t, StrictTokenAdmit(ref))
+	done := make(chan error, 1)
+	go func() {
+		done <- StrictTokenWaitDrained(context.Background(), ref)
+	}()
+	StrictTokenRelease(ref)
+	require.NoError(t, <-done)
+	assert.Equal(t, 0, StrictTokenAdmittedCount(ref))
+}
+
+func TestStrictTokenGateCancelledDrainStaysDraining(t *testing.T) {
+	ref := strictGateTestRef(t)
+	require.True(t, StrictTokenAdmit(ref))
+	StrictTokenBeginDisable(ref)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.ErrorIs(t, StrictTokenWaitDrained(ctx, ref), context.Canceled)
+	assert.False(t, StrictTokenAdmit(ref))
+	assert.Equal(t, 1, StrictTokenAdmittedCount(ref))
+	StrictTokenRelease(ref)
+}
+
+func TestStrictTokenGateClearDisableReopens(t *testing.T) {
+	ref := strictGateTestRef(t)
+	StrictTokenBeginDisable(ref)
+	assert.False(t, StrictTokenAdmit(ref))
+	StrictTokenClearDisable(ref)
+	require.True(t, StrictTokenAdmit(ref))
+	StrictTokenRelease(ref)
+	assert.Equal(t, 0, StrictTokenAdmittedCount(ref))
+}
