+	assert.Equal(t, int64(-1), stored.ExpiredTime)
+	assert.Equal(t, token.Key, stored.Key)
+	require.NotNil(t, stored.StrictTextPolicy)
+	assert.Equal(t, float64(1), stored.StrictTextPolicy.InputRate)
+	assert.Equal(t, float64(5), stored.StrictTextPolicy.OutputRate)
